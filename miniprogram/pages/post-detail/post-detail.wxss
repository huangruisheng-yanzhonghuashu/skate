/* 打卡详情：地点卡 + 留言 + 素材网格 + 点赞/评论 + 编辑/删除 */
.page {
  min-height: 100vh;
  background: #111114;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 自定义导航栏（media-viewer 预览需全屏覆盖） */
.nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 30;
  background: #1A1A1E;
}

.nav-row {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.nav-back-btn {
  width: 64rpx;
  height: 64rpx;
  margin-left: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn-hover {
  opacity: 0.7;
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
}

.nav-title {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-right {
  width: 52rpx;
  flex-shrink: 0;
}

/* ===== 地点卡 ===== */
.place-card {
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.place-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.place-row-hover {
  opacity: 0.8;
}

/* 类型徽章：场地=青色调 / 店铺=橙色调（与列表页同语义） */
.place-kind {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #00D4AA;
  background: rgba(0, 212, 170, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.2;
}

.place-kind-shop {
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.16);
}

.place-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.place-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

.place-time {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6E6E76;
}

/* ===== 留言 ===== */
.note {
  display: block;
  margin-bottom: 24rpx;
  font-size: 30rpx;
  color: #D9D9DE;
  line-height: 1.7;
  word-break: break-all;
}

.bare {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6E6E76;
}

/* ===== 素材网格（与发现页同布局：1张大图 / 2张对半 / 3+三列） ===== */
.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.photos .photo-cell {
  position: relative;
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: #17171B;
}

.photos.photos-1 .photo-cell {
  width: 100%;
  aspect-ratio: 4 / 3;
}

.photos.photos-2 .photo-cell {
  width: calc((100% - 12rpx) / 2);
}

.photo-img,
.photo-video {
  width: 100%;
  height: 100%;
}

/* 视频封面播放按钮（微博式：点击进混合查看器播放） */
.video-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
  width: 0;
  height: 0;
  border-left: 26rpx solid rgba(255, 255, 255, 0.92);
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  filter: drop-shadow(0 0 6rpx rgba(0, 0, 0, 0.4));
}

.video-uploading {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  z-index: 2;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 18rpx;
}

/* ===== 点赞 / 评论动作行（与发现页动作行同款） ===== */
.actions {
  display: flex;
  gap: 48rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #26262C;
  border-bottom: 1rpx solid #26262C;
}

.action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #8C8C94;
}

.action-hover {
  opacity: 0.7;
}

.action-liked {
  color: #FF8A6E;
}

.action-icon {
  width: 32rpx;
  height: 32rpx;
}

/* ===== 评论区 ===== */
.comments {
  margin-top: 28rpx;
}

.comments-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

/* ===== 底部操作：编辑 / 删除 ===== */
.ops {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.op-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.op-btn-hover {
  opacity: 0.8;
}

.op-btn-edit {
  border: 1rpx solid rgba(255, 90, 54, 0.45);
  background: rgba(255, 90, 54, 0.12);
  color: #FF8A6E;
}

.op-btn-del {
  border: 1rpx solid rgba(229, 72, 77, 0.45);
  background: rgba(229, 72, 77, 0.1);
  color: #E5484D;
}

.op-btn-icon {
  width: 30rpx;
  height: 30rpx;
}

/* ===== 编辑打卡弹窗（与发布打卡弹窗同款） ===== */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
}

.anim-fade-in {
  animation: fade-in-anim 0.2s ease backwards;
}

@keyframes fade-in-anim {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sheet {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  background: #232329;
  border-top: 1rpx solid #2F2F36;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.anim-sheet-in {
  animation: sheet-in-anim 0.25s ease backwards;
}

@keyframes sheet-in-anim {
  from { transform: translateY(30%); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}

.sheet-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.sheet-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-close-icon {
  width: 32rpx;
  height: 32rpx;
}

.venue-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #26262C;
  margin-bottom: 24rpx;
  max-width: 100%;
}

.venue-chip-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.venue-chip-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #FFFFFF;
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.note-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #A6A6AD;
}

.note-count {
  font-size: 22rpx;
  color: #6E6E76;
}

.field-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #2A2A30;
  background: #17171B;
  font-size: 28rpx;
  color: #D9D9DE;
  box-sizing: border-box;
}

.ph {
  color: #6E6E76;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-tile {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-tile-video {
  background: #000000;
}

.photo-tile-img {
  width: 100%;
  height: 100%;
}

.photo-tile-del {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-tile-del-icon {
  width: 24rpx;
  height: 24rpx;
}

.photo-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #3A3A42;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8C8C94;
  gap: 6rpx;
}

.photo-add:active {
  border-color: #FF5A36;
  color: #FF8A6E;
}

.photo-add-icon {
  width: 48rpx;
  height: 48rpx;
}

.photo-add-text {
  font-size: 24rpx;
  padding: 0 8rpx;
  text-align: center;
  line-height: 1.2;
}

.photo-add-sub {
  font-size: 20rpx;
  line-height: 1.2;
}

.sheet-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.sheet-btn:active {
  background: #E63A16;
}

.sheet-btn-loading {
  opacity: 0.7;
}
