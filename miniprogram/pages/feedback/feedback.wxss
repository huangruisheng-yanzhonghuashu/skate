.page {
  min-height: 100vh;
  background: #111114;
  padding: 24rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 顶部说明 ===== */
.hero {
  background: #1E1E23;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.hero-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8C8C94;
  line-height: 1.6;
}

/* ===== 空态/加载 ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 120rpx 40rpx 0;
  color: #8C8C94;
  font-size: 28rpx;
}

.state-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #D9D9DE;
}

.state-desc {
  font-size: 26rpx;
}

/* ===== 建议卡片 ===== */
.fb-card {
  background: #1E1E23;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.fb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 建议类型：白色粗标题（设计稿同款） */
.fb-type {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 状态徽章：待处理橙 / 已处理青 / 已驳回红 */
.fb-status {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.2;
}

.fb-status-pending {
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.14);
}

.fb-status-done {
  color: #00D4AA;
  background: rgba(0, 212, 170, 0.12);
}

.fb-status-rejected {
  color: #FF3B30;
  background: rgba(255, 59, 48, 0.12);
}

.fb-desc {
  display: block;
  margin-top: 18rpx;
  font-size: 30rpx;
  color: #D9D9DE;
  line-height: 1.6;
  word-break: break-all;
}

.fb-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.fb-photo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
}

/* 官方回复块 */
.fb-reply {
  margin-top: 20rpx;
  background: #17171B;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.fb-reply-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fb-reply-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #FF8A6E;
}

.fb-reply-time {
  font-size: 22rpx;
  color: #6E6E76;
}

.fb-reply-text {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #A6A6AD;
  line-height: 1.6;
  word-break: break-all;
}

.fb-time {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #6E6E76;
}

/* ===== 提交按钮（悬浮 FAB，右下角，设计稿同款） ===== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 36rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 90, 54, 0.35);
}

.fab:active {
  opacity: 0.85;
}

/* ===== 提交弹窗（居中卡片式，字段+按钮整体滚动） ===== */
.mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.6);
}

.sheet {
  width: 100%;
  max-width: 600rpx;
  height: 80vh;
  background: #1B1B20;
  border-radius: 20rpx;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sheet-body {
  flex: 1;
  min-height: 0;
}

.sheet-body::-webkit-scrollbar,
.sheet-body ::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.sheet-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.f-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #26262C;
}

.f-row-top {
  align-items: flex-start;
}

.f-label {
  width: 96rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.f-picker {
  font-size: 28rpx;
  color: #FF8A6E;
  padding: 8rpx 24rpx;
  background: rgba(255, 90, 54, 0.16);
  border-radius: 10rpx;
}

.f-textarea {
  flex: 1;
  width: 100%;
  min-height: 180rpx;
  font-size: 28rpx;
  color: #D9D9DE;
  line-height: 1.6;
}

.ph {
  color: #6E6E76;
}

/* 照片多选 */
.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.photo-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #17171B;
  border: 2rpx dashed #3A3A42;
  color: #8C8C94;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-uploading {
  opacity: 0.5;
}

.f-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #6E6E76;
  text-align: center;
}

.f-save {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 8rpx 0;
}

.f-save::after {
  border: none;
}

.f-saving {
  opacity: 0.6;
}
