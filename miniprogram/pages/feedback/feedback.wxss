.page {
  min-height: 100vh;
  background: #F7F7F8;
  padding: 24rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 顶部说明 ===== */
.hero {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 30, 0.04);
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1E;
}

.hero-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8C8C8C;
  line-height: 1.6;
}

/* ===== 空态/加载 ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 120rpx 40rpx 0;
  color: #8C8C8C;
  font-size: 28rpx;
}

.state-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4D4D4D;
}

.state-desc {
  font-size: 26rpx;
}

/* ===== 建议卡片 ===== */
.fb-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 30, 0.04);
}

.fb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fb-type {
  font-size: 24rpx;
  color: #FF5A36;
  background: #FFF2EE;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.fb-status {
  font-size: 24rpx;
  color: #8C8C8C;
}

.fb-status-pending {
  color: #8C8C8C;
}

.fb-status-done {
  color: #00B386;
}

.fb-status-rejected {
  color: #E5484D;
}

.fb-desc {
  display: block;
  margin-top: 18rpx;
  font-size: 30rpx;
  color: #1A1A1E;
  line-height: 1.6;
  word-break: break-all;
}

.fb-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.fb-photo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
}

/* 官方回复块 */
.fb-reply {
  margin-top: 20rpx;
  background: #F7F7F8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.fb-reply-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fb-reply-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #FF5A36;
}

.fb-reply-time {
  font-size: 22rpx;
  color: #C0C0C4;
}

.fb-reply-text {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #4D4D4D;
  line-height: 1.6;
  word-break: break-all;
}

.fb-time {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #C0C0C4;
}

/* ===== 提交按钮 ===== */
.fab {
  margin-top: 32rpx;
  background: #FF5A36;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 48rpx;
}

/* ===== 提交弹窗（居中卡片式，字段+按钮整体滚动） ===== */
.mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.5);
}

.sheet {
  width: 100%;
  max-width: 600rpx;
  height: 80vh;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sheet-body {
  flex: 1;
  min-height: 0;
}

.sheet-body::-webkit-scrollbar,
.sheet-body ::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.sheet-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1E;
  margin-bottom: 24rpx;
}

.f-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.f-row-top {
  align-items: flex-start;
}

.f-label {
  width: 96rpx;
  font-size: 28rpx;
  color: #1A1A1E;
  flex-shrink: 0;
}

.f-picker {
  font-size: 28rpx;
  color: #1A1A1E;
  padding: 8rpx 24rpx;
  background: #F7F7F8;
  border-radius: 10rpx;
}

.f-textarea {
  flex: 1;
  width: 100%;
  min-height: 180rpx;
  font-size: 28rpx;
  color: #1A1A1E;
  line-height: 1.6;
}

.ph {
  color: #C0C0C4;
}

/* 照片多选 */
.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.photo-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #F0F0F2;
  color: #8C8C8C;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-uploading {
  opacity: 0.5;
}

.f-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #C0C0C4;
  text-align: center;
}

.f-save {
  margin-top: 32rpx;
  background: #FF5A36;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 8rpx 0;
}

.f-save::after {
  border: none;
}

.f-saving {
  opacity: 0.6;
}
