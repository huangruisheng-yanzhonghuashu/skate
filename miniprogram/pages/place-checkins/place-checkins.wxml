<!-- 自定义导航栏（原生导航移除后自绘，media-viewer 预览可全屏覆盖） -->
<view class="nav" style="padding-top: {{statusBarHeight}}px">
  <view class="nav-row">
    <view class="nav-back-btn" hover-class="nav-btn-hover" bindtap="goBack" aria-role="button" aria-label="返回">
      <image class="nav-back-icon" src="{{icons.back}}" mode="aspectFit" />
    </view>
    <text class="nav-title">{{placeName || '全部打卡'}}</text>
    <view class="nav-right"></view>
  </view>
</view>

<view class="page" style="padding-top: {{statusBarHeight + 44}}px">
  <view wx:if="{{empty && !loading}}" class="empty">
    <text class="empty-text">还没有打卡，去场地或店铺主页发第一条</text>
    <view class="empty-btn" bindtap="goPlace">去打卡</view>
  </view>

  <!-- 打卡总数（设计稿：共 N 条打卡） -->
  <view wx:if="{{list.length}}" class="count-line">共 {{list.length}} 条打卡</view>

  <view wx:for="{{list}}" wx:key="id" class="card card-in" style="animation-delay: {{index < 10 ? index * 60 : 0}}ms">
    <view class="head" hover-class="head-hover" catchtap="goUserProfile" data-openid="{{item.openid}}" data-user="{{item.user}}" data-avatar="{{item.avatarFile}}" data-years="{{item.skateYears}}">
      <image wx:if="{{item.avatarFile}}" class="avatar-img" src="{{item.avatarFile}}" mode="aspectFill" />
      <view wx:else class="avatar">{{item.avatarText}}</view>
      <view class="who">
        <view class="name-row">
          <text class="name">{{item.user}}</text>
          <text wx:if="{{item.skateYears}}" class="checkin-years">滑龄{{item.skateYears}}</text>
        </view>
        <text class="time">{{item.time}}</text>
      </view>
    </view>
    <text wx:if="{{item.note}}" class="note">{{item.note}}</text>
    <view wx:if="{{item.media.length}}" class="photos photos-{{item.media.length >= 3 ? 'grid' : item.media.length}}">
      <view wx:for="{{item.media}}" wx:for-item="p" wx:key="url" class="photo-cell" catchtap="previewMedia" data-media="{{item.media}}" data-index="{{index}}">
        <video
          wx:if="{{p.type === 'video'}}"
          class="pc-video"
          src="{{p.url}}"
          object-fit="cover"
          controls="{{false}}"
          show-center-play-btn="{{false}}"
        />
        <image
          wx:else
          class="photo"
          src="{{p.url}}"
          mode="aspectFill"
          lazy-load
        />
        <view wx:if="{{p.type === 'video'}}" class="video-play"></view>
        <view wx:if="{{p.local}}" class="video-uploading">上传中</view>
      </view>
    </view>
    <!-- 评论入口（设计稿：💬 N 条评论 左 + 展开/收起 右，两端对齐） -->
    <view class="cmt-toggle {{item.commentsOpen ? 'cmt-toggle-open' : ''}}" data-id="{{item.id}}" bindtap="toggleComments">
      <image class="cmt-icon" src="{{icons.commentAsh}}" mode="aspectFit" />
      <text class="cmt-count">{{item.commentCount}} 条评论</text>
      <text class="cmt-caret-text">{{item.commentsOpen ? '收起' : '展开'}}</text>
    </view>
    <comment-box
      wx:if="{{item.commentsOpen}}"
      checkin-id="{{item.id}}"
      data-id="{{item.id}}"
      bind:countchange="onCommentCount"
    />
  </view>

  <view wx:if="{{loading}}" class="more">加载中...</view>
  <view wx:elif="{{!finished && list.length}}" class="more">上拉加载更多</view>
  <view wx:elif="{{finished && list.length}}" class="more">— 没有更多了 —</view>
</view>

<!-- 打卡媒体查看器（微博式：图视频混滑、视频封面点播） -->
<media-viewer
  visible="{{viewerShow}}"
  sources="{{viewerSources}}"
  current="{{viewerCurrent}}"
  bind:close="onViewerClose"
/>
