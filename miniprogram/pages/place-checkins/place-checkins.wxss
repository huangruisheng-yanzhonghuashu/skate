.page {
  min-height: 100vh;
  background: #111114;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 200rpx 0 0;
}

.empty-text {
  font-size: 28rpx;
  color: #8C8C94;
}

.empty-btn {
  padding: 16rpx 56rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

/* 打卡卡片 */
.card {
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

/* 错峰入场 */
.card-in {
  animation: card-in-anim 0.35s ease backwards;
}

@keyframes card-in-anim {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.who {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.time {
  font-size: 22rpx;
  color: #6E6E76;
}

.note {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  color: #D9D9DE;
  line-height: 1.6;
  word-break: break-all;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.photo {
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1 / 1;
  border-radius: 12rpx;
}

/* 微博式布局（与详情页打卡动态同款）：3 列格子精确铺满；
   1 张原比例大图（bindload 换算，方图为加载前兜底）；4 张 2×2 紧凑格（格子与九宫格同尺寸） */
.photos.cp-one .photo {
  width: 420rpx;
}

.photos.cp-four {
  max-width: calc((100% - 24rpx) / 3 * 2 + 14rpx);
}

.photos.cp-four .photo {
  width: calc((100% - 12rpx) / 2);
}

.more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #6E6E76;
}

/* 打卡总数行 */
.count-line {
  font-size: 24rpx;
  color: #8C8C94;
  margin-bottom: 20rpx;
}

/* 评论入口（设计稿：左右两端，展开态橙色高亮） */
.cmt-toggle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #26262C;
  font-size: 24rpx;
  color: #8C8C94;
}

.cmt-toggle-open {
  color: #FF8A6E;
}

.cmt-icon {
  width: 30rpx;
  height: 30rpx;
}

.cmt-count {
  flex: 1;
}

/* 展开/收起（右侧文字，设计稿同款） */
.cmt-caret-text {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #6E6E76;
}

.cmt-toggle-open .cmt-caret-text {
  color: #FF8A6E;
}
