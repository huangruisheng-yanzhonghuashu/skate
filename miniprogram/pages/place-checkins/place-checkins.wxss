.page {
  min-height: 100vh;
  background: #111114;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 自定义导航栏（原生导航移除后自绘，media-viewer 预览可全屏覆盖） */
.nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 30;
  background: #1A1A1E;
}

.nav-row {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.nav-back-btn {
  width: 64rpx;
  height: 64rpx;
  margin-left: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn-hover {
  opacity: 0.7;
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
}

.nav-title {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-right {
  width: 52rpx;
  flex-shrink: 0;
}

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 200rpx 0 0;
}

.empty-text {
  font-size: 28rpx;
  color: #8C8C94;
}

.empty-btn {
  padding: 16rpx 56rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

/* 打卡卡片 */
.card {
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

/* 错峰入场 */
.card-in {
  animation: card-in-anim 0.35s ease backwards;
}

@keyframes card-in-anim {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 打卡人头部可点（进滑手主页）按压反馈 */
.head-hover {
  opacity: 0.7;
}

.avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.who {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.name-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

/* 滑龄：昵称右侧次级小字，与时间同色阶，不挤压昵称 */
.checkin-years {
  flex-shrink: 0;
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #8A8A93;
}

/* 打卡视频（九宫格内联播放，与图片同占位） */
.pc-video {
  width: 100%;
  height: 100%;
}

/* 视频封面播放按钮（微博式：九宫格内不内联播放，点击进混合查看器播放） */
.video-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
  width: 0;
  height: 0;
  border-left: 26rpx solid rgba(255, 255, 255, 0.92);
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  filter: drop-shadow(0 0 6rpx rgba(0, 0, 0, 0.4));
}

/* 视频异步上传中角标（微博式：本机可见临时视频，云端他人待上传完成后可见） */
.photo-cell {
  position: relative;
}

.video-uploading {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  z-index: 2;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 18rpx;
}

.time {
  font-size: 22rpx;
  color: #6E6E76;
}

.note {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  color: #D9D9DE;
  line-height: 1.6;
  word-break: break-all;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

/* 图片布局与发现页动态流同款：1 张 320rpx 方图；2 张对半分；3 张起 3 列方格铺满 */
.photos .photo-cell {
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: #17171B;
}

.photos.photos-1 .photo-cell {
  width: 320rpx;
}

.photos.photos-2 .photo-cell {
  width: calc((100% - 12rpx) / 2);
}

.photo {
  width: 100%;
  height: 100%;
}

.more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #6E6E76;
}

/* 打卡总数行 */
.count-line {
  font-size: 24rpx;
  color: #8C8C94;
  margin-bottom: 20rpx;
}

/* 评论入口（设计稿：左右两端，展开态橙色高亮） */
.cmt-toggle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #26262C;
  font-size: 24rpx;
  color: #8C8C94;
}

.cmt-toggle-open {
  color: #FF8A6E;
}

.cmt-icon {
  width: 30rpx;
  height: 30rpx;
}

.cmt-count {
  flex: 1;
}

/* 展开/收起（右侧文字，设计稿同款） */
.cmt-caret-text {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #6E6E76;
}

.cmt-toggle-open .cmt-caret-text {
  color: #FF8A6E;
}
