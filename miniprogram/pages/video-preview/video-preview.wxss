/* 视频预览页样式：与 media-viewer 视频分支同构（vp- 前缀），宿主为原生页面 */
page {
  background: #000000;
}

.vp-page {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: #000000;
}

.vp-swiper {
  width: 100%;
  height: 100%;
}

.vp-video-wrap {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vp-video {
  width: 100%;
  height: 100%;
}

/* 播放按钮：半透明圆底 + 白色三角 */
.vp-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  z-index: 2;
}

.vp-play::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-38%, -50%);
  border-left: 34rpx solid rgba(255, 255, 255, 0.95);
  border-top: 22rpx solid transparent;
  border-bottom: 22rpx solid transparent;
}

/* 顶部计数器（多视频；top 由 JS 按状态栏高度内联，行高与页面自绘导航一致） */
.vp-count {
  position: absolute;
  left: 0;
  right: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  font-weight: 500;
  z-index: 3;
}

/* 底部圆点指示器（多视频） */
.vp-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  z-index: 3;
}

.vp-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.35);
}

.vp-dot-active {
  width: 14rpx;
  height: 14rpx;
  background: #FF5A36;
}

/* 左上返回（top 由 JS 按状态栏高度内联，行高 88rpx 与页面导航行一致） */
.vp-back {
  position: absolute;
  left: 8rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 4;
}

.vp-back-icon {
  width: 44rpx;
  height: 44rpx;
}

/* ===== 右下操作组（点赞 / 评论 / 转发） =====
 * 位置与 media-viewer 视频态一致：right 40rpx / bottom 240rpx
 * align-items: flex-end 保证三个圆钮右缘对齐 */
.vp-actions {
  position: absolute;
  right: 40rpx;
  bottom: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 36rpx;
  z-index: 4;
}

.vp-action {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(30, 30, 35, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.vp-action-hover {
  opacity: 0.7;
}

.vp-action-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 计数角标：贴按钮正下方 */
.vp-action-badge {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-top: 2rpx;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 500;
  white-space: nowrap;
}

/* 转发按钮壳：固定尺寸圆钮，图标由壳内 image 直接渲染 */
.vp-share-wrap {
  width: 104rpx;
  height: 104rpx;
}

/* open-type=share 的透明命中层：绝对铺满壳、完全隐形，仅承接点击 */
.vp-share-btn {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  border-radius: 50%;
  opacity: 0;
  z-index: 2;
  font-size: 0;
  line-height: 1;
  overflow: hidden;
}

.vp-share-btn::after {
  display: none;
}

/* 点赞动效（与发现页卡片一致） */
.vp-actions .vp-action-icon {
  transition: transform 0.15s ease-in-out;
}

/* ===== 半屏评论面板 ===== */
.vp-cmask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 10;
}

.vp-csheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  background: #1E1E23;
  border-radius: 48rpx 48rpx 0 0;
  z-index: 11;
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.vp-c-handle {
  width: 100%;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.vp-c-handlebar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.25);
}

.vp-c-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.vp-c-title {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.vp-c-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vp-c-close-icon {
  width: 34rpx;
  height: 34rpx;
}

.vp-c-list {
  flex: 1;
  min-height: 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
