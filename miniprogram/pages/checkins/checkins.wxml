<view class="page">
  <!-- 统计卡 ×3（图标 + 大数字 + 小单位 + 标签） -->
  <view class="stats">
    <view class="stat">
      <image class="stat-icon" src="{{icons.trophy}}" mode="aspectFit" />
      <view class="stat-value-row">
        <text class="stat-num">{{stats.total}}</text>
        <text class="stat-unit">次</text>
      </view>
      <text class="stat-label">总签到</text>
    </view>
    <view class="stat">
      <image class="stat-icon" src="{{icons.flame}}" mode="aspectFit" />
      <view class="stat-value-row">
        <text class="stat-num">{{stats.streak}}</text>
        <text class="stat-unit">天</text>
      </view>
      <text class="stat-label">连续签到</text>
    </view>
    <view class="stat">
      <image class="stat-icon" src="{{icons.calendar}}" mode="aspectFit" />
      <view class="stat-value-row">
        <text class="stat-num">{{stats.weekDays}}</text>
        <text class="stat-unit">天</text>
      </view>
      <text class="stat-label">本周签到</text>
    </view>
  </view>

  <!-- 签到日历（左右切月；已签=橙字，今日=橙圆，未来日期弱化） -->
  <view class="calendar">
    <view class="cal-head">
      <view class="cal-arrow" hover-class="cal-arrow-hover" data-delta="-1" bindtap="switchMonth" aria-role="button" aria-label="上个月">
        <image class="cal-arrow-icon" src="{{icons.chevronLeft}}" mode="aspectFit" />
      </view>
      <text class="cal-title">{{monthTitle}}</text>
      <view
        class="cal-arrow {{isCurrentMonth ? 'cal-arrow-disabled' : ''}}"
        hover-class="cal-arrow-hover"
        data-delta="1"
        bindtap="switchMonth"
        aria-role="button"
        aria-label="下个月"
      >
        <image class="cal-arrow-icon" src="{{icons.chevronRight}}" mode="aspectFit" />
      </view>
    </view>
    <view class="week-row">
      <text wx:for="{{weekLabels}}" wx:key="*this" class="week-label">{{item}}</text>
    </view>
    <view class="day-grid">
      <view wx:for="{{cells}}" wx:key="index" class="day-cell">
        <block wx:if="{{item.day > 0}}">
          <view
            wx:if="{{item.isToday}}"
            class="day-today {{item.checked ? 'day-today-checked' : ''}}"
          >{{item.day}}</view>
          <text
            wx:else
            class="day-num {{item.checked ? 'day-num-checked' : ''}} {{item.future ? 'day-future' : ''}}"
          >{{item.day}}</text>
        </block>
      </view>
    </view>
  </view>

  <!-- 打卡记录（最近30条；长按删除，避免误触） -->
  <view class="records">
    <text class="section-title">打卡记录</text>
    <view
      wx:for="{{records}}"
      wx:key="id"
      class="rec"
      data-id="{{item.id}}"
      bindlongpress="delRecord"
    >
      <view class="rec-main" data-id="{{item.venueId}}" data-kind="{{item.kind}}" bindtap="goRecord">
        <view class="rec-row1">
          <text class="rec-name">{{item.venueName}}</text>
          <text class="rec-kind {{item.kind === 'shop' ? 'rec-kind-shop' : ''}}">{{item.kind === 'shop' ? '店铺' : '场地'}}</text>
          <text class="rec-time">{{item.timeText}}</text>
        </view>
        <text wx:if="{{item.note}}" class="rec-note">{{item.note}}</text>
        <image
          wx:if="{{item.photo}}"
          class="rec-photo"
          src="{{item.photo}}"
          mode="aspectFill"
          data-url="{{item.photo}}"
          catchtap="previewRecordPhoto"
        />
      </view>
    </view>
    <view wx:if="{{!records.length}}" class="rec-empty">
      <text>还没有打卡记录，去场地或店铺签个到吧</text>
    </view>
    <view wx:if="{{records.length}}" class="rec-hint">长按记录可删除</view>
  </view>

  <!-- 打卡排行榜 -->
  <view class="board">
    <text class="section-title">打卡排行榜</text>
    <view wx:if="{{!board.length}}" class="board-empty">暂无排行数据，快去签到抢第一</view>
    <block wx:else>
      <view wx:for="{{board}}" wx:key="rank" class="board-row {{item.self ? 'board-row-self' : ''}}" hover-class="board-row-hover" bindtap="goUserProfile" data-openid="{{item.openid}}" data-user="{{item.user}}" data-self="{{item.self}}">
        <view class="board-left">
          <view class="board-rank board-rank-{{item.rank <= 3 ? item.rank : 'n'}}">{{item.rank}}</view>
          <text class="board-user {{item.self ? 'board-user-self' : ''}}">{{item.user}}{{item.self ? '（我）' : ''}}</text>
        </view>
        <text class="board-count {{item.rank <= 3 ? 'board-count-top' : ''}}">{{item.count}}次</text>
      </view>
      <view class="board-more" bindtap="toggleBoard">
        {{boardExpanded ? '收起榜单' : '查看完整榜单（' + board.length + ' 人）'}}
      </view>
    </block>
  </view>
</view>
