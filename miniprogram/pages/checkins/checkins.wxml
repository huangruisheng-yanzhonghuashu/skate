<view class="page">
  <!-- 统计卡片 -->
  <view class="stats">
    <view class="stat">
      <image class="stat-icon" src="{{icons.trophy}}" mode="aspectFit" />
      <text class="stat-label">总签到</text>
      <text class="stat-value">{{stats.total}}次</text>
    </view>
    <view class="stat">
      <image class="stat-icon" src="{{icons.flame}}" mode="aspectFit" />
      <text class="stat-label">连续签到</text>
      <text class="stat-value">{{stats.streak}}天</text>
    </view>
    <view class="stat">
      <image class="stat-icon" src="{{icons.calendar}}" mode="aspectFit" />
      <text class="stat-label">本周签到</text>
      <text class="stat-value">{{stats.weekDays}}天</text>
    </view>
  </view>

  <!-- 签到日历 -->
  <view class="calendar">
    <text class="section-title">{{monthTitle}}</text>
    <view class="week-row">
      <text wx:for="{{weekLabels}}" wx:key="*this" class="week-label">{{item}}</text>
    </view>
    <view class="day-grid">
      <view wx:for="{{cells}}" wx:key="index" class="day-cell">
        <block wx:if="{{item.day > 0}}">
          <view wx:if="{{item.isToday}}" class="day-today {{item.checked ? 'day-today-checked' : ''}}">{{item.day}}</view>
          <text wx:else class="day-num {{item.checked ? 'day-num-checked' : ''}}">{{item.day}}</text>
          <view class="day-dot {{item.checked ? 'day-dot-on' : ''}}"></view>
        </block>
      </view>
    </view>
  </view>

  <!-- 签到排行榜 -->
  <view class="board">
    <view class="board-title">
      <view class="line"></view>
      <text>签到排行榜 (本周)</text>
      <view class="line"></view>
    </view>
    <view wx:for="{{board}}" wx:key="rank" class="board-row">
      <view class="board-left">
        <view class="board-rank {{item.rank <= 3 ? 'board-rank-top' : ''}}">{{item.rank}}</view>
        <text class="board-user {{item.self ? 'board-user-self' : ''}}">{{item.user}}{{item.self ? ' (我)' : ''}}</text>
      </view>
      <text class="board-count {{item.rank <= 3 ? 'board-count-top' : ''}}">{{item.count}}次</text>
    </view>
    <view class="board-more" bindtap="showAllBoard">查看全部排行榜 &gt;</view>
  </view>
</view>
