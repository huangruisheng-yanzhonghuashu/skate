.page {
  padding: 32rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 统计带（设计稿：一卡三列，label 上 + 数字下，竖分隔线，无图标无子卡） ===== */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 8rpx 0;
}

.stat-col {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
}

.stat-col + .stat-col {
  border-left: 1rpx solid #26262C;
}

.stat-label {
  font-size: 26rpx;
  color: #8C8C94;
  line-height: 1.2;
}

.stat-value {
  display: flex;
  align-items: baseline;
}

/* 数字 40rpx 粗体 + 单位 22rpx 弱化，形成数据节奏 */
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
}

.stat-unit {
  font-size: 22rpx;
  color: #6E6E76;
  margin-left: 4rpx;
}

/* ===== 日历 ===== */
.calendar {
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 32rpx;
}

/* 标题左 + 双箭头并排右（设计稿同款） */
.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.cal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.cal-nav {
  display: flex;
  gap: 8rpx;
}

.cal-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #17171B;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-arrow-hover {
  background: #26262C;
}

.cal-arrow-disabled {
  opacity: 0.35;
}

.cal-arrow-icon {
  width: 32rpx;
  height: 32rpx;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  margin-bottom: 16rpx;
}

.week-label {
  font-size: 24rpx;
  color: #6E6E76;
  padding: 8rpx 0;
}

.day-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
}

.day-cell {
  position: relative;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-num {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 26rpx;
  color: #A6A6AD;
  text-align: center;
}

/* 已签日期：提亮白字 + 底部 3px 主色小圆点（设计稿同款） */
.day-num-checked {
  color: #FFFFFF;
  font-weight: 600;
}

.day-num-checked::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #FF5A36;
}

/* 未来日期：弱化 40% */
.day-future {
  opacity: 0.4;
}

/* 今日：主色圆底白字（设计稿同款） */
.day-today {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 50%;
  background: #FF5A36;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}

/* ===== 本月签到榜 ===== */
.board {
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 32rpx;
}

.board-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.board-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.board-chip {
  font-size: 20rpx;
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.16);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.4;
}

.board-row {
  height: 96rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 8rpx;
}

.board-row + .board-row {
  border-top: 1rpx solid #26262C;
}

.board-row-hover {
  background: #26262C;
}

/* 名次徽章（设计稿描边式）：1=主色实底 / 2=灰描边 / 3=金描边 / 其余灰描边 */
.board-rank {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.board-rank-1 {
  background: #FF5A36;
  color: #FFFFFF;
}

.board-rank-2 {
  border: 1rpx solid #A6A6AD;
  color: #A6A6AD;
}

.board-rank-3 {
  border: 1rpx solid #FFB800;
  color: #FFB800;
}

.board-rank-n {
  border: 1rpx solid #6E6E76;
  color: #6E6E76;
}

/* 首字母头像：四组暗色渐变轮换（设计稿同款） */
.board-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  font-size: 22rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.board-avatar-0 {
  background: linear-gradient(135deg, #3A3140 0%, #2C2534 100%);
}

.board-avatar-1 {
  background: linear-gradient(135deg, #40342A 0%, #33291F 100%);
}

.board-avatar-2 {
  background: linear-gradient(135deg, #2A3A38 0%, #20302E 100%);
}

.board-avatar-3 {
  background: linear-gradient(135deg, #302B33 0%, #3B3540 100%);
}

.board-user {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.board-count {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.board-count-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.board-count-unit {
  font-size: 22rpx;
  color: #6E6E76;
  margin-left: 4rpx;
}

/* 我的行：主色淡底 + 主色左缘（设计稿同款） */
.board-self {
  margin-top: 24rpx;
  height: 80rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
  background: rgba(255, 90, 54, 0.12);
  border-left: 6rpx solid #FF5A36;
  border-radius: 12rpx;
}

.board-self-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.board-self-sep {
  font-size: 26rpx;
  color: #6E6E76;
}

.board-self-meta {
  font-size: 26rpx;
  color: #A6A6AD;
}

.board-more {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8C8C94;
  padding: 8rpx 0;
}

.board-empty {
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6E6E76;
}

/* ===== 最近记录（设计稿：无卡包底，104rpx 行 + 行分隔线） ===== */
.records {
  /* 无卡底 */
}

.rec-group-title {
  display: block;
  font-size: 26rpx;
  color: #6E6E76;
  margin: 0 4rpx 8rpx;
}

.rec {
  border-bottom: 1rpx solid #26262C;
}

.rec:last-of-type {
  border-bottom: none;
}

.rec-main {
  height: 104rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-radius: 12rpx;
}

.rec-main-hover {
  background: #26262C;
}

.rec-date {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #8C8C94;
}

.rec-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 类型徽章：场地=青色调 / 店铺=橙色调 */
.rec-kind {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #00D4AA;
  background: rgba(0, 212, 170, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.2;
}

.rec-kind-shop {
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.16);
}

.rec-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

.rec-empty {
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6E6E76;
}

/* 长按删除提示 */
.rec-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #6E6E76;
}
