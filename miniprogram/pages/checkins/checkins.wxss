.page {
  padding: 32rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 统计卡 ×3（设计稿：独立小卡，图标 + 大数字 + 小单位 + 标签） ===== */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 28rpx 12rpx;
}

.stat-icon {
  width: 44rpx;
  height: 44rpx;
}

.stat-value-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

/* 数字 40rpx 粗体 + 单位 22rpx 弱化，形成数据节奏 */
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.stat-unit {
  font-size: 22rpx;
  color: #8C8C94;
}

.stat-label {
  font-size: 22rpx;
  color: #8C8C94;
}

/* ===== 区块标题（左对齐，去横线装饰，与设计稿一致） ===== */
.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

/* ===== 日历 ===== */
.calendar {
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 32rpx;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.cal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.cal-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #17171B;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-arrow-hover {
  background: #26262C;
}

.cal-arrow-disabled {
  opacity: 0.35;
}

.cal-arrow-icon {
  width: 28rpx;
  height: 28rpx;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  margin-bottom: 16rpx;
}

.week-label {
  font-size: 24rpx;
  color: #6E6E76;
  padding: 8rpx 0;
}

.day-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  row-gap: 16rpx;
  text-align: center;
}

.day-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 0;
}

.day-num {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 28rpx;
  color: #A6A6AD;
}

/* 已签日期：橙色数字（设计稿同款） */
.day-num-checked {
  color: #FF5A36;
  font-weight: 700;
}

/* 未来日期：弱化 40% */
.day-future {
  opacity: 0.4;
}

/* 今日：橙色描边圈；今日已签：橙底实心白字 */
.day-today {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  border-radius: 50%;
  border: 3rpx solid #FF5A36;
  color: #FF5A36;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.day-today-checked {
  background: #FF5A36;
  color: #FFFFFF;
  font-weight: 700;
}

/* ===== 打卡记录 ===== */
.records {
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 32rpx;
}

.rec {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #26262C;
}

.rec:last-of-type {
  border-bottom: none;
}

.rec-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rec-row1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rec-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 记录类型徽章：签到=灰调 / 打卡=橙调（名称旁小徽章，与场地/店铺徽章并列） */
.rec-type {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #A6A6AD;
  background: rgba(166, 166, 173, 0.14);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.2;
}

.rec-type-post {
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.16);
}

/* 类型徽章：场地=青色调 / 店铺=橙色调（设计稿：名称旁小徽章） */
.rec-kind {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #00D4AA;
  background: rgba(0, 212, 170, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.2;
}

.rec-kind-shop {
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.16);
}

.rec-time {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 22rpx;
  color: #6E6E76;
}

.rec-note {
  font-size: 25rpx;
  color: #A6A6AD;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-photo {
  width: 132rpx;
  height: 132rpx;
  border-radius: 10rpx;
}

.rec-empty {
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6E6E76;
}

/* 长按删除提示 */
.rec-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #6E6E76;
}

/* ===== 签到排行榜 ===== */
.board {
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 32rpx;
}

.board-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
}

/* 榜单行可点（进滑手主页）按压反馈 */
.board-row-hover {
  background: #26262C;
}

/* 我的行：橙色淡底高亮（设计稿同款） */
.board-row-self {
  background: rgba(255, 90, 54, 0.10);
}

.board-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 名次徽章：金/银/铜 + 其余灰 */
.board-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.board-rank-1 {
  background: rgba(255, 184, 0, 0.16);
  color: #FFB800;
}

.board-rank-2 {
  background: rgba(192, 196, 204, 0.16);
  color: #C0C4CC;
}

.board-rank-3 {
  background: rgba(224, 138, 80, 0.18);
  color: #E08A50;
}

.board-rank-n {
  background: #17171B;
  color: #8C8C94;
  font-weight: 500;
}

.board-user {
  font-size: 28rpx;
  color: #D9D9DE;
}

.board-user-self {
  color: #FF5A36;
  font-weight: 600;
}

.board-count {
  font-size: 28rpx;
  font-weight: 600;
  color: #8C8C94;
}

.board-count-top {
  color: #FF5A36;
}

.board-more {
  margin-top: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8C8C94;
  padding: 8rpx 0;
}

.board-empty {
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6E6E76;
}
