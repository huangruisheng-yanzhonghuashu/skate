<view class="page" wx:if="{{shop}}">
  <!-- 照片轮播（云存储 fileID，点击预览） -->
  <swiper class="photos" indicator-dots indicator-active-color="#FF5A36" circular>
    <swiper-item wx:for="{{shop.photos}}" wx:key="*this">
      <image class="photo" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewPhoto" />
    </swiper-item>
  </swiper>

  <!-- 信息区 -->
  <view class="info">
    <view class="name-row">
      <text class="name">{{shop.name}}</text>
      <text wx:if="{{status}}" class="status {{openNow ? 'status-open' : 'status-closed'}}">{{status}}</text>
    </view>
    <text wx:if="{{shop.hot}}" class="hot-tag">热门店铺</text>

    <view class="block">
      <text class="block-title">服务项目</text>
      <view class="svc-list">
        <text wx:for="{{shop.services}}" wx:key="*this" class="svc">{{item}}</text>
      </view>
    </view>

    <view class="block">
      <text class="block-title">营业时间</text>
      <text class="block-text">{{shop.hours.open}} - {{shop.hours.close}}</text>
    </view>

    <view class="block">
      <text class="block-title">店铺地址</text>
      <text class="block-text">{{shop.address}}</text>
    </view>

    <view wx:if="{{shop.phone}}" class="block">
      <text class="block-title">联系电话</text>
      <text class="block-text">{{shop.phone}}</text>
    </view>
  </view>

  <!-- 打卡动态（云端真实流：所有人带留言的打卡，最近3条） -->
  <view class="feed">
    <view class="feed-head">
      <text class="feed-title">打卡动态</text>
      <view class="feed-more" bindtap="showAllCheckins">
        <text>查看全部打卡</text>
        <text class="feed-more-arrow">›</text>
      </view>
    </view>
    <view wx:if="{{feed.length}}">
      <view wx:for="{{feed}}" wx:key="id" class="fcard">
        <view class="fhead">
          <image wx:if="{{item.avatarFile}}" class="favatar-img" src="{{item.avatarFile}}" mode="aspectFill" />
          <view wx:else class="favatar" style="background: {{item.color}}">{{item.avatarText}}</view>
          <view class="fuser">
            <text class="fname">{{item.user}}</text>
            <text class="ftime">{{item.time}}</text>
          </view>
        </view>
        <text class="fnote">{{item.note}}</text>
        <view wx:if="{{item.photos.length}}" class="fphotos">
          <image
            wx:for="{{item.photos}}"
            wx:for-item="p"
            wx:key="*this"
            class="fphoto"
            src="{{p}}"
            mode="aspectFill"
            data-urls="{{item.photos}}"
            data-url="{{p}}"
            catchtap="previewFeedPhotos"
          />
        </view>
      </view>
    </view>
    <view wx:else class="fempty">还没有打卡，点下方「打卡」抢首条</view>
  </view>

  <!-- 底部操作：打卡(或补充) / 拨号 / 导航 -->
  <view class="actions">
    <view wx:if="{{checked}}" class="act act-done" bindtap="openEditCheckin">已打卡 · 补充</view>
    <button wx:else class="act act-checkin" bindtap="openCheckin">打卡</button>
    <button wx:if="{{shop.phone}}" class="act act-call" bindtap="callShop">拨打电话</button>
    <button class="act act-nav" bindtap="openMap">地图导航</button>
  </view>

  <!-- 打卡弹窗 -->
  <view wx:if="{{checkinOpen}}" class="mask" bindtap="closeCheckin" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{checkinMode === 'edit' ? '补充今日打卡' : '店铺打卡'}}</view>

      <view class="f-row">
        <text class="f-label">说点什么</text>
        <textarea
          class="f-textarea"
          value="{{note}}"
          maxlength="200"
          placeholder="说点什么... (选填)"
          placeholder-class="ph"
          bindinput="onNoteInput"
        />
      </view>

      <view class="f-row">
        <view class="pgrid">
          <view wx:for="{{checkinPhotos}}" wx:key="*this" class="ptile">
            <image class="ptile-img" src="{{item}}" mode="aspectFill" />
            <view class="ptile-del" data-index="{{index}}" catchtap="removeCheckinPhoto">×</view>
          </view>
          <view wx:if="{{checkinPhotos.length < 9}}" class="padd" bindtap="chooseCheckinPhoto">＋ 添加照片</view>
        </view>
      </view>

      <button class="f-btn {{checkinSubmitting ? 'f-btn-loading' : ''}}" bindtap="confirmCheckin">
        {{checkinSubmitting ? (checkinMode === 'edit' ? '更新中...' : '打卡中...') : (checkinMode === 'edit' ? '更新打卡' : '确认打卡')}}
      </button>
      <view class="f-cancel" bindtap="closeCheckin">取消</view>
    </view>
  </view>
</view>
