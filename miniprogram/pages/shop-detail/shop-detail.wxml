<view class="page" wx:if="{{shop}}">
  <!-- 照片轮播（云存储 fileID，点击预览） -->
  <swiper class="photos" indicator-dots indicator-active-color="#FF5A36" circular>
    <swiper-item wx:for="{{shop.photos}}" wx:key="*this">
      <image class="photo photo-fade" src="{{item}}" mode="aspectFill" lazy-load data-url="{{item}}" bindtap="previewPhoto" />
    </swiper-item>
  </swiper>

  <!-- 信息区 -->
  <view class="info">
    <view class="name-row">
      <text class="name">{{shop.name}}</text>
      <text wx:if="{{status}}" class="status {{openNow ? 'status-open' : 'status-closed'}}">{{status}}</text>
    </view>
    <!-- 聚合评分（可点击弹评分弹窗） -->
    <view class="rating-line" hover-class="rate-hover" bindtap="openRate" aria-role="button" aria-label="查看评分并评分">
      <view class="stars">
        <view class="stars-bg">
          <image wx:for="{{[0,1,2,3,4]}}" wx:key="*this" class="rstar" src="{{icons.starGray}}" mode="aspectFit" />
        </view>
        <view class="stars-fg" style="width: {{(rating || 0) / 5 * 100}}%">
          <image wx:for="{{[0,1,2,3,4]}}" wx:key="*this" class="rstar" src="{{icons.starOrange}}" mode="aspectFit" />
        </view>
      </view>
      <text class="rating-num">{{rating || '暂无评分，点此评分'}}</text>
    </view>
    <text wx:if="{{shop.hot}}" class="hot-tag">热门店铺</text>
    <text wx:if="{{shop.category}}" class="cat-tag">{{shop.category}}</text>

    <view class="block">
      <text class="block-title">服务项目</text>
      <view class="svc-list">
        <text wx:for="{{shop.services}}" wx:key="*this" class="svc">{{item}}</text>
      </view>
    </view>

    <!-- 课程信息（仅培训机构类有） -->
    <view wx:if="{{shop.courses.length}}" class="block">
      <text class="block-title">课程信息</text>
      <view class="svc-list">
        <text wx:for="{{shop.courses}}" wx:key="*this" class="svc">{{item}}</text>
      </view>
    </view>

    <!-- 合作/上课场地（org↔venue 关联，点击进场地详情） -->
    <view wx:if="{{partners.length}}" class="block">
      <text class="block-title">合作/上课场地</text>
      <view
        wx:for="{{partners}}"
        wx:key="id"
        class="partner-row"
        hover-class="partner-hover"
        data-id="{{item.id}}"
        bindtap="goVenue"
        aria-role="button"
        aria-label="进入场地详情"
      >
        <view class="partner-info">
          <text class="partner-name">{{item.name}}</text>
          <text class="partner-addr">{{item.shortAddr}}</text>
        </view>
        <text class="partner-arrow">›</text>
      </view>
    </view>

    <view class="block">
      <text class="block-title">营业时间</text>
      <text class="block-text">{{shop.hours.open}} - {{shop.hours.close}}</text>
    </view>

    <view class="block">
      <text class="block-title">店铺地址</text>
      <text class="block-text">{{shop.address}}</text>
    </view>

    <view wx:if="{{shop.phone}}" class="block">
      <text class="block-title">联系电话</text>
      <text class="block-text">{{shop.phone}}</text>
    </view>
  </view>

  <!-- 打卡动态（云端真实流：所有人带留言的打卡，最近3条） -->
  <view class="feed">
    <view class="feed-head">
      <text class="feed-title">打卡动态</text>
      <view class="feed-more" bindtap="showAllCheckins">
        <text>查看全部打卡</text>
        <text class="feed-more-arrow">›</text>
      </view>
    </view>
    <view wx:if="{{feed.length}}">
      <view wx:for="{{feed}}" wx:key="id" class="fcard">
        <view class="fhead">
          <image wx:if="{{item.avatarFile}}" class="favatar-img" src="{{item.avatarFile}}" mode="aspectFill" />
          <view wx:else class="favatar" style="background: {{item.color}}">{{item.avatarText}}</view>
          <view class="fuser">
            <text class="fname">{{item.user}}</text>
            <text class="ftime">{{item.time}}</text>
          </view>
        </view>
        <text class="fnote">{{item.note}}</text>
        <view wx:if="{{item.photos.length}}" class="fphotos photos-{{item.photos.length >= 3 ? 'grid' : item.photos.length}}">
          <view wx:for="{{item.photos}}" wx:for-item="p" wx:key="*this" class="photo-cell">
            <image
              class="fphoto"
              src="{{p}}"
              mode="aspectFill"
              lazy-load
              data-urls="{{item.photos}}"
              data-url="{{p}}"
              catchtap="previewFeedPhotos"
            />
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="fempty">还没有打卡，点下方「打卡」抢首条</view>
  </view>

  <!-- 底部操作：打卡(或补充) / 拨号 / 导航 -->
  <view class="actions">
    <view wx:if="{{checked}}" class="act act-done" bindtap="openEditCheckin">已打卡 · 补充</view>
    <button wx:else class="act act-checkin" bindtap="openCheckin">打卡</button>
    <button wx:if="{{shop.phone}}" class="act act-call" bindtap="callShop">拨打电话</button>
    <button class="act act-nav" bindtap="openMap">地图导航</button>
  </view>

  <!-- 打卡弹窗 -->
  <view wx:if="{{checkinOpen}}" class="mask" bindtap="closeCheckin" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{checkinMode === 'edit' ? '补充今日打卡' : '店铺打卡'}}</view>

      <view class="f-row">
        <text class="f-label">说点什么</text>
        <textarea
          class="f-textarea"
          value="{{note}}"
          maxlength="200"
          placeholder="说点什么... (选填)"
          placeholder-class="ph"
          bindinput="onNoteInput"
        />
      </view>

      <view class="f-row">
        <view class="pgrid">
          <view wx:for="{{checkinPhotos}}" wx:key="*this" class="ptile">
            <image class="ptile-img" src="{{item}}" mode="aspectFill" />
            <view class="ptile-del" data-index="{{index}}" catchtap="removeCheckinPhoto">×</view>
          </view>
          <view wx:if="{{checkinPhotos.length < 9}}" class="padd" bindtap="chooseCheckinPhoto">＋ 添加照片</view>
        </view>
      </view>

      <button class="f-btn {{checkinSubmitting ? 'f-btn-loading' : ''}}" bindtap="confirmCheckin">
        {{checkinSubmitting ? (checkinMode === 'edit' ? '更新中...' : '打卡中...') : (checkinMode === 'edit' ? '更新打卡' : '确认打卡')}}
      </button>
      <view class="f-cancel" bindtap="closeCheckin">取消</view>
    </view>
  </view>
</view>

<!-- 打卡成功庆祝（设计稿同款：橙徽章 + 连签 + 彩纸） -->
<view wx:if="{{celebrate}}" class="celebrate" catchtouchmove="noop">
  <view class="confetti">
    <view
      wx:for="{{confetti}}"
      wx:key="index"
      class="confetti-piece {{item.round ? 'confetti-round' : ''}}"
      style="left: {{item.left}}%; background: {{item.color}}; animation-delay: {{item.delay}}ms; animation-duration: {{item.dur}}ms;"
    ></view>
  </view>
  <view class="celebrate-card">
    <view class="celebrate-badge">
      <image class="celebrate-check" src="{{icons.checkWhite}}" mode="aspectFit" />
    </view>
    <text class="celebrate-title">打卡成功</text>
    <text class="celebrate-streak">已连续打卡 {{celebrateStreak}} 天</text>
    <text class="celebrate-sub">{{celebrateSub}}</text>
  </view>
</view>

<!-- 评分弹窗 -->
<view wx:if="{{rateOpen}}" class="rate-mask" bindtap="closeRate">
  <view class="rate-sheet" catchtap="noop">
    <view class="rate-title">给「{{shop.name}}」评分</view>
    <text wx:if="{{myRating}}" class="rate-hint">你当前评分 {{myRating}} 星，点击星星可修改</text>
    <view class="rate-stars-row">
      <image
        wx:for="{{[1,2,3,4,5]}}"
        wx:key="*this"
        class="rate-star {{rateStars >= item ? 'rate-star-on' : ''}}"
        src="{{rateStars >= item ? icons.starOrange : icons.starGray}}"
        mode="aspectFit"
        data-star="{{item}}"
        bindtap="pickStar"
      />
    </view>
    <text class="rate-desc">{{rateStars ? rateStars + ' 星' : '点击评分'}}</text>
    <view class="rate-btn-submit {{rateSubmitting ? 'rate-btn-busy' : ''}}" bindtap="submitRate">
      {{rateSubmitting ? '提交中...' : '提交评分'}}
    </view>
  </view>
</view>
