.page {
  min-height: 100vh;
  background: #111114;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 照片轮播 */
.photos {
  width: 100%;
  height: 460rpx;
}

.photo {
  width: 100%;
  height: 100%;
}

/* 信息区 */
.info {
  padding: 32rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* category 徽标（板店/俱乐部/培训机构）：白描边中性样式，与列表卡片同体系 */
.cat-tag {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
}

/* 合作/上课场地行（org↔venue 关联） */
.partner-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: #1E1E23;
}

.partner-hover {
  background: #26262C;
}

.partner-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.partner-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.partner-addr {
  font-size: 22rpx;
  color: #8C8C94;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.partner-arrow {
  flex-shrink: 0;
  color: #8C8C94;
  font-size: 32rpx;
}

.status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.status-open {
  color: #00D4AA;
  background: rgba(0, 212, 170, 0.12);
}

.status-closed {
  color: #8C8C94;
  background: #26262C;
}

.hot-tag {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.16);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.block {
  margin-top: 32rpx;
}

.block-title {
  display: block;
  font-size: 26rpx;
  color: #8C8C94;
  margin-bottom: 12rpx;
}

.block-text {
  font-size: 30rpx;
  color: #FFFFFF;
  line-height: 1.6;
}

.svc-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.svc {
  font-size: 24rpx;
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.16);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

/* ===== 打卡动态 ===== */
.feed {
  margin: 8rpx 32rpx 0;
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 28rpx;
}

.feed-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.feed-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.feed-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #8C8C94;
}

.feed-more-arrow {
  font-size: 30rpx;
  line-height: 1;
}

.fcard {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #26262C;
}

.fhead {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.favatar-img {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.favatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fuser {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.fname {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.ftime {
  font-size: 22rpx;
  color: #6E6E76;
}

.fnote {
  display: block;
  margin-top: 14rpx;
  font-size: 27rpx;
  color: #D9D9DE;
  line-height: 1.6;
  word-break: break-all;
}

.fphotos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

/* 图片布局与发现页动态流同款：1 张 320rpx 方图；2 张对半分；3 张起 3 列方格铺满 */
.fphotos .photo-cell {
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1;
  border-radius: 10rpx;
  overflow: hidden;
  background: #17171B;
}

.fphotos.photos-1 .photo-cell {
  width: 320rpx;
}

.fphotos.photos-2 .photo-cell {
  width: calc((100% - 12rpx) / 2);
}

.fphoto {
  width: 100%;
  height: 100%;
}

.fempty {
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6E6E76;
}

/* ===== 底部操作 ===== */
.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(17, 17, 20, 0.96);
  border-top: 1rpx solid #26262C;
}

.act {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 8rpx 0;
  margin: 0;
  line-height: 2.1;
  text-align: center;
}

.act::after {
  border: none;
}

.act-checkin {
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  flex: 1.3;
}

.act-done {
  background: #26262C;
  color: #8C8C94;
  flex: 1.3;
}

.act-call {
  background: #26262C;
  color: #00D4AA;
}

.act-nav {
  background: transparent;
  color: #D9D9DE;
  border: 2rpx solid #2A2A30;
}

/* ===== 打卡弹窗（居中卡片式，避开自定义 tabBar） ===== */
.mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.6);
}

.sheet {
  width: 100%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: #1B1B20;
  border-radius: 20rpx;
  padding: 40rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
}

.sheet-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 32rpx;
}

.f-row {
  margin-bottom: 24rpx;
}

.f-label {
  display: block;
  font-size: 26rpx;
  color: #8C8C94;
  margin-bottom: 12rpx;
}

.f-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  background: #17171B;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #D9D9DE;
}

.ph {
  color: #6E6E76;
}

.pgrid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.ptile {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.ptile-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.ptile-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.padd {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #17171B;
  border: 2rpx dashed #3A3A42;
  color: #8C8C94;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.f-btn {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 8rpx 0;
}

.f-btn::after {
  border: none;
}

.f-btn-loading {
  opacity: 0.6;
}

.f-cancel {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8C8C94;
}

/* 轮播图片渐显 */
.photo-fade {
  animation: photo-in 0.5s ease backwards;
}

@keyframes photo-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ===== 打卡庆祝层（设计稿同款：彩纸 + 橙徽章 + 连签提示） ===== */
.celebrate {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
  animation: cel-fade 0.25s ease;
}

@keyframes cel-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 彩纸层 */
.confetti {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.confetti-piece {
  position: absolute;
  top: -40rpx;
  width: 16rpx;
  height: 24rpx;
  border-radius: 4rpx;
  opacity: 0;
  animation: confetti-fall linear both;
}

.confetti-round {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

@keyframes confetti-fall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  85% { opacity: 1; }
  100% { transform: translateY(85vh) rotate(540deg); opacity: 0; }
}

.celebrate-card {
  position: relative;
  width: 480rpx;
  background: #1E1E23;
  border: 1rpx solid rgba(255, 90, 54, 0.3);
  border-radius: 32rpx;
  padding: 56rpx 44rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  animation: cel-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 0 120rpx rgba(255, 90, 54, 0.25);
}

@keyframes cel-pop {
  from { opacity: 0; transform: scale(0.6); }
  to { opacity: 1; transform: scale(1); }
}

/* 橙色圆形徽章 + 白色对勾（外圈深橙描边环，设计稿同款） */
.celebrate-badge {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 90, 54, 0.35);
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(255, 90, 54, 0.4);
}

.celebrate-check {
  width: 52rpx;
  height: 52rpx;
}

/* 内容左对齐（设计稿同款） */
.celebrate-title {
  margin-top: 16rpx;
  align-self: flex-start;
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.celebrate-streak {
  align-self: flex-start;
  font-size: 28rpx;
  font-weight: 600;
  color: #00D4AA;
}

.celebrate-sub {
  align-self: flex-start;
  font-size: 24rpx;
  color: #8C8C94;
  line-height: 1.5;
  text-align: left;
}

/* ===== 聚合评分行（可点击评分） ===== */
.rate-hover {
  opacity: 0.75;
}

.rating-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.rating-line .stars {
  position: relative;
  width: 170rpx;
  height: 30rpx;
}

.rating-line .stars-bg {
  display: flex;
  gap: 4rpx;
}

.rating-line .stars-fg {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  overflow: hidden;
  display: flex;
  gap: 4rpx;
  white-space: nowrap;
}

.rating-line .rstar {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.rating-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF5A36;
}

/* ===== 评分弹窗 ===== */
.rate-mask {
  position: fixed;
  inset: 0;
  z-index: 70;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.6);
}

.rate-sheet {
  width: 100%;
  max-width: 600rpx;
  background: #1B1B20;
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  text-align: center;
}

.rate-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.rate-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8C8C94;
}

.rate-stars-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 40rpx 0 16rpx;
}

.rate-star {
  width: 80rpx;
  height: 80rpx;
  transition: transform 0.15s ease;
}

.rate-star-on {
  transform: scale(1.1);
}

.rate-desc {
  display: block;
  font-size: 26rpx;
  color: #A6A6AD;
  min-height: 40rpx;
}

.rate-btn-submit {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 16rpx 0;
}

.rate-btn-busy {
  opacity: 0.6;
}
