.page {
  min-height: 100vh;
  background: #111114;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 头部资料卡 ===== */
.hero {
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 头像 140rpx + 橙色细环，呼应品牌色 */
.hero-avatar-img,
.hero-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 90, 54, 0.35);
  flex-shrink: 0;
}

.hero-avatar {
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 56rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.hero-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-meta {
  font-size: 24rpx;
  color: #A6A6AD;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

/* 擅长标签：橙色描边 chip（与品牌色呼应，不做实底） */
.hero-tag {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 90, 54, 0.45);
  background: rgba(255, 90, 54, 0.12);
  color: #FF8A6E;
  font-size: 22rpx;
}

/* ===== 数据概览 ×3 ===== */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 28rpx 12rpx;
}

.stat-icon {
  width: 44rpx;
  height: 44rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.stat-label {
  font-size: 22rpx;
  color: #8C8C94;
}

/* ===== 区块 ===== */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

/* ===== 常去场地（横滑卡片） ===== */
.places {
  white-space: nowrap;
  width: 100%;
}

.place-card {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  width: 240rpx;
  margin-right: 16rpx;
  background: #1E1E23;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  white-space: normal;
}

.place-card-hover {
  background: #26262C;
}

/* 类型小标：场地橙 / 店铺灰（与列表页徽标同语义） */
.place-kind {
  font-size: 20rpx;
  color: #FF8A6E;
}

.place-kind-shop {
  color: #8C8C94;
}

.place-name {
  width: 100%;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  min-height: 72rpx;
}

.place-count {
  font-size: 22rpx;
  color: #8C8C94;
}

/* ===== 动态卡片（复用打卡流卡片结构） ===== */
.card {
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.card-in {
  animation: card-in-anim 0.35s ease backwards;
}

@keyframes card-in-anim {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.card-place {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.card-kind {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #8C8C94;
}

/* 场地名可点（橙色链接，与发现页场地链接同语义） */
.card-venue {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #FF8A6E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #6E6E76;
}

.note {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  color: #D9D9DE;
  line-height: 1.6;
  word-break: break-all;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

/* 图片布局与发现页同款：1 张 320rpx 方图；2 张对半分；3 张起 3 列方格铺满 */
.photos .photo-cell {
  position: relative;
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: #17171B;
}

.photos.photos-1 .photo-cell {
  width: 320rpx;
}

.photos.photos-2 .photo-cell {
  width: calc((100% - 12rpx) / 2);
}

.photo,
.card-video {
  width: 100%;
  height: 100%;
}

/* 视频封面播放按钮（微博式：点击进混合查看器播放） */
.video-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
  width: 0;
  height: 0;
  border-left: 26rpx solid rgba(255, 255, 255, 0.92);
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  filter: drop-shadow(0 0 6rpx rgba(0, 0, 0, 0.4));
}

.video-uploading {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  z-index: 2;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 18rpx;
}

/* 点赞 / 评论（与发现页动作行同款） */
.actions {
  display: flex;
  gap: 48rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #26262C;
}

.action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #8C8C94;
}

.action-liked {
  color: #FF8A6E;
}

.action-icon {
  width: 32rpx;
  height: 32rpx;
}

.more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #6E6E76;
}

/* 空态 */
.empty {
  display: flex;
  justify-content: center;
  padding: 80rpx 0 40rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #8C8C94;
}
