.page {
  min-height: 100vh;
  background: #F7F7F8;
  padding: 24rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 状态区（校验中 / 无权限） ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 160rpx 40rpx 0;
  color: #8C8C8C;
  font-size: 28rpx;
}

.state-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.4;
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1E;
}

.state-desc {
  font-size: 26rpx;
  text-align: center;
}

.state-openid {
  margin-top: 8rpx;
  padding: 16rpx 28rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #FF5A36;
  word-break: break-all;
  max-width: 100%;
}

/* ===== 实体切换 ===== */
.seg {
  display: flex;
  background: #EBEBEE;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6B6B70;
  border-radius: 12rpx;
}

.seg-active {
  background: #FFFFFF;
  color: #1A1A1E;
  font-weight: 600;
}

.meta-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #8C8C8C;
  margin-bottom: 16rpx;
}

.city-filter {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: #FFFFFF;
  border-radius: 10rpx;
  color: #1A1A1E;
  font-size: 26rpx;
}

.meta-count {
  font-size: 24rpx;
  color: #8C8C8C;
}

/* ===== 列表行 ===== */
.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.row-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.row-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F0F0F2;
  color: #C0C0C4;
  font-size: 22rpx;
}

.row-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.row-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-sub {
  font-size: 24rpx;
  color: #8C8C8C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-ops {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.op {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  text-align: center;
}

.op-edit {
  color: #2A8CFF;
  background: #EEF5FF;
}

.op-del {
  color: #E5484D;
  background: #FFEEEE;
}

/* ===== 新增按钮 ===== */
.fab {
  margin-top: 32rpx;
  background: #FF5A36;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 48rpx;
}

/* ===== 表单弹窗（固定 80vh：标题固定顶部，字段+保存整体滚动） ===== */
.mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.5);
}

.sheet {
  width: 100%;
  height: 80vh; /* 固定高度（max-height 会让 flex 子项拒绝收缩，滚动失效） */
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 滚动区：flex 子项获得确定高度，scroll-y 生效；min-height:0 是关键 */
.sheet-body {
  flex: 1;
  min-height: 0;
}

/* 滚动条隐藏（enhanced/show-scrollbar 在部分机型失效，CSS 双保险） */
.sheet-body::-webkit-scrollbar,
.sheet-body ::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.sheet-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1E;
  margin-bottom: 32rpx;
}

.f-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.f-label {
  width: 96rpx;
  font-size: 28rpx;
  color: #1A1A1E;
  flex-shrink: 0;
}

.f-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1E;
}

.ph {
  color: #C0C0C4;
}

.f-picker {
  font-size: 28rpx;
  color: #1A1A1E;
  padding: 8rpx 24rpx;
  background: #F7F7F8;
  border-radius: 10rpx;
}

.f-picker-half {
  min-width: 140rpx;
  text-align: center;
}

.f-empty {
  color: #C0C0C4;
}

.f-btn {
  font-size: 26rpx;
  color: #FF5A36;
  padding: 10rpx 24rpx;
  background: #FFF1EE;
  border-radius: 10rpx;
}

.f-btn-ok {
  color: #00B578;
  background: #EAF9F3;
}

.f-dash {
  font-size: 26rpx;
  color: #8C8C8C;
}

.f-tip {
  flex: 1;
  font-size: 22rpx;
  color: #C0C0C4;
}

/* chips 多选 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  flex: 1;
}

.chip {
  font-size: 24rpx;
  color: #6B6B70;
  background: #F0F0F2;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}

.chip-on {
  color: #FFFFFF;
  background: #FF5A36;
}

/* 照片多选 */
.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.photo-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #F0F0F2;
  color: #8C8C8C;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-uploading {
  opacity: 0.5;
}

/* 保存按钮（滚动内容末尾，热门之后） */
.f-save {
  margin-top: 40rpx;
  background: #FF5A36;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 8rpx 0;
}

.f-save::after {
  border: none;
}

.f-saving {
  opacity: 0.6;
}

/* ===== 你提我改：建议卡片 ===== */
.fb-card {
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.fb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fb-type {
  font-size: 22rpx;
  color: #FF5A36;
  background: #FFF2EE;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.fb-status {
  font-size: 22rpx;
  color: #8C8C8C;
}

.fb-status-done {
  color: #00B386;
}

.fb-status-rejected {
  color: #E5484D;
}

/* 报错关联场地（点击回详情页） */
.fb-venue {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2A8CFF;
}

.fb-desc {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #1A1A1E;
  line-height: 1.6;
  word-break: break-all;
}

.fb-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.fb-photo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
}

.fb-reply {
  margin-top: 14rpx;
  background: #F7F7F8;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  color: #4D4D4D;
  line-height: 1.6;
  word-break: break-all;
}

.fb-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.fb-foot-user {
  font-size: 22rpx;
  color: #C0C0C4;
}

/* 处理弹窗内引用原建议 */
.fb-quote {
  background: #F7F7F8;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #6B6B70;
  line-height: 1.6;
  margin-bottom: 8rpx;
  word-break: break-all;
}

/* 回复 textarea */
.f-row-top {
  align-items: flex-start;
}

.f-textarea {
  flex: 1;
  width: 100%;
  min-height: 150rpx;
  font-size: 28rpx;
  color: #1A1A1E;
  line-height: 1.6;
}

/* 已驳回 chip 激活态（红色） */
.chip-reject-on {
  color: #FFFFFF;
  background: #E5484D;
}
