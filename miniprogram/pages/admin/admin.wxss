.page {
  min-height: 100vh;
  background: #111114;
  padding: 24rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 状态区（校验中 / 无权限） ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 160rpx 40rpx 0;
  color: #8C8C94;
  font-size: 28rpx;
}

.state-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.4;
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.state-desc {
  font-size: 26rpx;
  text-align: center;
}

.state-openid {
  margin-top: 8rpx;
  padding: 16rpx 28rpx;
  background: #1E1E23;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #FF8A6E;
  word-break: break-all;
  max-width: 100%;
}

/* ===== 实体切换（设计稿：靠左自适应胶囊组） ===== */
.seg {
  display: flex;
  justify-content: flex-start;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.seg-item {
  padding: 14rpx 36rpx;
  font-size: 28rpx;
  color: #8C8C94;
  background: #1E1E23;
  border-radius: 999rpx;
  white-space: nowrap;
}

.seg-active {
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-weight: 600;
}

.meta-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #8C8C94;
  margin-bottom: 16rpx;
}

/* 城市筛选 chips（全部 + 当前城市，与首页同源 store） */
.city-chips {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.city-filter {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: #1E1E23;
  border-radius: 10rpx;
  color: #FFFFFF;
  font-size: 26rpx;
}

/* 激活态：橙色（当前生效的筛选维度） */
.city-filter-on {
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.16);
}

.meta-count {
  font-size: 24rpx;
  color: #8C8C94;
}

/* ===== 列表行 ===== */
.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #1E1E23;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.row-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.row-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #17171B;
  color: #6E6E76;
  font-size: 22rpx;
}

.row-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.row-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-sub {
  font-size: 24rpx;
  color: #8C8C94;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-ops {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.op {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  text-align: center;
}

/* 编辑：橙色实心（设计稿）；删除：红色描边 */
.op-edit {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
}

.op-del {
  color: #FF3B30;
  background: transparent;
  border: 2rpx solid rgba(255, 59, 48, 0.5);
  box-sizing: border-box;
}

/* 上下架：中性灰描边（区别于编辑/删除的高危操作） */
.op-status {
  color: #A6A6AD;
  background: transparent;
  border: 2rpx solid #3A3A42;
  box-sizing: border-box;
}

/* 已下架行弱化展示 */
.row-off {
  opacity: 0.55;
}

/* ===== 新增按钮（右下角小号圆形 ＋：拇指热区 + 添加心智 + 对角平衡） ===== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 20;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(255, 90, 54, 0.35);
}

.fab:active {
  opacity: 0.85;
}

/* ===== 表单弹窗（固定 80vh：标题固定顶部，字段+保存整体滚动） ===== */
.mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.6);
}

.sheet {
  width: 100%;
  height: 80vh; /* 固定高度（max-height 会让 flex 子项拒绝收缩，滚动失效） */
  background: #1B1B20;
  border-radius: 20rpx;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 滚动区：flex 子项获得确定高度，scroll-y 生效；min-height:0 是关键 */
.sheet-body {
  flex: 1;
  min-height: 0;
}

/* 滚动条隐藏（enhanced/show-scrollbar 在部分机型失效，CSS 双保险） */
.sheet-body::-webkit-scrollbar,
.sheet-body ::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

/* 标题行：左对齐 + 右侧关闭（设计稿同款） */
.sheet-head {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.sheet-title {
  flex: 1;
  text-align: left;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #26262C;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 30rpx;
  color: #8C8C94;
  line-height: 1;
}

.f-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #26262C;
}

.f-label {
  width: 96rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

/* 同行第二个字段标签（城市+类型同行布局） */
.f-label-2 {
  margin-left: 16rpx;
}

/* 字段补充说明（如：最多 6 张） */
.f-sub {
  width: 100%;
  font-size: 22rpx;
  color: #6E6E76;
}

.f-input {
  flex: 1;
  font-size: 28rpx;
  color: #D9D9DE;
}

.ph {
  color: #6E6E76;
}

.f-picker {
  font-size: 28rpx;
  color: #FF8A6E;
  padding: 8rpx 24rpx;
  background: rgba(255, 90, 54, 0.16);
  border-radius: 10rpx;
}

.f-picker-half {
  min-width: 140rpx;
  text-align: center;
}

.f-empty {
  color: #6E6E76;
}

.f-btn {
  font-size: 26rpx;
  color: #FF8A6E;
  padding: 10rpx 24rpx;
  background: rgba(255, 90, 54, 0.16);
  border-radius: 10rpx;
}

.f-btn-ok {
  color: #00D4AA;
  background: rgba(0, 212, 170, 0.12);
}

.f-dash {
  font-size: 26rpx;
  color: #8C8C94;
}

.f-tip {
  flex: 1;
  font-size: 22rpx;
  color: #6E6E76;
}

/* chips 多选 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  flex: 1;
}

.chip {
  font-size: 24rpx;
  color: #A6A6AD;
  background: #26262C;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}

.chip-on {
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.16);
}

/* 照片多选 */
.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.photo-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #17171B;
  border: 2rpx dashed #3A3A42;
  color: #8C8C94;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-uploading {
  opacity: 0.5;
}

/* 保存按钮（滚动内容末尾，热门之后） */
.f-save {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 8rpx 0;
}

.f-save::after {
  border: none;
}

.f-saving {
  opacity: 0.6;
}

/* ===== 你提我改：建议卡片 ===== */
.fb-card {
  display: flex;
  flex-direction: column;
  background: #1E1E23;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.fb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fb-type {
  font-size: 22rpx;
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.16);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.fb-status {
  font-size: 22rpx;
  color: #8C8C94;
}

.fb-status-done {
  color: #00D4AA;
}

.fb-status-rejected {
  color: #FF3B30;
}

/* 报错关联场地（点击回详情页） */
.fb-venue {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #FF8A6E;
}

.fb-desc {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #D9D9DE;
  line-height: 1.6;
  word-break: break-all;
}

.fb-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.fb-photo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
}

.fb-reply {
  margin-top: 14rpx;
  background: #17171B;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  color: #A6A6AD;
  line-height: 1.6;
  word-break: break-all;
}

.fb-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.fb-foot-user {
  font-size: 22rpx;
  color: #6E6E76;
}

/* 处理弹窗内引用原建议 */
.fb-quote {
  background: #17171B;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #A6A6AD;
  line-height: 1.6;
  margin-bottom: 8rpx;
  word-break: break-all;
}

/* 回复 textarea */
.f-row-top {
  align-items: flex-start;
}

.f-textarea {
  flex: 1;
  width: 100%;
  min-height: 150rpx;
  font-size: 28rpx;
  color: #D9D9DE;
  line-height: 1.6;
}

/* 已驳回 chip 激活态（红色） */
.chip-reject-on {
  color: #FFFFFF;
  background: #E5484D;
}
