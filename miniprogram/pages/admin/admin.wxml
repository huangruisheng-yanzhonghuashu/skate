<!-- WXS：WXML 表达式不支持方法调用（indexOf/toFixed 均静默失败），必须在 wxs 中处理 -->
<wxs module="util">
module.exports = {
  has: function (arr, item) {
    if (!arr) return false
    return arr.indexOf(item) >= 0
  },
  coord: function (lat, lng) {
    if (lat === null || lat === undefined || lng === undefined) return ''
    return lat.toFixed(4) + ',' + lng.toFixed(4)
  },
  join: function (arr, sep) {
    if (!arr) return ''
    return arr.join(sep)
  },
}
</wxs>
<view class="page">
  <!-- 权限校验中 -->
  <view wx:if="{{isAdmin === null}}" class="state">
    <text>正在校验管理员身份...</text>
  </view>

  <!-- 无权限 -->
  <view wx:elif="{{isAdmin === false}}" class="state">
    <image class="state-icon" src="/images/venue-fog.png" mode="aspectFit" />
    <text class="state-title">无管理员权限</text>
    <text class="state-desc">将你的 openid 加入控制台 config 集合 admins 文档后重试</text>
    <view wx:if="{{myOpenid}}" class="state-openid" bindtap="copyOpenid">点击复制 openid：{{myOpenid}}</view>
    <text wx:else class="state-desc">若始终无法获取 openid，请先部署云函数：tcb fn deploy manageVenue --force</text>
  </view>

  <!-- 管理界面 -->
  <block wx:else>
    <!-- 实体切换（橙色胶囊 tab；超出一屏横向滚动，隐藏滚动条） -->
    <scroll-view class="seg-wrap" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="seg">
        <view class="seg-item {{entity === 'venue' ? 'seg-active' : ''}}" data-entity="venue" bindtap="switchEntity">场地</view>
        <view class="seg-item {{entity === 'shop' ? 'seg-active' : ''}}" data-entity="shop" bindtap="switchEntity">门店与俱乐部</view>
        <view class="seg-item {{entity === 'feedback' ? 'seg-active' : ''}}" data-entity="feedback" bindtap="switchEntity">建议</view>
        <view class="seg-item {{entity === 'report' ? 'seg-active' : ''}}" data-entity="report" bindtap="switchEntity">报错</view>
        <view class="seg-item {{entity === 'submission' ? 'seg-active' : ''}}" data-entity="submission" bindtap="switchEntity">推荐审核</view>
      </view>
    </scroll-view>

    <!-- 城市筛选 + 计数（建议 tab 无城市维度，仅显示计数）
         城市与首页同源（store 全局城市），默认取首页选中城市，点城市跳城市选择页（与首页一致） -->
    <view class="meta-line">
      <view wx:if="{{entity === 'venue' || entity === 'shop'}}" class="city-chips">
        <view class="city-filter {{cityFilter === '全部' ? 'city-filter-on' : ''}}" bindtap="filterAllCity">全部</view>
        <view class="city-filter {{cityFilter !== '全部' ? 'city-filter-on' : ''}}" bindtap="goCityPicker">
          {{cityFilter === '全部' ? '选择城市' : cityFilter}} ▾
        </view>
      </view>
      <text wx:else>按提交时间倒序</text>
      <text class="meta-count">共 {{entity === 'venue' ? viewVenues.length : entity === 'shop' ? viewShops.length : entity === 'feedback' ? feedbacks.length : entity === 'submission' ? submissions.length : reports.length}} 条</text>
    </view>

    <!-- 列表 -->
    <block wx:if="{{entity === 'venue'}}">
      <view wx:for="{{viewVenues}}" wx:key="id" class="row {{item.status === 'off' ? 'row-off' : ''}}">
        <view class="row-main">
          <image wx:if="{{item.photos.length}}" class="row-img" src="{{item.photos[0]}}" mode="aspectFill" />
          <view wx:else class="row-img row-img-empty">无图</view>
          <view class="row-info">
            <text class="row-name">{{item.name}}</text>
            <text class="row-sub">{{item.category}} · {{item.shortAddr || item.address}}</text>
            <text class="row-sub">{{item.city}} · {{item.hot ? '热门' : '常规'}}{{item.status === 'off' ? ' · 已下架' : ''}}</text>
          </view>
        </view>
        <view class="row-ops">
          <view class="op op-status" data-kind="venue" data-id="{{item.id}}" bindtap="toggleStatus">{{item.status === 'off' ? '上架' : '下架'}}</view>
          <view class="op op-edit" data-kind="venue" data-id="{{item.id}}" bindtap="openEdit">编辑</view>
          <view class="op op-del" data-kind="venue" data-id="{{item.id}}" bindtap="removeItem">删除</view>
        </view>
      </view>
      <view wx:if="{{!viewVenues.length}}" class="state"><text>{{cityFilter === '全部' ? '暂无场地，点下方按钮新增' : cityFilter + '暂无场地'}}</text></view>
    </block>

    <block wx:elif="{{entity === 'shop'}}">
      <view wx:for="{{viewShops}}" wx:key="id" class="row {{item.status === 'off' ? 'row-off' : ''}}">
        <view class="row-main">
          <image wx:if="{{item.photos.length}}" class="row-img" src="{{item.photos[0]}}" mode="aspectFill" />
          <view wx:else class="row-img row-img-empty">无图</view>
          <view class="row-info">
            <text class="row-name">{{item.name}}</text>
            <text class="row-sub">{{util.join(item.services, ' / ')}}</text>
            <text class="row-sub">{{item.city}} · {{item.hours.open}}-{{item.hours.close}}{{item.phone ? ' · ' + item.phone : ''}}{{item.status === 'off' ? ' · 已下架' : ''}}</text>
          </view>
        </view>
        <view class="row-ops">
          <view class="op op-status" data-kind="shop" data-id="{{item.id}}" bindtap="toggleStatus">{{item.status === 'off' ? '上架' : '下架'}}</view>
          <view class="op op-edit" data-kind="shop" data-id="{{item.id}}" bindtap="openEdit">编辑</view>
          <view class="op op-del" data-kind="shop" data-id="{{item.id}}" bindtap="removeItem">删除</view>
        </view>
      </view>
      <view wx:if="{{!viewShops.length}}" class="state"><text>{{cityFilter === '全部' ? '暂无门店与俱乐部，点下方按钮新增' : cityFilter + '暂无门店与俱乐部'}}</text></view>
    </block>

    <!-- 建议处理（你提我改） -->
    <block wx:elif="{{entity === 'feedback'}}">
      <view wx:if="{{feedbackLoading}}" class="state"><text>加载中...</text></view>
      <block wx:elif="{{feedbacks.length}}">
        <view wx:for="{{feedbacks}}" wx:key="_id" class="fb-card">
          <view class="fb-head">
            <text class="fb-type">{{item.type}}</text>
            <text class="fb-status fb-status-{{item.status}}">{{item.statusText}}</text>
          </view>
          <text class="fb-desc">{{item.desc}}</text>
          <view wx:if="{{item.photos.length}}" class="fb-photos">
            <image
              wx:for="{{item.photos}}"
              wx:for-item="p"
              wx:key="*this"
              class="fb-photo"
              src="{{p}}"
              mode="aspectFill"
              data-photos="{{item.photos}}"
              data-src="{{p}}"
              bindtap="previewFbPhoto"
            />
          </view>
          <view wx:if="{{item.reply}}" class="fb-reply">已回复：{{item.reply}}</view>
          <view class="fb-foot">
            <text class="fb-foot-user">{{item.userName}} · {{item.timeText}}</text>
            <view wx:if="{{item.status === 'pending'}}" class="op op-edit" data-source="feedback" data-id="{{item._id}}" bindtap="openReply">处理</view>
          </view>
        </view>
      </block>
      <view wx:else class="state"><text>暂无用户建议</text></view>
    </block>

    <!-- 场地报错处理 -->
    <block wx:elif="{{entity === 'report'}}">
      <view wx:if="{{reportsLoading}}" class="state"><text>加载中...</text></view>
      <block wx:elif="{{reports.length}}">
        <view wx:for="{{reports}}" wx:key="_id" class="fb-card">
          <view class="fb-head">
            <text class="fb-type">{{item.type}}</text>
            <text class="fb-status fb-status-{{item.status}}">{{item.statusText}}</text>
          </view>
          <view class="fb-venue" data-id="{{item.venueId}}" bindtap="goVenueDetail">{{item.venueName}}</view>
          <text class="fb-desc">{{item.desc}}</text>
          <view wx:if="{{item.photos.length}}" class="fb-photos">
            <image
              wx:for="{{item.photos}}"
              wx:for-item="p"
              wx:key="*this"
              class="fb-photo"
              src="{{p}}"
              mode="aspectFill"
              data-photos="{{item.photos}}"
              data-src="{{p}}"
              bindtap="previewFbPhoto"
            />
          </view>
          <view wx:if="{{item.reply}}" class="fb-reply">已回复：{{item.reply}}</view>
          <view class="fb-foot">
            <text class="fb-foot-user">{{item.timeText}}</text>
            <view wx:if="{{item.status === 'pending'}}" class="op op-edit" data-source="report" data-id="{{item._id}}" bindtap="openReply">处理</view>
          </view>
        </view>
      </block>
      <view wx:else class="state"><text>暂无场地报错</text></view>
    </block>

    <!-- 推荐审核（滑手提交的场地、门店与俱乐部：入库=预填表单核对后上架，驳回=填理由） -->
    <block wx:elif="{{entity === 'submission'}}">
      <view wx:if="{{submissionsLoading}}" class="state"><text>加载中...</text></view>
      <block wx:elif="{{submissions.length}}">
        <view wx:for="{{submissions}}" wx:key="_id" class="fb-card">
          <view class="fb-head">
            <text class="fb-type">{{item.kindText}} · {{item.name}}</text>
            <text class="fb-status fb-status-{{item.status}}">{{item.statusText}}</text>
          </view>
          <text class="fb-sub">{{item.category}} · {{item.city}}{{item.address ? ' · ' + item.address : ''}}</text>
          <view wx:if="{{item.note}}" class="fb-quote">{{item.note}}</view>
          <view wx:if="{{item.photos.length}}" class="fb-photos">
            <image
              wx:for="{{item.photos}}"
              wx:for-item="p"
              wx:key="*this"
              class="fb-photo"
              src="{{p}}"
              mode="aspectFill"
              data-photos="{{item.photos}}"
              data-src="{{p}}"
              bindtap="previewFbPhoto"
            />
          </view>
          <view wx:if="{{item.reply}}" class="fb-reply">已回复：{{item.reply}}</view>
          <view class="fb-foot">
            <text class="fb-foot-user">{{item.userName}} · {{item.timeText}}</text>
            <view wx:if="{{item.status === 'pending'}}" class="fb-foot-ops">
              <view class="op op-edit" data-id="{{item._id}}" bindtap="ingest">入库</view>
              <view class="op op-del" data-source="submission" data-id="{{item._id}}" bindtap="openReply">驳回</view>
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="state"><text>暂无用户推荐</text></view>
    </block>

    <!-- 新增按钮（仅场地/门店 tab 显示；左下角小号 ＋，能表达添加即可） -->
    <view wx:if="{{(entity === 'venue' || entity === 'shop') && !formOpen}}" class="fab" bindtap="openCreate" aria-role="button" aria-label="新增">＋</view>
  </block>

  <!-- 编辑表单弹窗（居中卡片；标题左对齐 + 关闭，设计稿同款；catchtouchmove 防滚动穿透） -->
  <view wx:if="{{formOpen}}" class="mask" catchtouchmove="noop" bindtap="closeForm">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">{{pendingSubmissionId ? '入库推荐' : (form.id ? '编辑' : '新增') + (form.kind === 'venue' ? '场地' : '门店与俱乐部')}}</view>
        <view class="sheet-close" catchtap="closeForm" aria-role="button" aria-label="关闭">×</view>
      </view>
      <scroll-view class="sheet-body" scroll-y enhanced show-scrollbar="{{false}}">

      <view class="f-row">
        <text class="f-label">名称</text>
        <input class="f-input" value="{{form.name}}" maxlength="30" placeholder="必填，≤30字" placeholder-class="ph" bindinput="formName" />
      </view>

      <!-- 城市 / 类型各占一行 -->
      <view class="f-row">
        <text class="f-label">城市</text>
        <picker range="{{cities}}" bindchange="formCity">
          <view class="f-picker">{{form.city}}</view>
        </picker>
      </view>

      <view class="f-row">
        <text class="f-label">类型</text>
        <block wx:if="{{form.kind === 'venue'}}">
          <picker range="{{categories}}" bindchange="formCategory">
            <view class="f-picker {{form.category ? '' : 'f-empty'}}">{{form.category || '选择类型'}}</view>
          </picker>
        </block>
        <block wx:else>
          <picker range="{{orgCategories}}" bindchange="formOrgCategory">
            <view class="f-picker {{form.category ? '' : 'f-empty'}}">{{form.category || '选择类型'}}</view>
          </picker>
        </block>
      </view>

      <view wx:if="{{form.kind === 'shop'}}" class="f-row">
        <text class="f-label">服务</text>
        <view class="chips">
          <view
            wx:for="{{services}}"
            wx:key="*this"
            class="chip {{util.has(form.services, item) ? 'chip-on' : ''}}"
            data-svc="{{item}}"
            bindtap="toggleService"
          >{{item}}</view>
        </view>
      </view>

      <view wx:if="{{form.kind === 'venue'}}" class="f-row">
        <text class="f-label">标签</text>
        <view class="chips">
          <view
            wx:for="{{tagOptions}}"
            wx:key="*this"
            class="chip {{util.has(form.tags, item) ? 'chip-on' : ''}}"
            data-tag="{{item}}"
            bindtap="toggleTag"
          >{{item}}</view>
        </view>
      </view>

      <view class="f-row">
        <text class="f-label">坐标</text>
        <view class="f-btn {{form.latitude !== null ? 'f-btn-ok' : ''}}" bindtap="chooseLocation">
          {{form.latitude !== null ? '已选点 ' + util.coord(form.latitude, form.longitude) : form.address ? '按地址打开地图选点' : '打开地图选点'}}
        </view>
      </view>

      <view class="f-row">
        <text class="f-label">地址</text>
        <input class="f-input" value="{{form.address}}" placeholder="选点后自动填入，可修改" placeholder-class="ph" bindinput="formAddress" />
      </view>

      <view wx:if="{{form.kind === 'shop'}}">
        <view class="f-row">
          <text class="f-label">电话</text>
          <input class="f-input" value="{{form.phone}}" type="number" placeholder="选填，详情页可拨打" placeholder-class="ph" bindinput="formPhone" />
        </view>
        <view class="f-row">
          <text class="f-label">营业</text>
          <picker mode="time" value="{{form.hours.open}}" bindchange="formHoursOpen">
            <view class="f-picker f-picker-half">{{form.hours.open}}</view>
          </picker>
          <text class="f-dash">至</text>
          <picker mode="time" value="{{form.hours.close}}" bindchange="formHoursClose">
            <view class="f-picker f-picker-half">{{form.hours.close}}</view>
          </picker>
        </view>
      </view>

      <view class="f-row">
        <text class="f-label">照片</text>
        <view class="photo-list">
          <view wx:for="{{form.photos}}" wx:key="*this" class="photo-item">
            <image class="photo-img" src="{{item}}" mode="aspectFill" />
            <view class="photo-del" data-index="{{index}}" catchtap="removePhoto">×</view>
          </view>
          <view wx:if="{{form.photos.length < 6}}" class="photo-add {{photosUploading ? 'photo-uploading' : ''}}" bindtap="choosePhotos">
            {{photosUploading ? '上传中' : '＋'}}
          </view>
        </view>
        <text class="f-sub">最多 6 张</text>
      </view>

      <view class="f-row">
        <text class="f-label">热门场地</text>
        <switch checked="{{form.hot}}" bindchange="formHot" color="#FF5A36" />
        <text class="f-tip">地图 pin 高亮、列表优先</text>
      </view>

      <button class="f-save {{saving ? 'f-saving' : ''}}" bindtap="saveForm">{{saving ? '保存中...' : (pendingSubmissionId ? '保存并通过' : '保存')}}</button>
    </scroll-view>
    </view>
  </view>

  <!-- 建议处理弹窗（你提我改） -->
  <view wx:if="{{replyOpen}}" class="mask" catchtouchmove="noop" bindtap="closeReply">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">{{replySource === 'report' ? '处理报错' : replySource === 'submission' ? '驳回推荐' : '处理建议'}}</view>
        <view class="sheet-close" catchtap="closeReply" aria-role="button" aria-label="关闭">×</view>
      </view>
      <scroll-view class="sheet-body" scroll-y enhanced show-scrollbar="{{false}}">

        <view class="fb-quote">{{replyTarget.desc}}</view>

        <view class="f-row" wx:if="{{replySource !== 'submission'}}">
          <text class="f-label">结论</text>
          <view class="chips">
            <view class="chip {{replyForm.status === 'done' ? 'chip-on' : ''}}" data-status="done" bindtap="setReplyStatus">已处理</view>
            <view class="chip {{replyForm.status === 'rejected' ? 'chip-reject-on' : ''}}" data-status="rejected" bindtap="setReplyStatus">已驳回</view>
          </view>
        </view>

        <view class="f-row f-row-top">
          <text class="f-label">回复</text>
          <textarea
            class="f-textarea"
            value="{{replyForm.reply}}"
            maxlength="200"
            placeholder="向用户说明处理结果，用户可见（必填）"
            placeholder-class="ph"
            bindinput="onReplyInput"
          />
        </view>

        <button class="f-save {{replying ? 'f-saving' : ''}}" bindtap="submitReply">{{replying ? '提交中...' : '提交回复'}}</button>
      </scroll-view>
    </view>
  </view>
</view>
