.page {
  min-height: 100vh;
  background: #111114;
  padding: 24rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 顶部说明 ===== */
.hero {
  background: #1E1E23;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.hero-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8C8C94;
  line-height: 1.6;
}

/* ===== 空态/加载 ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 120rpx 40rpx 0;
  color: #8C8C94;
  font-size: 28rpx;
}

.state-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #D9D9DE;
}

.state-desc {
  font-size: 26rpx;
}

/* ===== 报错卡片 ===== */
.rp-card {
  background: #1E1E23;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.rp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 问题类型：白色粗标题（设计稿同款） */
.rp-type {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 状态徽章：待处理橙 / 已处理青 / 已驳回红 */
.rp-status {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.2;
}

.rp-status-pending {
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.14);
}

.rp-status-done {
  color: #00D4AA;
  background: rgba(0, 212, 170, 0.12);
}

.rp-status-rejected {
  color: #FF3B30;
  background: rgba(255, 59, 48, 0.12);
}

/* 场地名行（点击回详情） */
.rp-venue-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.rp-venue {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.rp-venue-link {
  font-size: 24rpx;
  color: #FF8A6E;
}

.rp-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 30rpx;
  color: #A6A6AD;
  line-height: 1.6;
  word-break: break-all;
}

.rp-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.rp-photo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
}

/* 官方回复块 */
.rp-reply {
  margin-top: 20rpx;
  background: #17171B;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.rp-reply-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rp-reply-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #00D4AA;
}

.rp-reply-time {
  font-size: 22rpx;
  color: #6E6E76;
}

.rp-reply-text {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #A6A6AD;
  line-height: 1.6;
  word-break: break-all;
}

.rp-time {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #6E6E76;
}
