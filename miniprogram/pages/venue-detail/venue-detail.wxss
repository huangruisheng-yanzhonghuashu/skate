.page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ===== 轮播 ===== */
.carousel {
  position: relative;
  width: 100%;
  height: 50vh;
  min-height: 600rpx;
  background: #1A1A1E;
}

.swiper {
  width: 100%;
  height: 100%;
}

.photo {
  width: 100%;
  height: 100%;
}

.indicator {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
}

/* 头图底部渐变（标题/评分叠层衬底） */
.hero-grad {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 240rpx;
  background: linear-gradient(180deg, rgba(17, 17, 20, 0) 0%, rgba(17, 17, 20, 0.88) 100%);
  pointer-events: none;
}

/* 头图叠层：名称 + 聚合评分（设计稿：白名称 + ★4.8 236 人评价） */
.hero-info {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  z-index: 2;
}

.hero-name {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.25;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.5);
}

.hero-rating {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

/* 五颗星双层裁剪（与店铺详情同款尺寸：灰星底层 + 橙星按比例顶层） */
.hero-rating .stars {
  position: relative;
  width: 170rpx;
  height: 30rpx;
}

.hero-rating .stars-bg {
  display: flex;
  gap: 4rpx;
}

.hero-rating .stars-fg {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  overflow: hidden;
  display: flex;
  gap: 4rpx;
  white-space: nowrap;
}

.hero-star {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.hero-rating-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #FF5A36;
}

/* 返回按钮（自定义导航悬浮，statusBarHeight 由 JS 注入） */
.nav-back {
  position: fixed;
  left: 24rpx;
  z-index: 30;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(17, 17, 20, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-hover {
  background: rgba(17, 17, 20, 0.9);
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ===== 场地信息 ===== */
/* 地址 + 标签 + 快评（设计稿：同一张深色圆角卡片） */
.info {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  background: #1E1E23;
  border-radius: 16rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
}

.rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.rating-star {
  width: 32rpx;
  height: 32rpx;
}

.rating-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF5A36;
}

.address-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.address {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #A6A6AD;
}

.address-pin {
  width: 32rpx;
  height: 32rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
}

/* 距离 pill（真实定位距离，橙底胶囊） */
.dist-pill {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 90, 54, 0.16);
  color: #FF8A6E;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
}

/* 快评已按需求移除（评分入口保留在头图评分区） */

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #26262C;
  color: #A6A6AD;
  font-size: 24rpx;
}

.tag-icon {
  width: 28rpx;
  height: 28rpx;
}

/* ===== 实时状态（绿色调，设计稿同款在场卡） ===== */
.live {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  background: rgba(0, 212, 170, 0.07);
  border: 1rpx solid rgba(0, 212, 170, 0.18);
  border-radius: 16rpx;
}

.live-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.live-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.live-avatars {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.live-avatar-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 3rpx solid #1E1E23;
  box-sizing: border-box;
}

.live-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.live-more {
  background: #26262C;
  color: #A6A6AD;
}

/* ===== 打卡动态 ===== */
.checkins {
  margin: 24rpx 32rpx 0;
  padding-bottom: 32rpx;
}

.checkins-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.checkins-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.checkins-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 28rpx;
  color: #8C8C94;
}

.checkins-more-icon {
  width: 28rpx;
  height: 28rpx;
}

.checkin-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.checkin-card {
  background: #1E1E23;
  border-radius: 16rpx;
  padding: 24rpx;
}

.checkin-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.checkin-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkin-avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.checkin-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

/* 图片布局与发现页动态流同款：1 张 320rpx 方图；2 张对半分；3 张起 3 列方格铺满 */
.checkin-photos .photo-cell {
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: #17171B;
}

.checkin-photos.photos-1 .photo-cell {
  width: 320rpx;
}

.checkin-photos.photos-2 .photo-cell {
  width: calc((100% - 12rpx) / 2);
}

.checkin-photo {
  width: 100%;
  height: 100%;
}

/* 轮播图片渐显（CSS 一次性动画，播完定格，无 JS 依赖） */
.photo-fade {
  animation: photo-in 0.5s ease backwards;
}

@keyframes photo-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ===== 签到庆祝层（彩纸 + 橙色徽章 + 连签提示，设计稿同款） ===== */
.celebrate {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
  animation: cel-fade 0.25s ease;
}

@keyframes cel-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 彩纸层 */
.confetti {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.confetti-piece {
  position: absolute;
  top: -40rpx;
  width: 16rpx;
  height: 24rpx;
  border-radius: 4rpx;
  opacity: 0;
  animation: confetti-fall linear both;
}

.confetti-round {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

@keyframes confetti-fall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  85% { opacity: 1; }
  100% { transform: translateY(85vh) rotate(540deg); opacity: 0; }
}

.celebrate-card {
  position: relative;
  width: 480rpx;
  background: #1E1E23;
  border: 1rpx solid rgba(255, 90, 54, 0.3);
  border-radius: 32rpx;
  padding: 56rpx 44rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  animation: cel-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 0 120rpx rgba(255, 90, 54, 0.25);
}

@keyframes cel-pop {
  from { opacity: 0; transform: scale(0.6); }
  to { opacity: 1; transform: scale(1); }
}

/* 橙色圆形徽章 + 白色对勾（设计稿：外圈深橙描边环） */
.celebrate-badge {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 90, 54, 0.35);
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(255, 90, 54, 0.4);
}

.celebrate-check {
  width: 52rpx;
  height: 52rpx;
}

/* 内容左对齐（设计稿同款） */
.celebrate-title {
  margin-top: 16rpx;
  align-self: flex-start;
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 连续天数（青色强调） */
.celebrate-streak {
  align-self: flex-start;
  font-size: 28rpx;
  font-weight: 600;
  color: #00D4AA;
}

/* 徽章进度提示 */
.celebrate-sub {
  align-self: flex-start;
  font-size: 24rpx;
  color: #8C8C94;
  line-height: 1.5;
  text-align: left;
}

/* ===== 名称旁聚合评分（双层裁剪星级，可点击评分） ===== */
.rate-hover {
  opacity: 0.75;
}

.rating .stars {
  position: relative;
  width: 160rpx;
  height: 28rpx;
}

.rating .stars-bg {
  display: flex;
  gap: 3rpx;
}

.rating .stars-fg {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  overflow: hidden;
  display: flex;
  gap: 3rpx;
  white-space: nowrap;
}

.rating .rating-star {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.rating .rating-count {
  font-size: 22rpx;
  color: #6E6E76;
}

/* ===== 评分弹窗 ===== */
.rate-mask {
  position: fixed;
  inset: 0;
  z-index: 70;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.6);
}

.rate-sheet {
  width: 100%;
  max-width: 600rpx;
  background: #1B1B20;
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  text-align: center;
}

.rate-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.rate-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8C8C94;
}

.rate-stars-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 40rpx 0 16rpx;
}

.rate-star {
  width: 80rpx;
  height: 80rpx;
  transition: transform 0.15s ease;
}

.rate-star-on {
  transform: scale(1.1);
}

.rate-desc {
  display: block;
  font-size: 26rpx;
  color: #A6A6AD;
  min-height: 40rpx;
}

.rate-btn-submit {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 16rpx 0;
}

.rate-btn-busy {
  opacity: 0.6;
}

.checkin-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6E6E76;
}

.checkin-user {
  flex: 1;
  min-width: 0;
}

.checkin-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkin-time {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8C8C94;
}

.checkin-text {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #D9D9DE;
}

/* ===== 底部操作栏（设计稿：两侧窄块 + 中间大橙钮） ===== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(17, 17, 20, 0.96);
  border-top: 1rpx solid #26262C;
  box-sizing: content-box;
}

/* 导航/报错：深色圆角方块 */
.action-side {
  width: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 14rpx 0;
  border-radius: 20rpx;
  background: #1E1E23;
  color: #A6A6AD;
  box-sizing: border-box;
}

.action-hover {
  opacity: 0.75;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
}

.action-label {
  font-size: 22rpx;
  line-height: 1;
}

/* 主操作：橙色渐变大按钮 */
.action-main {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 90, 54, 0.3);
}

.action-main .action-label {
  font-size: 30rpx;
  font-weight: 600;
}

.action-main-hover {
  background: #E63A16;
}

/* 已签到：描边弱化态（避免绿底白字对比度不足） */
.action-done {
  background: transparent;
  border: 2rpx solid rgba(0, 212, 170, 0.5);
  box-shadow: none;
  color: #00D4AA;
  box-sizing: border-box;
}

.action-done .action-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #00D4AA;
}

/* ===== 底部弹层（签到/报错共用：表单类弹窗统一底部 sheet，键盘友好） ===== */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.6);
}

.sheet {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  background: #1B1B20;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: sheet-in 0.28s ease-out both;
}

@keyframes sheet-in {
  from { transform: translateY(80rpx); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}

.anim-sheet-in {
  animation: sheet-in 0.28s ease-out both;
}

/* 顶部拖拽指示条 */
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #3A3A42;
  margin: 8rpx auto 20rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.sheet-head-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 弹窗头图标：实心橙圆 + 白勾（设计稿同款） */
.sheet-head-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sheet-head-badge-icon {
  width: 30rpx;
  height: 30rpx;
}

.report-icon {
  width: 38rpx;
  height: 38rpx;
}

.sheet-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #26262C;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sheet-close-hover {
  background: #3A3A42;
}

.sheet-close-icon {
  width: 26rpx;
  height: 26rpx;
}

/* 当前场地 chip */
.venue-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  align-self: flex-start;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #26262C;
  margin-bottom: 24rpx;
}

.venue-chip-icon {
  width: 26rpx;
  height: 26rpx;
}

.venue-chip-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #FFFFFF;
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 留言行头：label + 计数 */
.note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.note-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.note-count {
  font-size: 24rpx;
  color: #6E6E76;
}

/* 大提交按钮（圆角胶囊 + 图标） */
.sheet-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-btn:active {
  background: #E63A16;
}

.sheet-btn-icon {
  width: 32rpx;
  height: 32rpx;
}

.sheet-btn-loading {
  opacity: 0.7;
}

.sheet-cancel {
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8C8C94;
  padding: 8rpx 0;
}

.field {
  margin-bottom: 28rpx;
}

.field-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #2A2A30;
  background: #17171B;
  font-size: 28rpx;
  color: #D9D9DE;
  box-sizing: border-box;
}

.field-error {
  border-color: #FF3B30;
}

.ph {
  color: #6E6E76;
}

.error-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #FF3B30;
}

/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-tile {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-tile-sm {
  width: 128rpx;
  height: 128rpx;
}

.photo-tile-img {
  width: 100%;
  height: 100%;
}

.photo-tile-del {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-tile-del-icon {
  width: 24rpx;
  height: 24rpx;
}

.photo-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #3A3A42;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #8C8C94;
}

.photo-add:active {
  border-color: #FF5A36;
  color: #FF8A6E;
}

.photo-add-sm {
  width: 128rpx;
  height: 128rpx;
}

.photo-add-icon {
  width: 48rpx;
  height: 48rpx;
}

.photo-add-text {
  font-size: 24rpx;
  padding: 0 8rpx;
  text-align: center;
  line-height: 1.2;
}

.photo-add-sub {
  font-size: 20rpx;
  line-height: 1.2;
}

/* 报错类型 */
.type-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #26262C;
  border: 1rpx solid #2A2A30;
  color: #A6A6AD;
  font-size: 24rpx;
  font-weight: 500;
}

.type-chip-active {
  background: rgba(255, 90, 54, 0.16);
  border-color: rgba(255, 90, 54, 0.4);
  color: #FF8A6E;
}

.report-photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-radius: 16rpx;
  border: 2rpx dashed #3A3A42;
  color: #A6A6AD;
  font-size: 28rpx;
}

.report-photo-add:active {
  background: #1E1E23;
}

.report-photo-add-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 按钮（底部 sheet 的提交/取消样式见 .sheet-btn / .sheet-cancel） */
