.page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ===== 头图区（设计稿 38vh：首屏决策信息全可见） ===== */
.carousel {
  position: relative;
  width: 100%;
  height: 38vh;
  min-height: 480rpx;
  background: #1A1A1E;
}

.swiper {
  width: 100%;
  height: 100%;
}

.photo {
  width: 100%;
  height: 100%;
}

/* 无头图占位（设计稿：渐变底 + 居中图片图标） */
.hero-empty {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, #2A2A31 0%, #1A1A1E 60%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-empty-icon {
  width: 180rpx;
  height: 180rpx;
}

/* 图片计数：右上角胶囊区下方（top 由 JS 按状态栏注入） */
.hero-counter {
  position: absolute;
  right: 32rpx;
  z-index: 2;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 22rpx;
}

/* 头图底部渐变（名称叠层衬底） */
.hero-grad {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 160rpx;
  background: linear-gradient(180deg, rgba(17, 17, 20, 0) 0%, rgba(17, 17, 20, 0.85) 100%);
  pointer-events: none;
}

/* 头图叠层：名称 + 热门贴纸 */
.hero-info {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  z-index: 2;
}

.hero-name-row {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
}

.hero-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.25;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.5);
}

/* 热门贴纸（橙色小方块，-6° 微倾斜） */
.hot-sticker {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  background: #FF5A36;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 8rpx;
  transform: rotate(-6deg);
  margin-bottom: 8rpx;
}

/* ===== 信息卡 ===== */
.info {
  position: relative;
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  background: #1E1E23;
  border-radius: 16rpx;
}

/* 返回按钮（自定义导航悬浮，statusBarHeight 由 JS 注入；设计稿毛玻璃底） */
.nav-back {
  position: fixed;
  left: 24rpx;
  z-index: 30;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(17, 17, 20, 0.55);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-hover {
  background: rgba(17, 17, 20, 0.8);
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 报错入口（设计稿：地址行行尾弱化态，旗图标 + 小字，触控区加padding保证 ≥64rpx） */
.report-entry {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  margin-top: 4rpx;
  padding: 20rpx 0 20rpx 8rpx;
  color: #6E6E76;
  font-size: 22rpx;
}

.report-entry-icon {
  width: 24rpx;
  height: 24rpx;
}

.report-entry-hover {
  opacity: 0.7;
}

/* 评分行：离散星 + 分数 + 人数 + 距离 pill（可点击评分） */
.rate-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rate-stars {
  display: flex;
  gap: 4rpx;
}

.rate-star {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.rate-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #FF5A36;
}

.rate-count {
  font-size: 22rpx;
  color: #8C8C94;
}

/* 距离 pill（真实定位距离，橙底胶囊，评分行右侧） */
.dist-pill {
  margin-left: auto;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 90, 54, 0.16);
  color: #FF8A6E;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
}

/* 地址行 */
.addr-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #A6A6AD;
  line-height: 1.5;
}

.addr-pin {
  width: 28rpx;
  height: 28rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

/* 地址文字占满剩余宽度：长地址换行时行尾报错入口自动避让（设计稿 4.5） */
.addr-text {
  flex: 1;
  min-width: 0;
}

/* 标签行（首个标签高亮描边，设计稿同款） */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 运营方入口行（设计稿：深底 #17171B + 左侧橙色态度线） */
.op-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 22rpx 24rpx; /* 通栏命中区尽量接近 44pt 触控基准 */
  border-radius: 12rpx;
  background: #17171B;
  border-left: 6rpx solid #FF5A36;
}

.op-hover {
  background: #26262C;
}

.op-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8C8C94;
}

.op-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #FF8A6E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.op-arrow {
  flex-shrink: 0;
  color: #8C8C94;
  font-size: 30rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #26262C;
  color: #A6A6AD;
  font-size: 24rpx;
}

/* 首个标签：橙系高亮（设计稿 tag-first） */
.tag-first {
  background: rgba(255, 90, 54, 0.16);
  border: 1rpx solid rgba(255, 90, 54, 0.4);
  color: #FF8A6E;
}

/* ===== 今日打卡卡（设计稿 v1.1 ③：热度数据，非在场语义——橙线、无脉冲无循环动画） ===== */
.live-card {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx;
  background: #1E1E23;
  border-radius: 16rpx;
  border-left: 6rpx solid #FF5A36;
}

/* 今日无人打卡：整卡弱化（灰线灰字），不显示头像行 */
.live-card-off {
  border-left-color: #3A3A42;
}

.live-line {
  display: flex;
  align-items: center;
}

.live-text {
  font-size: 26rpx;
  color: #8C8C94;
}

/* 数字白字加重（纯排版强调，无图标无脉冲） */
.live-n {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  margin: 0 4rpx;
}

/* 今日打卡滑手头像 ×4：72rpx 圆形叠放 + 折叠 +N */
.live-avatars {
  display: flex;
  margin-top: 24rpx;
  padding-left: 12rpx;
}

.live-ava {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 6rpx solid #1E1E23;
  margin-left: -12rpx;
  background: #2A2A30;
}

.live-ava-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
}

.live-ava-more {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #26262C;
  color: #A6A6AD;
  font-size: 24rpx;
  font-weight: 600;
}

/* ===== 打卡动态 ===== */
.checkins {
  margin: 32rpx 32rpx 0;
  padding-bottom: 32rpx;
}

.checkins-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.checkins-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.checkins-more {
  font-size: 28rpx;
  color: #8C8C94;
}

.checkin-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.checkin-card {
  background: #1E1E23;
  border-radius: 16rpx;
  padding: 24rpx;
}

.checkin-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 打卡人头部可点（进滑手主页）按压反馈 */
.checkin-head-hover {
  opacity: 0.7;
}

/* 打卡人头像（设计稿 feed 头像 72rpx） */
.checkin-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkin-avatar-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.checkin-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

/* 图片布局与发现页动态流同款：1 张 320rpx 方图；2 张对半分；3 张起 3 列方格铺满 */
.checkin-photos .photo-cell {
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: #17171B;
}

.checkin-photos.photos-1 .photo-cell {
  width: 320rpx;
}

.checkin-photos.photos-2 .photo-cell {
  width: calc((100% - 12rpx) / 2);
}

.checkin-photo {
  width: 100%;
  height: 100%;
}

/* 轮播图片渐显（动效纪律：250ms，CSS 一次性动画，播完定格，无 JS 依赖） */
.photo-fade {
  animation: photo-in 0.25s ease backwards;
}

@keyframes photo-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ===== 签到庆祝层（设计稿瘦身版：无彩纸，橙徽章 + 连签天数；动效纪律：无弹性过冲） ===== */
.celebrate {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
  animation: cel-fade 0.15s ease;
}

@keyframes cel-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.celebrate-card {
  position: relative;
  width: 480rpx;
  background: #1E1E23;
  border-radius: 32rpx;
  padding: 48rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  animation: cel-pop 0.2s ease-out;
}

@keyframes cel-pop {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

/* 消失：200ms 整层淡出（规范 9.2：自动消失/点遮罩关闭均淡出） */
.celebrate-out {
  animation: cel-out 0.2s ease forwards;
}

@keyframes cel-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

/* 橙色圆形徽章 + 白色对勾（设计稿：外圈深橙描边环；规范禁止光晕，无投影） */
.celebrate-badge {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 90, 54, 0.35);
  box-sizing: border-box;
}

.celebrate-check {
  width: 52rpx;
  height: 52rpx;
}

/* 内容左对齐（设计稿同款） */
.celebrate-title {
  margin-top: 16rpx;
  align-self: flex-start;
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 连续天数（青色强调） */
.celebrate-streak {
  align-self: flex-start;
  font-size: 28rpx;
  font-weight: 600;
  color: #00D4AA;
}

/* ===== 评分行点击态 ===== */
.rate-hover {
  opacity: 0.75;
}

/* ===== 评分弹窗（统一底部 sheet，设计稿同款） ===== */
.rate-mask {
  position: fixed;
  inset: 0;
  z-index: 70;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.6);
}

.rate-sheet {
  width: 100%;
  background: #232329;
  border-top: 1rpx solid #2F2F36;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  text-align: center;
  animation: sheet-in 0.25s ease-out both;
}

/* 顶部拖拽指示条 */
.rate-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #3A3A42;
  margin: 8rpx auto 24rpx;
}

.rate-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.rate-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8C8C94;
}

.rate-stars-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 40rpx 0 16rpx;
}

.rate-star-big {
  width: 80rpx;
  height: 80rpx;
  transition: transform 0.15s ease;
}

.rate-star-on {
  transform: scale(1.1);
}

.rate-desc {
  display: block;
  font-size: 26rpx;
  color: #A6A6AD;
  min-height: 40rpx;
}

.rate-btn-submit {
  margin-top: 32rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

.rate-btn-busy {
  opacity: 0.6;
}

.checkin-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6E6E76;
}

.checkin-user {
  flex: 1;
  min-width: 0;
}

.checkin-name-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.checkin-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

/* 滑龄：昵称右侧次级小字，与时间同色阶，不挤压昵称 */
.checkin-years {
  flex-shrink: 0;
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #8A8A93;
}

/* 打卡视频（动态九宫格内联播放，与图片同占位） */
.checkin-video {
  width: 100%;
  height: 100%;
}

/* 弹层选择区的视频小卡：静帧预览、不可点播（确认后动态区可播） */
.photo-tile-video {
  background: #000000;
}

/* 视频封面播放按钮（微博式：九宫格内不内联播放，点击进混合查看器播放） */
.video-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
  width: 0;
  height: 0;
  border-left: 26rpx solid rgba(255, 255, 255, 0.92);
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  filter: drop-shadow(0 0 6rpx rgba(0, 0, 0, 0.4));
}

/* 视频异步上传中角标（微博式：本机可见临时视频，云端他人待上传完成后可见） */
.photo-cell {
  position: relative;
}

.video-uploading {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  z-index: 2;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 18rpx;
}

.checkin-time {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8C8C94;
}

/* 留言 28rpx，行高 1.6，最多 3 行截断（规范 6.2） */
.checkin-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #D9D9DE;
}

/* ===== 底部操作栏（设计稿：两侧窄块 + 中间大橙钮） ===== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(17, 17, 20, 0.96);
  border-top: 1rpx solid #26262C;
  box-sizing: content-box;
}

/* 导航/报错：深色圆角方块 */
.action-side {
  width: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 14rpx 0;
  border-radius: 20rpx;
  background: #1E1E23;
  color: #A6A6AD;
  box-sizing: border-box;
}

.action-hover {
  opacity: 0.75;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
}

.action-label {
  font-size: 22rpx;
  line-height: 1;
}

/* 主操作：橙色渐变大按钮 */
.action-main {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 90, 54, 0.3);
}

.action-main .action-label {
  font-size: 30rpx;
  font-weight: 600;
}

.action-main-hover {
  background: #E63A16;
}

/* 已签到：青色描边窄块（与导航块同形态，键位不跳） */
.action-done {
  width: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 14rpx 0;
  border-radius: 20rpx;
  border: 2rpx solid rgba(0, 212, 170, 0.5);
  color: #00D4AA;
  box-sizing: border-box;
}

.action-done .action-label {
  font-size: 22rpx;
  line-height: 1;
}

/* 发打卡副入口：未签到时主次结构中的次按钮（描边幽灵态，与主按钮拉开层级） */
.action-ghost {
  width: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 14rpx 0;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 90, 54, 0.35);
  color: #FF8A6E;
  box-sizing: border-box;
}

.action-ghost .action-label {
  font-size: 22rpx;
  line-height: 1;
}

/* ===== 底部弹层（签到/报错共用：表单类弹窗统一底部 sheet，键盘友好） ===== */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.6);
}

.sheet {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  background: #232329;
  border-top: 1rpx solid #2F2F36;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: sheet-in 0.25s ease-out both;
}

@keyframes sheet-in {
  from { transform: translateY(80rpx); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}

.anim-sheet-in {
  animation: sheet-in 0.25s ease-out both;
}

/* 顶部拖拽指示条 */
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #3A3A42;
  margin: 8rpx auto 20rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.sheet-head-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 弹窗头图标：实心橙圆 + 白勾（设计稿同款） */
.sheet-head-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sheet-head-badge-icon {
  width: 30rpx;
  height: 30rpx;
}

.report-icon {
  width: 38rpx;
  height: 38rpx;
}

.sheet-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #26262C;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sheet-close-hover {
  background: #3A3A42;
}

.sheet-close-icon {
  width: 26rpx;
  height: 26rpx;
}

/* 当前场地 chip */
.venue-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  align-self: flex-start;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #26262C;
  margin-bottom: 24rpx;
}

.venue-chip-icon {
  width: 26rpx;
  height: 26rpx;
}

.venue-chip-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #FFFFFF;
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 留言行头：label + 计数 */
.note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.note-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.note-count {
  font-size: 24rpx;
  color: #6E6E76;
}

/* 大提交按钮（圆角胶囊 + 图标） */
.sheet-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-btn:active {
  background: #E63A16;
}

.sheet-btn-icon {
  width: 32rpx;
  height: 32rpx;
}

.sheet-btn-loading {
  opacity: 0.7;
}

.sheet-cancel {
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8C8C94;
  padding: 8rpx 0;
}

.field {
  margin-bottom: 28rpx;
}

.field-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #2A2A30;
  background: #17171B;
  font-size: 28rpx;
  color: #D9D9DE;
  box-sizing: border-box;
}

.field-error {
  border-color: #FF3B30;
}

.ph {
  color: #6E6E76;
}

.error-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #FF3B30;
}

/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-tile {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-tile-sm {
  width: 128rpx;
  height: 128rpx;
}

.photo-tile-img {
  width: 100%;
  height: 100%;
}

.photo-tile-del {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-tile-del-icon {
  width: 24rpx;
  height: 24rpx;
}

/* 打卡视频态：单视频独占大格（弹窗满幅），与发现页 feed 单视频观感一致 */
.photo-tile-lg {
  width: 100%;
  height: 440rpx;
  border-radius: 20rpx;
}

/* 视频角标：播放键 + 时长（黑底半透明圆角条，左下角） */
.video-badge {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.6);
}

.video-badge-icon {
  width: 22rpx;
  height: 22rpx;
}

.video-badge-time {
  font-size: 20rpx;
  color: #FFFFFF;
  line-height: 1.2;
}

.photo-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #3A3A42;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #8C8C94;
}

.photo-add:active {
  border-color: #FF5A36;
  color: #FF8A6E;
}

.photo-add-sm {
  width: 128rpx;
  height: 128rpx;
}

.photo-add-icon {
  width: 48rpx;
  height: 48rpx;
}

.photo-add-text {
  font-size: 24rpx;
  padding: 0 8rpx;
  text-align: center;
  line-height: 1.2;
}

.photo-add-sub {
  font-size: 20rpx;
  line-height: 1.2;
}

/* 报错类型 */
.type-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #26262C;
  border: 1rpx solid #2A2A30;
  color: #A6A6AD;
  font-size: 24rpx;
  font-weight: 500;
}

.type-chip-active {
  background: rgba(255, 90, 54, 0.16);
  border-color: rgba(255, 90, 54, 0.4);
  color: #FF8A6E;
}

.report-photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-radius: 16rpx;
  border: 2rpx dashed #3A3A42;
  color: #A6A6AD;
  font-size: 28rpx;
}

.report-photo-add:active {
  background: #1E1E23;
}

.report-photo-add-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 按钮（底部 sheet 的提交/取消样式见 .sheet-btn / .sheet-cancel） */
