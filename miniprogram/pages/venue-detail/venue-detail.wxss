.page {
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom) + 40rpx);
}

/* ===== 轮播 ===== */
.carousel {
  position: relative;
  width: 100%;
  height: 50vh;
  min-height: 600rpx;
  background: #1A1A1E;
}

.swiper {
  width: 100%;
  height: 100%;
}

.photo {
  width: 100%;
  height: 100%;
}

.indicator {
  position: absolute;
  left: 32rpx;
  bottom: 32rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
}

/* ===== 场地信息 ===== */
.info {
  background: #FFFFFF;
  padding: 32rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1E;
  line-height: 1.2;
}

.rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.rating-star {
  width: 32rpx;
  height: 32rpx;
}

.rating-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1E;
}

.address {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #4D4D4D;
}

.address-pin {
  width: 32rpx;
  height: 32rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E8E8E8;
  color: #4D4D4D;
  font-size: 24rpx;
}

.tag-icon {
  width: 28rpx;
  height: 28rpx;
}

/* ===== 实时状态 ===== */
.live {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
}

.live-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.live-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1E;
}

.live-avatars {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.live-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.live-more {
  background: #E8E8E8;
  color: #4D4D4D;
}

/* ===== 打卡动态 ===== */
.checkins {
  margin: 24rpx 32rpx 0;
  padding-bottom: 32rpx;
}

.checkins-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.checkins-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1E;
}

.checkins-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 28rpx;
  color: #8C8C8C;
}

.checkins-more-icon {
  width: 28rpx;
  height: 28rpx;
}

.checkin-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.checkin-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
}

.checkin-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.checkin-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkin-avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.checkin-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.checkin-photo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
}

/* 轮播图片渐显（CSS 一次性动画，播完定格，无 JS 依赖） */
.photo-fade {
  animation: photo-in 0.5s ease backwards;
}

@keyframes photo-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ===== 签到庆祝层 ===== */
.celebrate {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
  animation: cel-fade 0.25s ease;
}

@keyframes cel-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.celebrate-card {
  position: relative;
  width: 460rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 64rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  animation: cel-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 20rpx 60rpx rgba(26, 26, 30, 0.25);
}

@keyframes cel-pop {
  from { opacity: 0; transform: scale(0.6); }
  to { opacity: 1; transform: scale(1); }
}

.celebrate-ring {
  position: absolute;
  top: 28rpx;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid #FF5A36;
  opacity: 0;
  animation: cel-ring 1s ease-out 0.2s;
}

@keyframes cel-ring {
  from { transform: scale(0.6); opacity: 0.8; }
  to { transform: scale(1.6); opacity: 0; }
}

.celebrate-check {
  width: 96rpx;
  height: 96rpx;
}

.celebrate-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1E;
}

.celebrate-sub {
  font-size: 24rpx;
  color: #8C8C8C;
}

/* ===== 名称旁聚合评分（双层裁剪星级，可点击评分） ===== */
.rate-hover {
  opacity: 0.75;
}

.rating .stars {
  position: relative;
  width: 160rpx;
  height: 28rpx;
}

.rating .stars-bg {
  display: flex;
  gap: 3rpx;
}

.rating .stars-fg {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  overflow: hidden;
  display: flex;
  gap: 3rpx;
  white-space: nowrap;
}

.rating .rating-star {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.rating .rating-count {
  font-size: 22rpx;
  color: #C0C0C4;
}

/* ===== 评分弹窗 ===== */
.rate-mask {
  position: fixed;
  inset: 0;
  z-index: 70;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.5);
}

.rate-sheet {
  width: 100%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  text-align: center;
}

.rate-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1E;
}

.rate-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8C8C8C;
}

.rate-stars-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 40rpx 0 16rpx;
}

.rate-star {
  width: 80rpx;
  height: 80rpx;
  transition: transform 0.15s ease;
}

.rate-star-on {
  transform: scale(1.1);
}

.rate-desc {
  display: block;
  font-size: 26rpx;
  color: #8C8C8C;
  min-height: 40rpx;
}

.rate-btn-submit {
  margin-top: 32rpx;
  background: #FF5A36;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 16rpx 0;
}

.rate-btn-busy {
  opacity: 0.6;
}

.checkin-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #C0C0C4;
}

.checkin-user {
  flex: 1;
  min-width: 0;
}

.checkin-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkin-time {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8C8C8C;
}

.checkin-text {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #4D4D4D;
}

/* ===== 底部操作栏 ===== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  border-top: 1rpx solid #E8E8E8;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #4D4D4D;
}

.action-hover {
  background: #F5F5F5;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
}

.action-label {
  font-size: 24rpx;
}

.action-checkin {
  background: #FF5A36;
  color: #FFFFFF;
}

.action-checkin .action-label {
  font-weight: 500;
}

.action-checkin-hover {
  background: #E63A16;
}

.action-done {
  background: #00D4AA;
}

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.5);
}

.modal {
  width: 100%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(26, 26, 30, 0.2);
  box-sizing: border-box;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.modal-title-icon {
  width: 48rpx;
  height: 48rpx;
}

.report-icon {
  width: 40rpx;
  height: 40rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1E;
}

.field {
  margin-bottom: 32rpx;
}

.field-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #1A1A1E;
}

.field-label-icon {
  width: 32rpx;
  height: 32rpx;
}

.field-label-plain {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1E;
}

.field-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #E8E8E8;
  font-size: 28rpx;
  color: #1A1A1E;
  box-sizing: border-box;
}

.field-error {
  border-color: #FF3B30;
}

.ph {
  color: #8C8C8C;
}

.error-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #FF3B30;
}

/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-tile {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-tile-sm {
  width: 128rpx;
  height: 128rpx;
}

.photo-tile-img {
  width: 100%;
  height: 100%;
}

.photo-tile-del {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-tile-del-icon {
  width: 24rpx;
  height: 24rpx;
}

.photo-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #E8E8E8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #8C8C8C;
}

.photo-add:active {
  border-color: #FF5A36;
  color: #FF5A36;
}

.photo-add-sm {
  width: 128rpx;
  height: 128rpx;
}

.photo-add-icon {
  width: 48rpx;
  height: 48rpx;
}

.photo-add-text {
  font-size: 24rpx;
  padding: 0 8rpx;
  text-align: center;
  line-height: 1.2;
}

.photo-add-sub {
  font-size: 20rpx;
  line-height: 1.2;
}

/* 报错类型 */
.type-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #F5F5F5;
  border: 1rpx solid #E8E8E8;
  color: #4D4D4D;
  font-size: 24rpx;
  font-weight: 500;
}

.type-chip-active {
  background: #FF5A36;
  border-color: #FF5A36;
  color: #FFFFFF;
}

.report-photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-radius: 16rpx;
  border: 2rpx dashed #E8E8E8;
  color: #4D4D4D;
  font-size: 28rpx;
}

.report-photo-add:active {
  background: #F5F5F5;
}

.report-photo-add-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 按钮 */
.modal-btn {
  height: 96rpx;
  border-radius: 16rpx;
  background: #FF5A36;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn:active {
  background: #E63A16;
}

.modal-btn-loading {
  opacity: 0.7;
}

.modal-cancel {
  margin-top: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8C8C8C;
  padding: 8rpx 0;
}
