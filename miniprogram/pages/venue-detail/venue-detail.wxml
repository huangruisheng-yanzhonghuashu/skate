<view wx:if="{{venue}}" class="page">
  <!-- 沉浸式头图：名称+热门贴纸覆盖在图上（自定义导航，设计稿同款） -->
  <view class="carousel">
    <swiper
      class="swiper"
      current="{{current}}"
      circular="{{photos.length > 1}}"
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{photos}}" wx:key="*this">
        <image class="photo photo-fade" src="{{item}}" mode="aspectFill" lazy-load />
      </swiper-item>
    </swiper>
    <!-- 无头图占位（设计稿：深色渐变底 + 图片占位图标） -->
    <view wx:if="{{!photos.length}}" class="hero-empty">
      <image class="hero-empty-icon" src="{{icons.imageDim}}" mode="aspectFit" />
    </view>
    <!-- 底部渐变 + 名称/热门贴纸 -->
    <view class="hero-grad"></view>
    <view class="hero-info">
      <view class="hero-name-row">
        <text class="hero-name">{{venue.name}}</text>
        <view wx:if="{{hot}}" class="hot-sticker">热门</view>
      </view>
    </view>
    <!-- 图片计数：悬浮在胶囊区下方（设计稿右上角位） -->
    <view wx:if="{{photos.length > 1}}" class="hero-counter" style="top: {{statusBarHeight + 52}}px">{{current + 1}}/{{photos.length}}</view>
  </view>

  <!-- 返回按钮（自定义导航，悬浮在状态栏下） -->
  <view
    class="nav-back"
    style="top: {{statusBarHeight + 8}}px"
    hover-class="nav-back-hover"
    bindtap="goBack"
    aria-role="button"
    aria-label="返回"
  >
    <image class="nav-back-icon" src="{{icons.back}}" mode="aspectFit" />
  </view>

  <!-- 信息卡：评分行 + 地址（行尾报错入口） + 标签 + 运营方 -->
  <view class="info">
    <!-- 聚合评分：五颗离散星（4.8 星点亮 4 颗）+ 分数 + 人数，可点击评分 -->
    <view class="rate-row" hover-class="rate-hover" bindtap="openRate" aria-role="button" aria-label="查看评分并评分">
      <view class="rate-stars">
        <image wx:for="{{[0,1,2,3,4]}}" wx:key="*this" class="rate-star" src="{{rateInt > item ? icons.starOrange : icons.starDarkGray}}" mode="aspectFit" />
      </view>
      <text class="rate-num">{{rating || '暂无'}}</text>
      <text class="rate-count">{{ratingCount ? '· ' + ratingCount + '人评价' : '· 暂无评价'}}</text>
      <view wx:if="{{distanceText}}" class="dist-pill">距你 {{distanceText}}</view>
    </view>
    <view class="addr-row">
      <image class="addr-pin" src="{{icons.pin}}" mode="aspectFit" />
      <text class="addr-text">{{venue.address}}</text>
      <!-- 报错入口（设计稿：地址行行尾，地址 flex:1 换行自动避让，绝不重叠） -->
      <view class="report-entry" hover-class="report-entry-hover" bindtap="openReport" aria-role="button" aria-label="报错">
        <image class="report-entry-icon" src="{{icons.flag}}" mode="aspectFit" />
        <text>报错</text>
      </view>
    </view>
    <!-- 标签行：最多 3 个平铺，溢出折叠 +N（规范 4.3） -->
    <view class="tag-row">
      <view wx:for="{{tags}}" wx:key="label" class="tag {{index === 0 ? 'tag-first' : ''}}">
        <text>{{item.label}}</text>
      </view>
      <view wx:if="{{tagMore > 0}}" class="tag">+{{tagMore}}</view>
    </view>
    <!-- 驻场/运营机构入口（org↔venue 关联，有运营方才显示） -->
    <view wx:if="{{operatorShop}}" class="op-row" hover-class="op-hover" bindtap="goOperator" aria-role="button" aria-label="进入运营方主页">
      <text class="op-label">运营方</text>
      <text class="op-name">{{operatorShop.name}}</text>
      <text class="op-arrow">›</text>
    </view>
  </view>

  <!-- 实时状态（在线口径：30 分钟窗口内有过在场心跳；无人时左侧竖条/文字灰色弱化） -->
  <view class="live {{online > 0 ? '' : 'live-off'}}">
    <view class="live-line">
      <view class="pulse {{online > 0 ? '' : 'pulse-gray'}}"></view>
      <text wx:if="{{online > 0}}" class="live-text">此刻 <text class="live-n">{{online}}</text> 位滑手在此</text>
      <text wx:else class="live-text live-text-gray">近 30 分钟暂无滑手在场</text>
    </view>
    <!-- 在场头像：真实心跳用户，重叠排列；无人时整块隐藏 -->
    <view class="live-avatars" wx:if="{{online > 0 && presenceUsers.length}}">
      <block wx:for="{{presenceUsers}}" wx:key="index">
        <image wx:if="{{item.avatarFile}}" class="live-avatar-img" src="{{item.avatarFile}}" mode="aspectFill" />
        <view wx:else class="live-avatar" style="background: {{item.color}}">{{item.text}}</view>
      </block>
      <view wx:if="{{moreCount > 0}}" class="live-avatar live-more">+{{moreCount}}</view>
    </view>
  </view>

  <!-- 打卡动态（云端真实流：所有人带留言的打卡，最近3条） -->
  <view class="checkins">
    <view class="checkins-head">
      <text class="checkins-title">打卡动态</text>
      <text class="checkins-more" bindtap="showAllCheckins">查看全部 ›</text>
    </view>
    <view class="checkin-list" wx:if="{{feed.length}}">
      <view wx:for="{{feed}}" wx:key="id" class="checkin-card" bindlongpress="onPostLongPress" data-id="{{item.id}}">
        <view class="checkin-head" hover-class="checkin-head-hover" catchtap="goUserProfile" data-openid="{{item.openid}}" data-user="{{item.user}}" data-avatar="{{item.avatarFile}}" data-years="{{item.skateYears}}">
          <image wx:if="{{item.avatarFile}}" class="checkin-avatar-img" src="{{item.avatarFile}}" mode="aspectFill" />
          <view wx:else class="checkin-avatar" style="background: {{item.color}}">{{item.avatarText}}</view>
          <view class="checkin-user">
            <view class="checkin-name-row">
              <text class="checkin-name">{{item.user}}</text>
              <text wx:if="{{item.skateYears}}" class="checkin-years">滑龄{{item.skateYears}}</text>
            </view>
            <text class="checkin-time">{{item.time}}</text>
          </view>
        </view>
        <text class="checkin-text">{{item.note}}</text>
        <view wx:if="{{item.media.length}}" class="checkin-photos photos-{{item.media.length >= 3 ? 'grid' : item.media.length}}">
          <view wx:for="{{item.media}}" wx:for-item="p" wx:key="url" class="photo-cell" catchtap="previewMedia" data-media="{{item.media}}" data-index="{{index}}">
            <video
              wx:if="{{p.type === 'video'}}"
              class="checkin-video"
              src="{{p.url}}"
              object-fit="cover"
              controls="{{false}}"
              show-center-play-btn="{{false}}"
            />
            <image
              wx:else
              class="checkin-photo"
              src="{{p.url}}"
              mode="aspectFill"
              lazy-load
            />
            <view wx:if="{{p.type === 'video'}}" class="video-play"></view>
            <view wx:if="{{p.local}}" class="video-uploading">上传中</view>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="checkin-empty">还没有打卡，点下方「发打卡」发第一条</view>
  </view>

  <!-- 底部固定操作栏：导航 / 签到(未签到，一键+定位硬校验) / 发打卡（已签到主键翻转，键位不跳，设计稿同款） -->
  <view class="action-bar">
    <view class="action-side" hover-class="action-hover" bindtap="openNav" aria-role="button" aria-label="导航到场地">
      <image class="action-icon" src="{{icons.send}}" mode="aspectFit" />
      <text class="action-label">导航</text>
    </view>
    <block wx:if="{{checked}}">
      <view
        class="action-main"
        hover-class="action-main-hover"
        bindtap="openPost"
        aria-role="button"
        aria-label="发打卡"
      >
        <image class="action-icon" src="{{icons.camera}}" mode="aspectFit" />
        <text class="action-label">发打卡</text>
      </view>
      <view class="action-done" hover-class="action-hover" bindtap="onDoneTap" aria-role="button" aria-label="已签到">
        <image class="action-icon" src="{{icons.check}}" mode="aspectFit" />
        <text class="action-label">已签到</text>
      </view>
    </block>
    <block wx:else>
      <view
        class="action-main"
        hover-class="action-main-hover"
        bindtap="doCheckin"
        aria-role="button"
        aria-label="签到"
      >
        <image class="action-icon" src="{{icons.check}}" mode="aspectFit" />
        <text class="action-label">签到</text>
      </view>
      <view class="action-ghost" hover-class="action-hover" bindtap="openPost" aria-role="button" aria-label="发打卡">
        <image class="action-icon" src="{{icons.cameraRose}}" mode="aspectFit" />
        <text class="action-label">发打卡</text>
      </view>
    </block>
  </view>

  <!-- 发布打卡弹窗（底部 sheet，键盘友好） -->
  <view wx:if="{{checkinOpen}}" class="sheet-mask anim-fade-in" bindtap="closeCheckin" catchtouchmove="noop">
    <view class="sheet anim-sheet-in" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view class="sheet-head-badge">
          <image class="sheet-head-badge-icon" src="{{icons.camera}}" mode="aspectFit" />
        </view>
        <text class="sheet-title">{{checkinMode === 'edit' ? '编辑打卡' : '发布打卡'}}</text>
        <view class="sheet-close" hover-class="sheet-close-hover" bindtap="closeCheckin" aria-role="button" aria-label="关闭">
          <image class="sheet-close-icon" src="{{icons.x}}" mode="aspectFit" />
        </view>
      </view>

      <view class="venue-chip">
        <image class="venue-chip-icon" src="{{icons.pin}}" mode="aspectFit" />
        <text class="venue-chip-text">{{venue.name}}</text>
      </view>

      <view class="field">
        <view class="note-head">
          <text class="note-label">说点什么</text>
          <text class="note-count">{{note.length}}/200</text>
        </view>
        <textarea
          class="field-textarea"
          value="{{note}}"
          maxlength="200"
          placeholder="说点什么... (选填)"
          placeholder-class="ph"
          bindinput="onNoteInput"
        />
      </view>

      <view class="field">
        <!-- 图/视频互斥：图≤9张 或 视频1个；视频态独占大格+时长角标、无添加格 -->
        <view class="photo-grid">
          <view wx:for="{{checkinMedia}}" wx:key="url" class="photo-tile {{checkinMediaMode === 'video' ? 'photo-tile-lg' : ''}}">
            <video
              wx:if="{{item.type === 'video'}}"
              class="photo-tile-img photo-tile-video"
              src="{{item.url}}"
              object-fit="cover"
              controls="{{false}}"
              show-center-play-btn="{{false}}"
            />
            <image wx:else class="photo-tile-img" src="{{item.url}}" mode="aspectFill" />
            <view wx:if="{{item.type === 'video'}}" class="video-badge">
              <image class="video-badge-icon" src="{{icons.play}}" mode="aspectFit" />
              <text wx:if="{{item.durationText}}" class="video-badge-time">{{item.durationText}}</text>
            </view>
            <view class="photo-tile-del" data-index="{{index}}" catchtap="removeCheckinMedia">
              <image class="photo-tile-del-icon" src="{{icons.x}}" mode="aspectFit" />
            </view>
          </view>
          <view wx:if="{{checkinMediaMode !== 'video'}}" class="photo-add" bindtap="chooseCheckinMedia">
            <image class="photo-add-icon" src="{{icons.plus}}" mode="aspectFit" />
            <text class="photo-add-text">{{checkinMediaMode === 'image' ? '添加图片' : '添加图片/视频'}}</text>
            <text class="photo-add-sub">{{checkinMediaMode === 'image' ? checkinMedia.length + '/9' : '图最多 9 张 或 视频 1 个'}}</text>
          </view>
        </view>
      </view>

      <view class="sheet-btn {{checkinSubmitting ? 'sheet-btn-loading' : ''}}" bindtap="confirmPost">
        <image class="sheet-btn-icon" src="{{icons.check}}" mode="aspectFit" />
        <text>{{checkinSubmitting ? (checkinMode === 'edit' ? '更新中...' : '发布中...') : (checkinMode === 'edit' ? '更新打卡' : '发布打卡')}}</text>
      </view>
      <view class="sheet-cancel" bindtap="closeCheckin">取消</view>
    </view>
  </view>

  <!-- 报错弹窗（底部 sheet） -->
  <view wx:if="{{reportOpen}}" class="sheet-mask anim-fade-in" bindtap="closeReport" catchtouchmove="noop">
    <view class="sheet anim-sheet-in" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <image class="sheet-head-icon report-icon" src="{{icons.flag}}" mode="aspectFit" />
        <text class="sheet-title">场地报错</text>
        <view class="sheet-close" hover-class="sheet-close-hover" bindtap="closeReport" aria-role="button" aria-label="关闭">
          <image class="sheet-close-icon" src="{{icons.x}}" mode="aspectFit" />
        </view>
      </view>

      <view class="field">
        <text class="field-label-plain">问题类型</text>
        <view class="type-wrap">
          <view
            wx:for="{{reportTypes}}"
            wx:key="*this"
            class="type-chip {{reportType === item ? 'type-chip-active' : ''}}"
            data-type="{{item}}"
            bindtap="pickReportType"
          >{{item}}</view>
        </view>
      </view>

      <view class="field">
        <textarea
          class="field-textarea {{reportError ? 'field-error anim-shake' : ''}}"
          value="{{reportDesc}}"
          maxlength="500"
          placeholder="请详细描述问题... (必填)"
          placeholder-class="ph"
          bindinput="onReportInput"
        />
        <text wx:if="{{reportError}}" class="error-text">请填写问题描述后再提交</text>
      </view>

      <view class="field">
        <view wx:if="{{reportPhotos.length === 0}}" class="report-photo-add" bindtap="chooseReportPhoto">
          <image class="report-photo-add-icon" src="{{icons.imagePlus}}" mode="aspectFit" />
          <text>添加举证照片</text>
        </view>
        <view wx:else class="photo-grid">
          <view wx:for="{{reportPhotos}}" wx:key="*this" class="photo-tile photo-tile-sm">
            <image class="photo-tile-img" src="{{item}}" mode="aspectFill" />
            <view class="photo-tile-del" data-index="{{index}}" catchtap="removeReportPhoto">
              <image class="photo-tile-del-icon" src="{{icons.x}}" mode="aspectFit" />
            </view>
          </view>
          <view wx:if="{{reportPhotos.length < 3}}" class="photo-add photo-add-sm" bindtap="chooseReportPhoto">
            <image class="photo-add-icon" src="{{icons.imagePlus}}" mode="aspectFit" />
          </view>
        </view>
      </view>

      <view class="sheet-btn {{reportSubmitting ? 'sheet-btn-loading' : ''}}" bindtap="submitReport">
        <text>{{reportSubmitting ? '提交中...' : '提交报错'}}</text>
      </view>
      <view class="sheet-cancel" bindtap="closeReport">取消</view>
    </view>
  </view>
</view>

<!-- 签到成功庆祝（设计稿瘦身版：橙色徽章 + 连签天数，1.2s 自动消失，点遮罩立即关） -->
<view wx:if="{{celebrate}}" class="celebrate {{celebrateClosing ? 'celebrate-out' : ''}}" bindtap="closeCelebrate" catchtouchmove="noop">
  <view class="celebrate-card" catchtap="noop">
    <view class="celebrate-badge">
      <image class="celebrate-check" src="{{icons.checkWhite}}" mode="aspectFit" />
    </view>
    <text class="celebrate-title">签到成功</text>
    <text class="celebrate-streak">已连续签到 {{celebrateStreak}} 天</text>
  </view>
</view>

<!-- 评分弹窗（统一底部 sheet，设计稿同款） -->
<view wx:if="{{rateOpen}}" class="rate-mask" bindtap="closeRate">
  <view class="rate-sheet" catchtap="noop">
    <view class="rate-handle"></view>
    <view class="rate-title">给「{{venue.name}}」评分</view>
    <text wx:if="{{myRating}}" class="rate-hint">你当前评分 {{myRating}} 星，点击星星可修改</text>
    <view class="rate-stars-row">
      <image
        wx:for="{{[1,2,3,4,5]}}"
        wx:key="*this"
        class="rate-star-big {{rateStars >= item ? 'rate-star-on' : ''}}"
        src="{{rateStars >= item ? icons.starOrange : icons.starDarkGray}}"
        mode="aspectFit"
        data-star="{{item}}"
        bindtap="pickStar"
      />
    </view>
    <text class="rate-desc">{{rateStars ? rateStars + ' 星' : '点击评分'}}</text>
    <view class="rate-btn-submit {{rateSubmitting ? 'rate-btn-busy' : ''}}" bindtap="submitRate">
      {{rateSubmitting ? '提交中...' : '提交评分'}}
    </view>
  </view>
</view>

<!-- 打卡媒体查看器（微博式：图视频混滑、视频封面点播） -->
<media-viewer
  visible="{{viewerShow}}"
  sources="{{viewerSources}}"
  current="{{viewerCurrent}}"
  bind:close="onViewerClose"
/>
