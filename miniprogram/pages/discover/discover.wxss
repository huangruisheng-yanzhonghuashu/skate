.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ===== 吸顶头部：状态栏占位 + 自绘标题（自定义导航）+ 工具条 ===== */
.dis-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #111114;
  border-bottom: 1rpx solid #26262C;
}

/* 标题行：88rpx（44px）标准导航高度，避开右侧胶囊 */
.dis-nav {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dis-nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.dis-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 8rpx 32rpx;
}

.dis-tabs {
  display: flex;
  gap: 32rpx;
}

/* Tab：触控区 ≥88rpx 高（44px），下划线定位跟随文字而非触控区底边 */
.dis-tab {
  position: relative;
  padding: 20rpx 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
  color: #8C8C94;
}

.dis-tab-hover {
  opacity: 0.7;
}

/* 发打卡：橙描边胶囊主操作（触控高度 88rpx = 44px） */
.dis-post {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 90, 54, 0.4);
  color: #FF8A6E;
  font-size: 26rpx;
  line-height: 1;
  flex-shrink: 0;
}

.dis-post-icon {
  width: 26rpx;
  height: 26rpx;
}

.dis-post-hover {
  opacity: 0.75;
}

.dis-tab-active {
  color: #FF5A36;
  font-weight: 600;
}

.dis-tab-line {
  position: absolute;
  left: 50%;
  top: 64rpx;
  width: 40rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #FF5A36;
  transform: translateX(-50%);
}

/* ===== 动态卡片 ===== */
.feed {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feed-card {
  background: #1E1E23;
  border-radius: 16rpx;
  padding: 24rpx;
}

.feed-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

/* 打卡人头部可点（进滑手主页）按压反馈 */
.feed-head-hover {
  opacity: 0.7;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feed-user {
  flex: 1;
  min-width: 0;
}

.feed-user-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.feed-name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 第二行：类型灰标 + 场地名橙色链接 */
.feed-place-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
  min-width: 0;
}

.feed-venue {
  font-size: 26rpx;
  font-weight: 500;
  color: #FF8A6E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 8rpx 0;
  margin: -8rpx 0;
}

.feed-time {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8C8C94;
}

.feed-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.6;
  color: #D9D9DE;
  margin-bottom: 20rpx;
}

/* ===== 图片 ===== */
.feed-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.photos-grid .photo-cell {
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1;
}

.photos-1 .photo-cell {
  width: 320rpx;
  aspect-ratio: 1;
}

.photos-2 .photo-cell {
  width: calc((100% - 12rpx) / 2);
  aspect-ratio: 1;
}

.photo-cell {
  border-radius: 12rpx;
  overflow: hidden;
  background: #17171B;
}

.photo {
  width: 100%;
  height: 100%;
}

/* 打卡视频（九宫格封面帧 + 播放按钮，点击进混合查看器播放） */
.feed-video {
  width: 100%;
  height: 100%;
}

/* 视频封面播放按钮（微博式） */
.video-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
  width: 0;
  height: 0;
  border-left: 26rpx solid rgba(255, 255, 255, 0.92);
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  filter: drop-shadow(0 0 6rpx rgba(0, 0, 0, 0.4));
}

/* 视频异步上传中角标（微博式：本机可见临时视频，云端他人待上传完成后可见） */
.photo-cell {
  position: relative;
}

.video-uploading {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  z-index: 2;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 22rpx;
}

/* ===== 点赞 / 评论 ===== */
.feed-actions {
  display: flex;
  gap: 48rpx;
  font-size: 26rpx;
  color: #8C8C94;
}

/* 动作项：padding 扩触控区至 ≥88rpx 高，负 margin 抵消不改变布局节奏 */
.action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 26rpx 20rpx;
  margin: -26rpx -20rpx;
}

.action-hover {
  opacity: 0.6;
}

.action-liked {
  color: #FF5A36;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 点赞动效：爱心缩放爆开（D3） */
.action-liked .action-icon {
  animation: heart-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes heart-pop {
  0% { transform: scale(0.6); }
  60% { transform: scale(1.25); }
  100% { transform: scale(1); }
}

/* 卡片错峰入场（前 10 张依次淡入上移，加载更多不重复播） */
.feed-in {
  animation: feed-in 0.35s ease backwards;
}

@keyframes feed-in {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 头像图片（fileID） ===== */
.avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* 实体类型标签（第二行灰标） */
.feed-kind {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8C8C94;
  background: #26262C;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.2;
}

/* ===== 分页提示 ===== */
.more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #6E6E76;
}

/* ===== 失败态 ===== */
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 220rpx 40rpx 0;
}

.error-text {
  font-size: 28rpx;
  color: #8C8C94;
}

.error-btn {
  min-height: 88rpx;
  padding: 0 72rpx;
  display: flex;
  align-items: center;
  color: #FF5A36;
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== 空态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 220rpx 40rpx 0;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.empty-sub {
  font-size: 26rpx;
  color: #8C8C94;
}

.empty-btn {
  margin-top: 16rpx;
  min-height: 88rpx;
  padding: 0 72rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

/* 通用按压反馈（空态/失败态按钮） */
.op-hover {
  opacity: 0.85;
}
