.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ===== 头部：大标题 + 右侧切换（设计稿同款） ===== */
.dis-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 20rpx;
  background: #111114;
}

.dis-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.dis-tabs {
  display: flex;
  gap: 40rpx;
}

.dis-tab {
  position: relative;
  padding: 4rpx 4rpx 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #8C8C94;
}

.dis-tab-active {
  color: #FF5A36;
  font-weight: 600;
}

.dis-tab-line {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 40rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #FF5A36;
  transform: translateX(-50%);
}

/* ===== 动态卡片 ===== */
.feed {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feed-card {
  background: #1E1E23;
  border-radius: 16rpx;
  padding: 24rpx;
}

.feed-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feed-user {
  flex: 1;
  min-width: 0;
}

.feed-user-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.feed-name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 第二行：类型灰标 + 场地名橙色链接 */
.feed-place-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
  min-width: 0;
}

.feed-venue {
  font-size: 26rpx;
  font-weight: 500;
  color: #FF8A6E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-time {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8C8C94;
}

.feed-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.6;
  color: #D9D9DE;
  margin-bottom: 20rpx;
}

/* ===== 图片 ===== */
.feed-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.photos-grid .photo-cell {
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1;
}

.photos-1 .photo-cell {
  width: 320rpx;
  aspect-ratio: 1;
}

.photos-2 .photo-cell {
  width: calc((100% - 12rpx) / 2);
  aspect-ratio: 1;
}

.photo-cell {
  border-radius: 12rpx;
  overflow: hidden;
  background: #17171B;
}

.photo {
  width: 100%;
  height: 100%;
}

/* ===== 点赞 / 评论 ===== */
.feed-actions {
  display: flex;
  gap: 48rpx;
  font-size: 26rpx;
  color: #8C8C94;
}

.action {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.action-liked {
  color: #FF5A36;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 点赞动效：爱心缩放爆开（D3） */
.action-liked .action-icon {
  animation: heart-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes heart-pop {
  0% { transform: scale(0.6); }
  60% { transform: scale(1.25); }
  100% { transform: scale(1); }
}

/* 卡片错峰入场（前 10 张依次淡入上移，加载更多不重复播） */
.feed-in {
  animation: feed-in 0.35s ease backwards;
}

@keyframes feed-in {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 头像图片（fileID） ===== */
.avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* 实体类型标签（第二行灰标） */
.feed-kind {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #8C8C94;
  background: #26262C;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.2;
}

/* ===== 分页提示 ===== */
.more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #6E6E76;
}

/* ===== 空态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 220rpx 40rpx 0;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.empty-sub {
  font-size: 26rpx;
  color: #8C8C94;
}

.empty-btn {
  margin-top: 16rpx;
  padding: 18rpx 72rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
}
