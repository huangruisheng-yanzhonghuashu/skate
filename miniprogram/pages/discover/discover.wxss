.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ===== Tab 切换 ===== */
.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  justify-content: center;
  gap: 96rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E8E8E8;
}

.tab {
  position: relative;
  padding: 24rpx 8rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #8C8C8C;
}

.tab-active {
  color: #FF5A36;
}

.tab-line {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 48rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #FF5A36;
  transform: translateX(-50%);
}

/* ===== 动态卡片 ===== */
.feed {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feed-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 30, 0.04);
}

.feed-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feed-user {
  flex: 1;
  min-width: 0;
}

.feed-user-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.feed-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-dot {
  color: #8C8C8C;
}

.feed-venue {
  font-size: 26rpx;
  color: #FF5A36;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-time {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8C8C8C;
}

.feed-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1A1A1E;
  margin-bottom: 20rpx;
}

/* ===== 图片 ===== */
.feed-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.photos-grid .photo-cell {
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1;
}

.photos-1 .photo-cell {
  width: 320rpx;
  aspect-ratio: 1;
}

.photos-2 .photo-cell {
  width: calc((100% - 12rpx) / 2);
  aspect-ratio: 1;
}

.photo-cell {
  border-radius: 12rpx;
  overflow: hidden;
  background: #F5F5F5;
}

.photo {
  width: 100%;
  height: 100%;
}

/* ===== 点赞 / 评论 ===== */
.feed-actions {
  display: flex;
  gap: 48rpx;
  font-size: 26rpx;
  color: #8C8C8C;
}

.action {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.action-liked {
  color: #FF5A36;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
}
