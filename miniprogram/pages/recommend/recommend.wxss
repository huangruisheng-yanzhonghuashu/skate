.page {
  min-height: 100vh;
  background: #111114;
  padding: 24rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 顶部说明 ===== */
.hero {
  background: #1E1E23;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: #8C8C94;
  line-height: 1.6;
}

/* ===== 空态/加载 ===== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 120rpx 40rpx 0;
  color: #8C8C94;
  font-size: 28rpx;
}

.state-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #D9D9DE;
}

.state-desc {
  font-size: 26rpx;
}

/* ===== 推荐卡片 ===== */
.fb-card {
  background: #1E1E23;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.fb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 标题：白色粗体（场地/门店与俱乐部 · 名称） */
.fb-type {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 状态徽章：待审核橙 / 已通过青 / 未通过红 */
.fb-status {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.2;
}

.fb-status-pending {
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.14);
}

.fb-status-done {
  color: #00D4AA;
  background: rgba(0, 212, 170, 0.12);
}

.fb-status-rejected {
  color: #FF3B30;
  background: rgba(255, 59, 48, 0.12);
}

.fb-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #8C8C94;
  line-height: 1.5;
  word-break: break-all;
}

.fb-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.fb-photo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
}

/* 审核意见块 */
.fb-reply {
  margin-top: 20rpx;
  background: #17171B;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.fb-reply-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fb-reply-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #FF8A6E;
}

.fb-reply-time {
  font-size: 22rpx;
  color: #6E6E76;
}

.fb-reply-text {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #A6A6AD;
  line-height: 1.6;
  word-break: break-all;
}

.fb-time {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #6E6E76;
}

/* ===== 推荐按钮（悬浮 FAB，右下角，与运营管理同款） ===== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 36rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 90, 54, 0.35);
}

.fab:active {
  opacity: 0.85;
}

/* ===== 表单弹窗（以下样式值与运营管理表单弹窗完全一致） ===== */
.mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.6);
}

.sheet {
  width: 100%;
  height: 80vh; /* 固定高度（max-height 会让 flex 子项拒绝收缩，滚动失效） */
  background: #232329;
  border: 1rpx solid #2F2F36;
  border-radius: 20rpx;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 滚动区：flex 子项获得确定高度，scroll-y 生效；min-height:0 是关键 */
.sheet-body {
  flex: 1;
  min-height: 0;
}

/* 滚动条隐藏（enhanced/show-scrollbar 在部分机型失效，CSS 双保险） */
.sheet-body::-webkit-scrollbar,
.sheet-body ::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

/* 标题行：左对齐 + 右侧关闭（设计稿同款） */
.sheet-head {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.sheet-title {
  flex: 1;
  text-align: left;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #26262C;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 30rpx;
  color: #8C8C94;
  line-height: 1;
}

.f-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #26262C;
}

.f-row-top {
  align-items: flex-start;
}

.f-label {
  width: 96rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

/* 同行第二个字段标签（城市+类型同行布局） */
.f-label-2 {
  margin-left: 16rpx;
}

/* 字段补充说明（如：最多 6 张） */
.f-sub {
  width: 100%;
  font-size: 22rpx;
  color: #6E6E76;
}

.f-input {
  flex: 1;
  font-size: 28rpx;
  color: #D9D9DE;
}

.ph {
  color: #6E6E76;
}

.f-picker {
  font-size: 28rpx;
  color: #FF8A6E;
  padding: 8rpx 24rpx;
  background: rgba(255, 90, 54, 0.16);
  border-radius: 10rpx;
}

.f-picker-half {
  min-width: 140rpx;
  text-align: center;
}

.f-empty {
  color: #6E6E76;
}

/* 地图选点按钮（与管理表单同款橙底样式） */
.f-btn {
  font-size: 26rpx;
  color: #FF8A6E;
  padding: 10rpx 24rpx;
  background: rgba(255, 90, 54, 0.16);
  border-radius: 10rpx;
}

.f-btn-ok {
  color: #00D4AA;
  background: rgba(0, 212, 170, 0.12);
}

.f-dash {
  font-size: 26rpx;
  color: #8C8C94;
}

.f-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #6E6E76;
  text-align: center;
}

/* chips 多选 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  flex: 1;
}

.chip {
  font-size: 24rpx;
  color: #A6A6AD;
  background: #26262C;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}

.chip-on {
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.16);
}

.f-textarea {
  flex: 1;
  width: 100%;
  min-height: 150rpx;
  font-size: 28rpx;
  color: #D9D9DE;
  line-height: 1.6;
}

/* 照片多选 */
.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.photo-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #17171B;
  border: 2rpx dashed #3A3A42;
  color: #8C8C94;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-uploading {
  opacity: 0.5;
}

/* 保存按钮（滚动内容末尾） */
.f-save {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 8rpx 0;
}

.f-save::after {
  border: none;
}

.f-saving {
  opacity: 0.6;
}
