<view class="page">
  <!-- 头部：美团式两行——导航行左侧「定位城市」（原原生标题位置）+ 搜索框独占整行 -->
  <view class="header">
    <!-- 导航行：左对齐定位城市，高度 = 状态栏 + 胶囊基准（JS 计算） -->
    <view class="nav-row" style="padding-top: {{statusBarHeight}}px">
      <view class="nav-row-inner" style="height: {{navContentHeight}}px">
        <view class="city" hover-class="hv" bindtap="goCityPicker" aria-role="button" aria-label="选择城市">
          <image class="city-pin" src="{{icons.pinOrange}}" mode="aspectFit" />
          <text>{{city}}</text>
          <image class="city-swap" src="{{icons.swap}}" mode="aspectFit" />
        </view>
        <!-- 在线热度（presence 聚合合计；无人在线时隐藏避免噪音） -->
        <view wx:if="{{heatCount > 0}}" class="heat" aria-label="今日 {{heatCount}} 人在滑">
          <view class="heat-dot"></view>
          <text class="heat-num">{{heatCount}}</text>
          <text class="heat-label">人在滑</text>
        </view>
      </view>
    </view>

    <!-- 搜索行：占整行 -->
    <view wx:if="{{!searchOpen}}" class="header-row">
      <view class="search-pill" hover-class="hv" bindtap="openSearch">
        <image class="search-icon" src="{{icons.search}}" mode="aspectFit" />
        <text class="search-pill-text">搜索场地、俱乐部、门店...</text>
      </view>
    </view>

    <view wx:else class="header-row">
      <view class="search-input-wrap">
        <image class="search-icon" src="{{icons.search}}" mode="aspectFit" />
        <input
          class="search-input"
          value="{{query}}"
          focus
          confirm-type="search"
          placeholder="搜索场地、俱乐部、门店..."
          placeholder-class="search-ph"
          bindinput="onQueryInput"
        />
        <view wx:if="{{query}}" class="search-clear" hover-class="hv" aria-role="button" aria-label="清空搜索" bindtap="clearQuery">
          <image class="search-clear-icon" src="{{icons.xWhite}}" mode="aspectFit" />
        </view>
      </view>
      <view class="search-cancel" hover-class="hv" bindtap="closeSearch">取消</view>
    </view>
  </view>

  <!-- 快捷入口：与一级 Tab 一致的 4 瓦片，点击切 Tab + 滚动到列表面板 -->
  <view class="tiles">
    <view class="tile" hover-class="hv" bindtap="quickTo" data-tab="venue" aria-role="button" aria-label="场地">
      <image class="tile-icon" src="{{icons.tileVenue}}" mode="aspectFit" />
      <text class="tile-text">场地</text>
    </view>
    <view class="tile" hover-class="hv" bindtap="quickTo" data-tab="俱乐部" aria-role="button" aria-label="俱乐部">
      <image class="tile-icon" src="{{icons.tileClub}}" mode="aspectFit" />
      <text class="tile-text">俱乐部</text>
    </view>
    <view class="tile" hover-class="hv" bindtap="quickTo" data-tab="培训机构" aria-role="button" aria-label="培训机构">
      <image class="tile-icon" src="{{icons.tileTrain}}" mode="aspectFit" />
      <text class="tile-text">培训机构</text>
    </view>
    <view class="tile" hover-class="hv" bindtap="quickTo" data-tab="板店" aria-role="button" aria-label="板店">
      <image class="tile-icon" src="{{icons.tileShop}}" mode="aspectFit" />
      <text class="tile-text">板店</text>
    </view>
  </view>

  <!-- 最新打卡（改版新增）：发现页同源社区流，横滑轻卡；空数据整区隐藏 -->
  <view class="feed-sec" wx:if="{{feed.length}}">
    <view class="sec-head">
      <text class="sec-title">最新打卡</text>
    </view>
    <scroll-view class="feed-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{feed}}"
        wx:key="id"
        class="feed-card"
        aria-role="button"
        aria-label="{{item.user}}的打卡"
      >
        <!-- 内容区（封面/文字）：点按预览媒体，纯文字卡降级进打卡详情 -->
        <view
          class="feed-cover"
          hover-class="hv"
          bindtap="onFeedContent"
          data-id="{{item.id}}"
          data-media="{{item.media}}"
          data-index="0"
          aria-role="button"
          aria-label="预览打卡内容"
        >
          <video
            wx:if="{{item.coverType === 'video'}}"
            class="feed-cover-media"
            src="{{item.cover}}"
            object-fit="cover"
            controls="{{false}}"
            show-center-play-btn="{{false}}"
          />
          <image
            wx:elif="{{item.cover}}"
            class="feed-cover-media"
            src="{{item.cover}}"
            mode="aspectFill"
            lazy-load
          />
          <view wx:else class="feed-cover-text"><text>{{item.note}}</text></view>
          <view wx:if="{{item.coverType === 'video'}}" class="feed-play"></view>
        </view>
        <view
          wx:if="{{item.cover && item.note}}"
          class="feed-note"
          hover-class="hv"
          bindtap="onFeedContent"
          data-id="{{item.id}}"
          data-media="{{item.media}}"
          data-index="0"
        >{{item.note}}</view>
        <!-- 头像：进滑手主页 -->
        <view
          class="feed-meta"
          catchtap="goFeedUser"
          data-openid="{{item.openid}}"
          data-user="{{item.user}}"
          data-avatar="{{item.avatarFile}}"
        >
          <view class="feed-avatar-wrap" hover-class="hv">
            <image wx:if="{{item.avatarFile}}" class="feed-avatar" src="{{item.avatarFile}}" mode="aspectFill" />
            <view wx:else class="feed-avatar feed-avatar-text">{{item.avatarText}}</view>
          </view>
          <text class="feed-name">{{item.user}}</text>
          <text class="feed-time">{{item.timeText}}</text>
        </view>
        <!-- 场所名：进场地/店铺详情 -->
        <view
          wx:if="{{item.venueName}}"
          class="feed-place"
          hover-class="hv"
          catchtap="goFeedPlace"
          data-id="{{item.venueId}}"
          data-kind="{{item.kind}}"
        >{{item.venueName}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 地图卡片（圆角容器 + 城市计数 chip；可折叠：点分隔手柄切换；实例保留不销毁；改版默认收起） -->
  <view class="map-card">
    <map
      id="map"
      class="map {{mapCollapsed ? 'map-collapsed' : ''}}"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="{{scale}}"
      markers="{{markers}}"
      show-location
      bindmarkertap="onMarkerTap"
    >
      <!-- 城市场地计数（设计稿：绿点 + 深色胶囊；折叠态隐藏避免溢出）。真机 cover-view flex/gap 会截断文字，文本直接撑开 -->
      <cover-view wx:if="{{!mapCollapsed}}" class="map-chip">{{mapChip}}<cover-view class="map-chip-dot"></cover-view></cover-view>
      <!-- 定位中提示 -->
      <cover-view wx:if="{{locating}}" class="locating-tip">正在定位当前位置...</cover-view>
      <!-- 定位按钮：回到当前位置并匹配城市（设计稿：地图右上白底圆钮；准星用 cover-view 原生绘制，真机 cover-image 不支持 SVG） -->
      <cover-view wx:if="{{!mapCollapsed}}" class="locate-btn" aria-role="button" aria-label="回到当前定位" bindtap="onTapLocate">
        <cover-view class="locate-ico">
          <cover-view class="locate-ring"></cover-view>
          <cover-view class="locate-dot"></cover-view>
          <cover-view class="locate-tick locate-tick-n"></cover-view>
          <cover-view class="locate-tick locate-tick-s"></cover-view>
          <cover-view class="locate-tick locate-tick-w"></cover-view>
          <cover-view class="locate-tick locate-tick-e"></cover-view>
        </cover-view>
      </cover-view>
    </map>
    <!-- 折叠手柄：点按收起/展开地图（地图实例保留不销毁） -->
    <view class="map-handle" hover-class="hv" bindtap="toggleMap" aria-role="button" aria-label="{{mapCollapsed ? '展开地图' : '收起地图'}}">
      <view class="map-handle-bar"></view>
    </view>
  </view>

  <!-- 整合面板：一级轨道 + 二级筛选 + 三级列表同底一体（分隔线划层次） -->
  <view class="panel">
    <!-- 一级 + 二级（面板内控制区） -->
    <view class="control-panel">
      <!-- 一级 Tab：场地 / 板店 / 俱乐部 / 培训机构（文字 Tab + 橙色短指示条，轻导航让位内容） -->
      <view class="entity-seg" aria-role="tablist">
        <view
          wx:for="{{tabs}}"
          wx:key="key"
          class="entity-item {{activeTab === item.key ? 'entity-active' : ''}}"
          hover-class="hv"
          aria-role="tab"
          data-tab="{{item.key}}"
          bindtap="switchEntity"
        >
          <text>{{item.label}}</text>
          <view class="entity-bar"></view>
        </view>
      </view>

      <!-- 二级筛选：场地=类型 chips；机构 Tab 类型已锁定，只留服务 chips；右缘渐隐提示可横向滚动 -->
      <view wx:if="{{entity === 'venue'}}" class="filters-wrap">
        <scroll-view class="filters" scroll-x enhanced show-scrollbar="{{false}}">
          <view
            wx:for="{{filters}}"
            wx:key="*this"
            class="filter-chip {{filter === item ? 'filter-chip-active' : ''}}"
            hover-class="hv"
            data-filter="{{item}}"
            bindtap="pickFilter"
          >{{item}}</view>
        </scroll-view>
        <view class="filters-fade"></view>
      </view>
      <view wx:if="{{svcFilters.length}}" class="filters-wrap">
        <scroll-view class="filters" scroll-x enhanced show-scrollbar="{{false}}">
          <view
            class="filter-chip {{!svcFilter ? 'filter-chip-active' : ''}}"
            hover-class="hv"
            data-filter="全部"
            bindtap="pickSvc"
            aria-role="button"
            aria-label="全部服务"
          >全部</view>
          <view
            wx:for="{{svcFilters}}"
            wx:key="*this"
            class="filter-chip {{svcFilter === item ? 'filter-chip-active' : ''}}"
            hover-class="hv"
            data-filter="{{item}}"
            bindtap="pickSvc"
            aria-role="button"
            aria-label="按{{item}}筛选"
          >{{item}}</view>
        </scroll-view>
        <view class="filters-fade"></view>
      </view>
    </view>

    <!-- 三级列表（行化：去卡融入面板，行间分隔线） -->
    <view class="list">
      <!-- 骨架屏（云数据返回前，按真实卡片结构：左图 + 4 行） -->
      <block wx:if="{{!loaded}}">
        <view wx:for="{{[0,1,2]}}" wx:key="*this" class="list-item">
          <view class="skel-card">
            <view class="skel-thumb"></view>
            <view class="skel-body">
              <view class="skel-line skel-w60"></view>
              <view class="skel-line skel-w80"></view>
              <view class="skel-line skel-w40"></view>
              <view class="skel-line skel-w50"></view>
            </view>
          </view>
        </view>
      </block>

      <block wx:elif="{{entity === 'venue'}}">
        <view wx:for="{{list}}" wx:key="id" class="list-item" data-id="{{item.id}}" bindtap="syncSelection">
          <venue-card
            venue="{{item}}"
            online="{{item.online}}"
            checked="{{item.checked}}"
            checked-time="{{item.checkedTime}}"
            index="{{index}}"
          />
        </view>
        <view wx:if="{{empty}}" class="empty">
          <image class="empty-icon" src="{{icons.venueFog}}" mode="aspectFit" />
          <text class="empty-text">{{query ? '没有找到「' + query + '」相关的场地' : '暂无' + filter + '类型的场地'}}</text>
          <view wx:if="{{query}}" class="empty-action" hover-class="hv" bindtap="clearQuery">清除搜索</view>
          <view wx:elif="{{filter !== '全部'}}" class="empty-action" hover-class="hv" bindtap="resetFilter">查看全部类型</view>
          <view wx:else class="empty-action" hover-class="hv" bindtap="goCityPicker">切换城市</view>
          <view class="empty-submit" hover-class="hv" bindtap="goRecommend">知道这里有什么场地？来推荐</view>
        </view>
        <view wx:if="{{!empty}}" class="loadmore">
          <text>{{loadmoreText}}</text>
        </view>
      </block>

      <block wx:else>
        <view wx:for="{{list}}" wx:key="id" class="list-item" data-id="{{item.id}}" bindtap="syncSelection">
          <shop-card
            shop="{{item}}"
            index="{{index}}"
            bind:go="goDetail"
          />
        </view>
        <view wx:if="{{empty}}" class="empty">
          <image class="empty-icon" src="{{icons.venueFog}}" mode="aspectFit" />
          <text class="empty-text">{{query ? '没有找到「' + query + '」相关的' + entityLabel : '暂无' + entityLabel + (svcFilter ? '（提供「' + svcFilter + '」服务）' : '')}}</text>
          <view wx:if="{{query}}" class="empty-action" hover-class="hv" bindtap="clearQuery">清除搜索</view>
          <view wx:elif="{{svcFilter}}" class="empty-action" hover-class="hv" bindtap="resetFilter">查看全部服务</view>
          <view wx:else class="empty-action" hover-class="hv" bindtap="goCityPicker">切换城市</view>
          <view class="empty-submit" hover-class="hv" bindtap="goRecommend">知道这里有什么{{entityLabel}}？来推荐</view>
        </view>
        <view wx:if="{{!empty}}" class="loadmore">
          <text>{{loadmoreText}}</text>
        </view>
      </block>

      <!-- 推荐入口：列表非空时底部轻量引导（场地/机构共用） -->
      <view wx:if="{{loaded && !empty}}" class="submit-line" hover-class="hv" bindtap="goRecommend">
        <text class="submit-line-text">还有漏掉的{{entityLabel === '场地' ? '场地、门店与俱乐部' : entityLabel}}？</text>
        <text class="submit-line-cta">推荐给我们</text>
      </view>
    </view>
  </view>
</view>

<!-- 打卡媒体查看器（微博式：图视频混滑、视频封面点播；与发现页同组件） -->
<media-viewer
  visible="{{viewerShow}}"
  sources="{{viewerSources}}"
  current="{{viewerCurrent}}"
  bind:close="onViewerClose"
/>

