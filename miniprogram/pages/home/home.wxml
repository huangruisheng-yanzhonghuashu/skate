<view class="page">
  <!-- 头部：定位 + 搜索 -->
  <view class="header">
    <view wx:if="{{!searchOpen}}" class="header-row">
      <view class="city" hover-class="hv" bindtap="goCityPicker" aria-role="button" aria-label="选择城市">
        <image class="city-pin" src="{{icons.pinOrange}}" mode="aspectFit" />
        <text>{{city}}</text>
        <image class="city-swap" src="{{icons.swap}}" mode="aspectFit" />
      </view>
      <view class="search-pill" hover-class="hv" bindtap="openSearch">
        <image class="search-icon" src="{{icons.search}}" mode="aspectFit" />
        <text class="search-pill-text">搜索场地、俱乐部、门店...</text>
      </view>
    </view>

    <view wx:else class="header-row">
      <view class="search-input-wrap">
        <image class="search-icon" src="{{icons.search}}" mode="aspectFit" />
        <input
          class="search-input"
          value="{{query}}"
          focus
          confirm-type="search"
          placeholder="搜索场地、俱乐部、门店..."
          placeholder-class="search-ph"
          bindinput="onQueryInput"
        />
        <view wx:if="{{query}}" class="search-clear" hover-class="hv" aria-role="button" aria-label="清空搜索" bindtap="clearQuery">
          <image class="search-clear-icon" src="{{icons.xWhite}}" mode="aspectFit" />
        </view>
      </view>
      <view class="search-cancel" hover-class="hv" bindtap="closeSearch">取消</view>
    </view>
  </view>

  <!-- 地图卡片（圆角容器 + 城市计数 chip；可折叠：点分隔手柄切换；实例保留不销毁） -->
  <view class="map-card">
    <map
      id="map"
      class="map {{mapCollapsed ? 'map-collapsed' : ''}}"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="{{scale}}"
      markers="{{markers}}"
      show-location
      bindmarkertap="onMarkerTap"
    >
      <!-- 城市场地计数（设计稿：绿点 + 深色胶囊；折叠态隐藏避免溢出）。真机 cover-view flex/gap 会截断文字，文本直接撑开 -->
      <cover-view wx:if="{{!mapCollapsed}}" class="map-chip">{{city}} · {{mapCount}} 个{{entity === 'shop' ? '门店与俱乐部' : '滑板场地'}}<cover-view class="map-chip-dot"></cover-view></cover-view>
      <!-- 定位中提示 -->
      <cover-view wx:if="{{locating}}" class="locating-tip">正在定位当前位置...</cover-view>
      <!-- 定位按钮：回到当前位置并匹配城市（设计稿：地图右上白底圆钮；准星用 cover-view 原生绘制，真机 cover-image 不支持 SVG） -->
      <cover-view wx:if="{{!mapCollapsed}}" class="locate-btn" aria-role="button" aria-label="回到当前定位" bindtap="onTapLocate">
        <cover-view class="locate-ico">
          <cover-view class="locate-ring"></cover-view>
          <cover-view class="locate-dot"></cover-view>
          <cover-view class="locate-tick locate-tick-n"></cover-view>
          <cover-view class="locate-tick locate-tick-s"></cover-view>
          <cover-view class="locate-tick locate-tick-w"></cover-view>
          <cover-view class="locate-tick locate-tick-e"></cover-view>
        </cover-view>
      </cover-view>
    </map>
    <!-- 折叠手柄：点按收起/展开地图（地图实例保留不销毁） -->
    <view class="map-handle" hover-class="hv" bindtap="toggleMap" aria-role="button" aria-label="{{mapCollapsed ? '展开地图' : '收起地图'}}">
      <view class="map-handle-bar"></view>
    </view>
  </view>

  <!-- 整合面板：一级轨道 + 二级筛选 + 三级列表同底一体（分隔线划层次） -->
  <view class="panel">
    <!-- 一级 + 二级（面板内控制区） -->
    <view class="control-panel">
      <!-- 实体切换：场地 / 俱乐部（文字 Tab + 橙色短指示条，轻导航让位内容） -->
      <view class="entity-seg" aria-role="tablist">
        <view class="entity-item {{entity === 'venue' ? 'entity-active' : ''}}" hover-class="hv" aria-role="tab" data-entity="venue" bindtap="switchEntity">
          <text>滑板场地</text>
          <view class="entity-bar"></view>
        </view>
        <view class="entity-item {{entity === 'shop' ? 'entity-active' : ''}}" hover-class="hv" aria-role="tab" data-entity="shop" bindtap="switchEntity">
          <text>门店与俱乐部</text>
          <view class="entity-bar"></view>
        </view>
      </view>

      <!-- 快捷筛选：一级=类型（场地）/ category 三分（机构），二级=服务（仅机构）；右缘渐隐提示可横向滚动 -->
      <view class="filters-wrap">
        <scroll-view class="filters" scroll-x enhanced show-scrollbar="{{false}}">
          <view
            wx:for="{{filters}}"
            wx:key="*this"
            class="filter-chip {{filter === item ? 'filter-chip-active' : ''}}"
            hover-class="hv"
            data-filter="{{item}}"
            bindtap="pickFilter"
          >{{item}}</view>
        </scroll-view>
        <view class="filters-fade"></view>
      </view>
      <view wx:if="{{svcFilters.length}}" class="filters-wrap">
        <scroll-view class="filters filters-svc" scroll-x enhanced show-scrollbar="{{false}}">
          <view
            wx:for="{{svcFilters}}"
            wx:key="*this"
            class="filter-chip filter-chip-sm {{svcFilter === item ? 'filter-chip-active' : ''}}"
            hover-class="hv"
            data-filter="{{item}}"
            bindtap="pickSvc"
            aria-role="button"
            aria-label="按{{item}}筛选"
          >{{item}}</view>
        </scroll-view>
        <view class="filters-fade"></view>
      </view>
    </view>

    <!-- 三级列表（行化：去卡融入面板，行间分隔线） -->
    <view class="list">
      <!-- 骨架屏（云数据返回前，按真实卡片结构：左图 + 4 行） -->
      <block wx:if="{{!loaded}}">
        <view wx:for="{{[0,1,2]}}" wx:key="*this" class="list-item">
          <view class="skel-card">
            <view class="skel-thumb"></view>
            <view class="skel-body">
              <view class="skel-line skel-w60"></view>
              <view class="skel-line skel-w80"></view>
              <view class="skel-line skel-w40"></view>
              <view class="skel-line skel-w50"></view>
            </view>
          </view>
        </view>
      </block>

      <block wx:elif="{{entity === 'venue'}}">
        <view wx:for="{{list}}" wx:key="id" class="list-item" data-id="{{item.id}}" bindtap="syncSelection">
          <venue-card
            venue="{{item}}"
            online="{{item.online}}"
            checked="{{item.checked}}"
            checked-time="{{item.checkedTime}}"
            index="{{index}}"
          />
        </view>
        <view wx:if="{{empty}}" class="empty">
          <image class="empty-icon" src="{{icons.venueFog}}" mode="aspectFit" />
          <text class="empty-text">{{query ? '没有找到「' + query + '」相关的场地' : '暂无' + filter + '类型的场地'}}</text>
          <view wx:if="{{query}}" class="empty-action" hover-class="hv" bindtap="clearQuery">清除搜索</view>
          <view wx:elif="{{filter !== '全部'}}" class="empty-action" hover-class="hv" bindtap="resetFilter">查看全部类型</view>
          <view wx:else class="empty-action" hover-class="hv" bindtap="goCityPicker">切换城市</view>
          <view class="empty-submit" hover-class="hv" bindtap="goRecommend">知道这里有什么场地？来推荐</view>
        </view>
        <view wx:if="{{!empty}}" class="loadmore">
          <text>已展示{{city}}全部 {{list.length}} 个场地</text>
        </view>
      </block>

      <block wx:else>
        <view wx:for="{{list}}" wx:key="id" class="list-item" data-id="{{item.id}}" bindtap="syncSelection">
          <shop-card
            shop="{{item}}"
            index="{{index}}"
            bind:go="goDetail"
          />
        </view>
        <view wx:if="{{empty}}" class="empty">
          <image class="empty-icon" src="{{icons.venueFog}}" mode="aspectFit" />
          <text class="empty-text">{{query ? '没有找到「' + query + '」相关的门店与俱乐部' : (filter !== '全部' ? '暂无' + filter + '类型的门店与俱乐部' : (svcFilter ? '暂无提供「' + svcFilter + '」服务的门店与俱乐部' : '暂无门店与俱乐部数据'))}}</text>
          <view wx:if="{{query}}" class="empty-action" hover-class="hv" bindtap="clearQuery">清除搜索</view>
          <view wx:elif="{{filter !== '全部' || svcFilter}}" class="empty-action" hover-class="hv" bindtap="resetFilter">查看全部</view>
          <view wx:else class="empty-action" hover-class="hv" bindtap="goCityPicker">切换城市</view>
          <view class="empty-submit" hover-class="hv" bindtap="goRecommend">知道这里有什么门店与俱乐部？来推荐</view>
        </view>
        <view wx:if="{{!empty}}" class="loadmore">
          <text>已展示{{city}}全部 {{list.length}} 家门店与俱乐部</text>
        </view>
      </block>

      <!-- 推荐入口：列表非空时底部轻量引导（场地/店铺共用） -->
      <view wx:if="{{loaded && !empty}}" class="submit-line" hover-class="hv" bindtap="goRecommend">
        <text class="submit-line-text">还有漏掉的场地、门店与俱乐部？</text>
        <text class="submit-line-cta">推荐给我们</text>
      </view>
    </view>
  </view>
</view>
