.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.header {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #111114;
  padding: 0 32rpx;
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between; /* 设计稿：城市贴左、搜索胶囊贴右 */
  gap: 24rpx;
  height: 88rpx;
}

.city-wrap {
  position: relative;
  flex-shrink: 0;
}

.city {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}

.city-pin {
  width: 28rpx;
  height: 28rpx;
}

/* 城市下拉箭头：与 pin 同尺寸（设计稿 14×14px，白色） */
.city-chevron {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.city-pop {
  position: absolute;
  left: 0;
  top: 64rpx;
  z-index: 30;
  width: 224rpx;
  background: #1E1E23;
  border: 1rpx solid #26262C;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
}

.city-item {
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  color: #D9D9DE;
}

.city-item-active {
  background: rgba(255, 90, 54, 0.16);
  color: #FF8A6E;
  font-weight: 500;
}

.search-pill {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #1E1E23;
  color: #6E6E76;
  font-size: 26rpx;
  overflow: hidden;
}

/* 胶囊占位文字：单行截断（同设计稿 truncate） */
.search-pill-text {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #1E1E23;
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 26rpx;
  color: #FFFFFF;
}

/* 输入框占位符颜色（同胶囊文字） */
.search-ph {
  color: #6E6E76;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(140, 140, 148, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-clear-icon {
  width: 24rpx;
  height: 24rpx;
}

.search-cancel {
  flex-shrink: 0;
  color: #8C8C94;
  font-size: 28rpx;
}

/* ===== 地图卡片（圆角容器，与设计稿一致） ===== */
.map-card {
  margin: 8rpx 32rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: #1E1E23;
  border: 1rpx solid #26262C;
}

.map {
  width: 100%;
  height: 40vh;
  min-height: 480rpx;
}

/* 城市场地计数 chip（左上，绿点 + 深色胶囊，设计稿同款）。
   真机 cover-view 不支持 flex 的 gap、flex 子项文本宽度易计算塌陷导致截断：
   改为文本直接撑开胶囊 + 绿点绝对定位 */
.map-chip {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 12rpx 24rpx 12rpx 44rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 20, 0.88);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
  white-space: nowrap;
}

.map-chip-dot {
  position: absolute;
  left: 24rpx;
  top: 50%;
  margin-top: -6rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #00D4AA;
}

/* 回到当前定位按钮（设计稿：地图右上白底圆钮 + 浅灰描边 + 深色准星） */
.locate-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid #E8E8E8;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 30, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 准星：cover-view 原生绘制（真机 cover-image 不支持 SVG，会渲染成异常占位图）。
   几何按设计稿 24 viewBox × 1.5rpx 换算：圆环 r=7/描边2、中心点 r=1.2、刻度长3/宽2 */
.locate-ico {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.locate-ring {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #1A1A1E;
  border-radius: 50%;
}

.locate-dot {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #1A1A1E;
}

.locate-tick {
  position: absolute;
  width: 3rpx;
  height: 4rpx;
  background: #1A1A1E;
}

.locate-tick-n { left: 16.5rpx; top: 3rpx; }
.locate-tick-s { left: 16.5rpx; top: 29rpx; }
.locate-tick-w { left: 3rpx; top: 16.5rpx; width: 4rpx; height: 3rpx; }
.locate-tick-e { left: 29rpx; top: 16.5rpx; width: 4rpx; height: 3rpx; }

/* ===== 控制面板（一级轨道 + 二级筛选同卡打包，解决层次脱节） ===== */
.control-panel {
  margin: 32rpx 32rpx 0;
  padding: 24rpx 20rpx 8rpx;
  background: #1E1E23;
  border-radius: 24rpx;
}

/* ===== 实体切换（面板内嵌轨道：深一档底色 + 橙渐变 active 半区） ===== */
.entity-seg {
  display: flex;
  padding: 8rpx;
  background: #17171B;
  border-radius: 999rpx;
}

.entity-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  color: #8C8C94;
  font-size: 28rpx;
}

.entity-active {
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== 地图折叠 ===== */
.map {
  transition: height 0.3s ease;
  overflow: hidden;
}

.map-collapsed {
  height: 0 !important;
}

/* ===== 定位中提示（地图浮层） ===== */
.locating-tip {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(17, 17, 20, 0.85);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
}

/* ===== 骨架屏（按真实卡片结构：左图通铺 + 内容区） ===== */
.skel-card {
  display: flex;
  gap: 0;
  padding: 0;
  background: #1E1E23;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.skel-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx 0 0 20rpx;
  flex-shrink: 0;
}

.skel-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  justify-content: center;
  padding: 20rpx 24rpx;
}

.skel-line {
  height: 24rpx;
  border-radius: 8rpx;
}

.skel-w60 { width: 60%; }
.skel-w80 { width: 80%; }
.skel-w40 { width: 40%; }
.skel-w50 { width: 50%; }

.skel-card .skel-icon,
.skel-card .skel-line {
  background: linear-gradient(90deg, #232329 25%, #2A2A31 50%, #232329 75%);
  background-size: 200% 100%;
  animation: skel-shine 1.2s ease infinite;
}

@keyframes skel-shine {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}

/* ===== 筛选（面板内第二行，与一级紧凑绑定；透明底描边，激活浅橙） ===== */
.filters {
  background: transparent;
  padding: 20rpx 8rpx 12rpx;
  white-space: nowrap;
}

.filter-chip {
  display: inline-block;
  height: 48rpx;
  line-height: 46rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  border: 2rpx solid #26262C;
  box-sizing: border-box;
  background: transparent;
  color: #A6A6AD;
  font-size: 24rpx;
  font-weight: 400;
}

.filter-chip-active {
  border-color: rgba(255, 90, 54, 0.55);
  background: rgba(255, 90, 54, 0.14);
  color: #FF8A6E;
  font-weight: 500;
}

/* ===== 列表 ===== */
.list {
  flex: 1;
  padding: 24rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 三级列表首卡与面板适度衔接（既同宽对齐，又有分组呼吸感） */

/* 列表收尾提示 */
.loadmore {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx 0 8rpx;
  color: #8C8C94;
  font-size: 24rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 112rpx 0;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8C8C94;
}
