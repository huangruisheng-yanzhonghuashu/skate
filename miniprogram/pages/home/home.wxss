.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 通用按压态 */
.hv {
  opacity: 0.7;
}

/* ===== 头部 ===== */
.header {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #111114;
  padding: 0 32rpx 38rpx;
}

/* 导航行 */
.nav-row {
  margin: 0 -32rpx;
  background: #111114;
}

.nav-row-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.city {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}

.city-pin {
  width: 24rpx;
  height: 24rpx;
}

.city-swap {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
}

/* 在线热度胶囊（位于 slogan 右侧） */
.heat {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #1E1E23;
  border: 1rpx solid rgba(255, 90, 54, 0.4);
  flex-shrink: 0;
  margin-left: 20rpx;
}

.heat-quiet {
  border-color: #26262C;
  background: #1E1E23;
}

.heat-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #00D4AA;
  animation: heat-pulse 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
}

.heat-dot-quiet {
  background: #3A3A42;
  animation: none;
}

@keyframes heat-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.3); }
}

.heat-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.5;
}

.heat-label {
  font-size: 22rpx;
  color: #A6A6AD;
  line-height: 1;
}

/* 品牌态度区 */
.brand {
  margin-top: 16rpx;
}

.brand-wordmark {
  font-size: 84rpx;
  font-weight: 700;
  font-style: italic;
  color: #FFFFFF;
  line-height: 1.25;
  letter-spacing: -2rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  gap: 16rpx;
}

.brand-slogan {
  flex: 1;
  min-width: 0;
  font-size: 42rpx;
  font-weight: 500;
  color: #FF5A36;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.brand-bar {
  width: 120rpx;
  height: 12rpx;
  margin-top: 32rpx;
  border-radius: 999rpx;
  background: #FF5A36;
}

/* ===== 搜索（面板内） ===== */
.panel-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 72rpx;
  padding: 0 28rpx;
  margin-bottom: 30rpx;
  border-radius: 999rpx;
  background: #17171B;
  color: #6E6E76;
  font-size: 26rpx;
  overflow: hidden;
}

.panel-search-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.search-pill-text {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #17171B;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
  color: #FFFFFF;
}

.search-ph {
  color: #6E6E76;
}

.search-clear {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(140, 140, 148, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-clear-icon {
  width: 24rpx;
  height: 24rpx;
}

.search-cancel {
  flex-shrink: 0;
  color: #8C8C94;
  font-size: 28rpx;
  padding: 20rpx 8rpx 20rpx 16rpx;
  margin: -20rpx -8rpx -20rpx -16rpx;
}

/* ===== 地图入口卡片 ===== */
.map-entry {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 38rpx 32rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #1E1E23;
  border: 1rpx solid #26262C;
}

.map-entry-thumb {
  position: relative;
  width: 152rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: #26262C;
  overflow: hidden;
}

.map-entry-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.35;
  background-image:
    repeating-linear-gradient(0deg, transparent, transparent 14rpx, #3A3A42 14rpx, #3A3A42 15rpx),
    repeating-linear-gradient(90deg, transparent, transparent 14rpx, #3A3A42 14rpx, #3A3A42 15rpx);
}

.map-entry-pin {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24rpx;
  height: 24rpx;
  margin: -12rpx 0 0 -12rpx;
  border-radius: 50%;
  background: #FF5A36;
}

.map-entry-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.map-entry-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.map-entry-sub {
  font-size: 24rpx;
  color: #8C8C94;
}

.map-entry-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 90, 54, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.map-entry-arrow-icon {
  width: 28rpx;
  height: 28rpx;
}

/* ===== 半屏地图 bottom-sheet ===== */
.map-sheet {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  animation: sheet-fade-in 0.25s ease-out;
}

@keyframes sheet-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.map-sheet-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
}

.map-sheet-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 65vh;
  background: #1E1E23;
  border-radius: 32rpx 32rpx 0 0;
  border-top: 1rpx solid #26262C;
  padding-bottom: env(safe-area-inset-bottom);
  animation: sheet-up 0.25s ease-out;
  overflow: hidden;
}

@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.map-sheet-map {
  width: 100%;
  height: 100%;
}

/* 顶部操作区：放在 map 内部的 cover-view 里，避免被原生 map 覆盖 */
.sheet-top-cover {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1;
  background: rgba(30, 30, 35, 0.96);
  border-bottom: 1rpx solid #26262C;
}

.sheet-handle-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 16rpx;
  padding-bottom: 12rpx;
}

.sheet-bar-cover {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #2A2A31;
}

.sheet-head-cover {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
}

.sheet-title-cover {
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1.4;
}

.sheet-close-cover {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid #26262C;
  color: #8C8C94;
  font-size: 24rpx;
  line-height: 1.4;
}

/* 地图内 chip */
.map-chip {
  position: absolute;
  top: 140rpx;
  left: 20rpx;
  padding: 12rpx 24rpx 12rpx 44rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 20, 0.88);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
  white-space: nowrap;
}

.map-chip-dot {
  position: absolute;
  left: 24rpx;
  top: 50%;
  margin-top: -6rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #00D4AA;
}

/* 定位中提示 */
.locating-tip {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(17, 17, 20, 0.85);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
}

/* 回到当前定位按钮 */
.locate-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid #E8E8E8;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 30, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

.locate-ico {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.locate-ring {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #1A1A1E;
  border-radius: 50%;
}

.locate-dot {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #1A1A1E;
}

.locate-tick {
  position: absolute;
  width: 3rpx;
  height: 4rpx;
  background: #1A1A1E;
}

.locate-tick-n { left: 16.5rpx; top: 3rpx; }
.locate-tick-s { left: 16.5rpx; top: 29rpx; }
.locate-tick-w { left: 3rpx; top: 16.5rpx; width: 4rpx; height: 3rpx; }
.locate-tick-e { left: 29rpx; top: 16.5rpx; width: 4rpx; height: 3rpx; }

/* ===== 整合面板 ===== */
.panel {
  margin: 38rpx 32rpx 0;
}

.control-panel {
  padding: 0 0 16rpx;
}

/* 一级 Tab */
.entity-seg {
  display: flex;
  gap: 40rpx;
}

.entity-item {
  position: relative;
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0;
  font-size: 30rpx;
  color: #A6A6AD;
  transition: color 0.2s ease;
}

.entity-active {
  color: #FFFFFF;
  font-weight: 500;
}

.entity-bar {
  position: absolute;
  left: 50%;
  bottom: 2rpx;
  width: 48rpx;
  height: 6rpx;
  margin-left: -24rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FF5A36, #FF8A6E);
  opacity: 0;
  transform: scaleX(0.5);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.entity-active .entity-bar {
  opacity: 1;
  transform: scaleX(1);
}

/* ===== 骨架屏 ===== */
.skel-card {
  display: flex;
  gap: 0;
  padding: 0;
  background: transparent;
  overflow: hidden;
}

.skel-thumb {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.skel-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  justify-content: center;
  padding: 20rpx 24rpx;
}

.skel-line {
  height: 24rpx;
  border-radius: 8rpx;
}

.skel-w60 { width: 60%; }
.skel-w80 { width: 80%; }
.skel-w40 { width: 40%; }
.skel-w50 { width: 50%; }

.skel-card .skel-icon,
.skel-card .skel-line {
  background: linear-gradient(90deg, #232329 25%, #2A2A31 50%, #232329 75%);
  background-size: 200% 100%;
  animation: skel-shine 1.2s ease infinite;
}

@keyframes skel-shine {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}

/* ===== 筛选 ===== */
.filters-wrap {
  position: relative;
}

.filters {
  background: transparent;
  padding: 24rpx 8rpx 16rpx;
  white-space: nowrap;
}

.filters-fade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 48rpx;
  background: linear-gradient(90deg, rgba(17, 17, 20, 0), #111114);
  pointer-events: none;
}

.filter-chip {
  display: inline-block;
  height: 56rpx;
  line-height: 52rpx;
  padding: 0 24rpx;
  margin-right: 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid #26262C;
  box-sizing: border-box;
  background: transparent;
  color: #A6A6AD;
  font-size: 24rpx;
  font-weight: 400;
}

.filter-chip-active {
  border-color: rgba(255, 90, 54, 0.55);
  background: rgba(255, 90, 54, 0.14);
  color: #FF8A6E;
  font-weight: 500;
}

/* ===== 列表 ===== */
/* 列表项卡片化：恢复 venue-card 默认圆角与背景，间距由 list-item 控制；左右不留白，与 Tab/筛选对齐到 32rpx 基准线 */
.list-item {
  margin: 0 0 20rpx;
  padding: 0;
  border-top: none;
  border-radius: 24rpx;
  overflow: hidden;
}

/* 场地卡片视觉刷新：类型首标签高亮（组件内已处理，此处兜底） */
.panel .card .tag:first-child {
  background: rgba(255, 90, 54, 0.14);
  color: #FF8A6E;
}

/* 店铺行按压态 */
.panel .shop-card.shop-hover {
  background: #26262C;
}

.loadmore {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx 0 20rpx;
  color: #8C8C94;
  font-size: 24rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 112rpx 0;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8C8C94;
}

.empty-action {
  margin-top: 8rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 90, 54, 0.55);
  background: rgba(255, 90, 54, 0.14);
  color: #FF8A6E;
  font-size: 26rpx;
  font-weight: 500;
}

.empty-submit {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8C8C94;
}

.empty-submit:active {
  opacity: 0.7;
}

.submit-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 8rpx 0 40rpx;
}

.submit-line-text {
  font-size: 24rpx;
  color: #6E6E76;
}

.submit-line-cta {
  font-size: 24rpx;
  font-weight: 600;
  color: #FF8A6E;
}

/* ===== 最新打卡 ===== */
.feed-sec {
  margin-top: 24rpx;
}

.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 32rpx 24rpx;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.sec-sub {
  font-size: 22rpx;
  color: #8C8C94;
}

.feed-scroll {
  white-space: nowrap;
  padding-left: 32rpx;
}

.feed-card {
  display: inline-flex;
  flex-direction: column;
  width: 328rpx;
  margin-right: 24rpx;
  background: #1E1E23;
  border: 1rpx solid #26262C;
  border-radius: 20rpx;
  overflow: hidden;
  vertical-align: top;
  animation: feed-in 0.25s ease backwards;
}

@keyframes feed-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.feed-cover {
  position: relative;
  width: 328rpx;
  height: 212rpx;
  background: #111114;
}

.feed-cover-media {
  width: 100%;
  height: 100%;
}

.feed-cover-text {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.feed-cover-text text {
  font-size: 26rpx;
  color: #A6A6AD;
  line-height: 1.5;
  white-space: normal;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.feed-play {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 72rpx;
  height: 72rpx;
  margin: -36rpx 0 0 -36rpx;
  border-radius: 50%;
  background: rgba(17, 17, 20, 0.55);
  backdrop-filter: blur(2rpx);
}

.feed-play::after {
  content: '';
  position: absolute;
  left: 28rpx;
  top: 24rpx;
  border-style: solid;
  border-width: 12rpx 0 12rpx 20rpx;
  border-color: transparent transparent transparent #FFFFFF;
}

.feed-note {
  padding: 20rpx 24rpx 0;
  font-size: 24rpx;
  color: #D9D9DE;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 24rpx 0;
}

.feed-avatar-wrap {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.feed-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.feed-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2A2A31;
  color: #8C8C94;
  font-size: 20rpx;
}

.feed-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #D9D9DE;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #6E6E76;
}

.feed-place {
  padding: 12rpx 24rpx 24rpx;
  font-size: 24rpx;
  color: #FF8A6E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 系统减弱动效适配 ===== */
@media (prefers-reduced-motion: reduce) {
  .heat-dot { animation: none; }
  .feed-card { animation: none; }
  .map-sheet-body { animation: none; }
  .entity-bar { transition: none; }
}
