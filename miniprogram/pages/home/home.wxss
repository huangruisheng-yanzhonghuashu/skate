.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.header {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #111114;
  padding: 0 32rpx;
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between; /* 设计稿：城市贴左、搜索胶囊贴右 */
  gap: 24rpx;
  height: 88rpx;
}

.city {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}

.city-pin {
  width: 28rpx;
  height: 28rpx;
}

/* 城市切换图标（⇌）：与 pin 同尺寸（设计稿 14×14px，白色） */
.city-swap {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.search-pill {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #1E1E23;
  color: #6E6E76;
  font-size: 26rpx;
  overflow: hidden;
}

/* 胶囊占位文字：单行截断（同设计稿 truncate） */
.search-pill-text {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #1E1E23;
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 26rpx;
  color: #FFFFFF;
}

/* 输入框占位符颜色（同胶囊文字） */
.search-ph {
  color: #6E6E76;
}

.search-clear {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(140, 140, 148, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-clear-icon {
  width: 24rpx;
  height: 24rpx;
}

.search-cancel {
  flex-shrink: 0;
  color: #8C8C94;
  font-size: 28rpx;
  padding: 20rpx 8rpx 20rpx 16rpx;
  margin: -20rpx -8rpx -20rpx -16rpx;
}

/* ===== 地图卡片（圆角容器，与设计稿一致） ===== */
.map-card {
  margin: 8rpx 32rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: #1E1E23;
  border: 1rpx solid #26262C;
}

.map {
  width: 100%;
  height: 40vh;
  min-height: 480rpx;
  transition: height 0.3s ease;
  overflow: hidden;
}

/* 城市场地计数 chip（左上，绿点 + 深色胶囊，设计稿同款）。
   真机 cover-view 不支持 flex 的 gap、flex 子项文本宽度易计算塌陷导致截断：
   改为文本直接撑开胶囊 + 绿点绝对定位 */
.map-chip {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 12rpx 24rpx 12rpx 44rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 20, 0.88);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
  white-space: nowrap;
}

.map-chip-dot {
  position: absolute;
  left: 24rpx;
  top: 50%;
  margin-top: -6rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #00D4AA;
}

/* 回到当前定位按钮（设计稿：地图右上白底圆钮 + 浅灰描边 + 深色准星） */
.locate-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid #E8E8E8;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 30, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 准星：cover-view 原生绘制（真机 cover-image 不支持 SVG，会渲染成异常占位图）。
   几何按设计稿 24 viewBox × 1.5rpx 换算：圆环 r=7/描边2、中心点 r=1.2、刻度长3/宽2 */
.locate-ico {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.locate-ring {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #1A1A1E;
  border-radius: 50%;
}

.locate-dot {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #1A1A1E;
}

.locate-tick {
  position: absolute;
  width: 3rpx;
  height: 4rpx;
  background: #1A1A1E;
}

.locate-tick-n { left: 16.5rpx; top: 3rpx; }
.locate-tick-s { left: 16.5rpx; top: 29rpx; }
.locate-tick-w { left: 3rpx; top: 16.5rpx; width: 4rpx; height: 3rpx; }
.locate-tick-e { left: 29rpx; top: 16.5rpx; width: 4rpx; height: 3rpx; }

/* ===== 整合面板：一级 + 二级 + 三级列表同底一体（分隔线划层次） ===== */
.panel {
  margin: 32rpx 32rpx 0;
  background: #1E1E23;
  border-radius: 24rpx;
}

/* 面板内控制区：左右内边距 20rpx，与列表行左缘对齐 */
.control-panel {
  padding: 24rpx 20rpx 8rpx;
}

/* ===== 一级切换（文字 Tab + 橙色短指示条：靠左杂志式，与筛选/列表同轴） ===== */
.entity-seg {
  display: flex;
  gap: 24rpx;
  /* 抵消项内边距：首项文字精确落 20rpx 左轴（与列表行对齐） */
  margin: 0 -16rpx;
}

.entity-item {
  position: relative;
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 16rpx;
  font-size: 30rpx;
  color: #8C8C94;
  transition: color 0.2s ease;
}

.entity-active {
  color: #FFFFFF;
  font-weight: 700;
}

/* 橙色短指示条：仅 active 显示，切换时透明度+缩放过渡 */
.entity-bar {
  position: absolute;
  left: 50%;
  bottom: 2rpx;
  width: 48rpx;
  height: 6rpx;
  margin-left: -24rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FF5A36, #FF8A6E);
  opacity: 0;
  transform: scaleX(0.4);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.entity-active .entity-bar {
  opacity: 1;
  transform: scaleX(1);
}

/* ===== 地图折叠 ===== */
.map-collapsed {
  height: 0 !important;
}

/* 折叠手柄：地图卡片底部分隔条（点按切换折叠，折叠后作为展开入口保留） */
.map-handle {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  background: #1E1E23;
}

.map-handle-bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #2A2A31;
}

/* ===== 定位中提示（地图浮层） ===== */
.locating-tip {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(17, 17, 20, 0.85);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
}

/* ===== 骨架屏（按真实卡片结构：左图通铺 + 内容区；行化透明底融入面板） ===== */
.skel-card {
  display: flex;
  gap: 0;
  padding: 0;
  background: transparent;
  overflow: hidden;
}

.skel-thumb {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.skel-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  justify-content: center;
  padding: 20rpx 24rpx;
}

.skel-line {
  height: 24rpx;
  border-radius: 8rpx;
}

.skel-w60 { width: 60%; }
.skel-w80 { width: 80%; }
.skel-w40 { width: 40%; }
.skel-w50 { width: 50%; }

.skel-card .skel-icon,
.skel-card .skel-line {
  background: linear-gradient(90deg, #232329 25%, #2A2A31 50%, #232329 75%);
  background-size: 200% 100%;
  animation: skel-shine 1.2s ease infinite;
}

@keyframes skel-shine {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}

/* ===== 筛选（面板内第二行，与一级紧凑绑定；透明底描边，激活浅橙） ===== */
.filters {
  background: transparent;
  padding: 20rpx 8rpx 12rpx;
  white-space: nowrap;
}

.filter-chip {
  display: inline-block;
  height: 64rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  margin-right: 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid #26262C;
  box-sizing: border-box;
  background: transparent;
  color: #A6A6AD;
  font-size: 24rpx;
  font-weight: 400;
}

.filter-chip-active {
  border-color: rgba(255, 90, 54, 0.55);
  background: rgba(255, 90, 54, 0.14);
  color: #FF8A6E;
  font-weight: 500;
}

/* ===== 列表（面板内行化：去卡融入，分隔线划行，左缘与筛选区对齐） ===== */

/* 行：透明底 + 1rpx 分隔线（首行分隔线即二级/三级分组线）；左右 20rpx 与控制区对齐 */
.list-item {
  margin: 0 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #2A2A31;
}

/* 去卡化覆盖（卡片组件 apply-shared 且仅首页使用）：透明底融入面板 */
.panel .card,
.panel .shop-card {
  background: transparent;
  border-radius: 0;
}

/* venue 左图随行去「左圆右直角」（贴卡缘改为贴行缘方角） */
.panel .card .thumb {
  border-radius: 0;
}

/* 店铺行按压态：整行提亮（提升 specificity 覆盖，避免被去卡透明底压掉） */
.panel .shop-card.shop-hover {
  background: #26262C;
}

/* 列表收尾提示 */
.loadmore {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx 0 20rpx;
  color: #8C8C94;
  font-size: 24rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 112rpx 0;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8C8C94;
}
