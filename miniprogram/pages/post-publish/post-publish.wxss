/* 发布打卡：全局入口页（暗色主题，与全站一致） */
.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hover {
  opacity: 0.75;
}

/* ===== 字段 ===== */
.field {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 地点选择入口 */
.place-pick {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 28rpx 28rpx;
  border-radius: 20rpx;
  background: #1A1A1E;
  border: 2rpx dashed #2E2E34;
  color: #8C8C94;
  font-size: 28rpx;
}

.place-pick-icon {
  width: 32rpx;
  height: 32rpx;
}

.place-pick-arrow {
  margin-left: auto;
  font-size: 32rpx;
  color: #6E6E76;
}

/* 已选地点 chip */
.place-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 90, 54, 0.1);
  border: 2rpx solid rgba(255, 90, 54, 0.35);
}

.place-chip-icon {
  width: 32rpx;
  height: 32rpx;
}

.place-chip-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.place-chip-kind {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.16);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.2;
}

/* 留言 */
.note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.note-count {
  font-size: 22rpx;
  color: #6E6E76;
}

.textarea {
  width: 100%;
  min-height: 220rpx;
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: #1A1A1E;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.ph {
  color: #6E6E76;
}

/* ===== 媒体网格（微博式） ===== */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-tile {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-tile-img {
  width: 100%;
  height: 100%;
}

.photo-tile-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-tile-del-icon {
  width: 24rpx;
  height: 24rpx;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #1A1A1E;
  border: 2rpx dashed #2E2E34;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.photo-add-icon {
  width: 44rpx;
  height: 44rpx;
}

.photo-add-text {
  font-size: 22rpx;
  color: #8C8C94;
}

.photo-add-sub {
  font-size: 20rpx;
  color: #6E6E76;
}

/* ===== 发布按钮 ===== */
.publish-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 90, 54, 0.3);
}

.publish-btn-loading {
  opacity: 0.6;
}

.publish-btn-icon {
  width: 36rpx;
  height: 36rpx;
}

.publish-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #6E6E76;
  line-height: 1.6;
}

/* ===== 地点选择弹层 ===== */
.mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(0, 0, 0, 0.6);
}

.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #1A1A1E;
  border-radius: 32rpx 32rpx 0 0;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #26262C;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-close-icon {
  width: 28rpx;
  height: 28rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: #111114;
  margin-bottom: 24rpx;
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
}

.search-input {
  flex: 1;
  color: #FFFFFF;
  font-size: 28rpx;
}

.picker-list {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
}

.group-title {
  display: block;
  padding: 16rpx 8rpx 8rpx;
  font-size: 22rpx;
  color: #6E6E76;
}

.place-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid #232328;
}

.place-row-icon {
  width: 28rpx;
  height: 28rpx;
}

.place-row-name {
  flex: 1;
  font-size: 28rpx;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.place-row-kind {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #00D4AA;
  background: rgba(0, 212, 170, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.2;
}

.picker-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #6E6E76;
}
