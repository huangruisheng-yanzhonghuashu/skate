.page {
  padding: 32rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 页面大标题（设计稿同款） */
.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

/* ===== 统计行（设计稿：3 个独立小卡，数字大标签小） ===== */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: #1E1E23;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.stat-num-orange {
  color: #FF5A36;
}

.stat-label {
  font-size: 22rpx;
  color: #8C8C94;
}

/* ===== 个人卡片 ===== */
.profile {
  display: flex;
  align-items: center;
  gap: 32rpx;
  background: #1E1E23;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.profile-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 12rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #A6A6AD;
}

.meta-icon {
  width: 32rpx;
  height: 32rpx;
}

/* ===== 擅长标签 ===== */
.profile-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.profile-tag {
  font-size: 22rpx;
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.14);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  line-height: 1.4;
}

.edit-tags {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #26262C;
}

.edit-tags .edit-label {
  padding-top: 10rpx;
}

.tag-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-option {
  font-size: 26rpx;
  color: #A6A6AD;
  background: #26262C;
  border: 1rpx solid #26262C;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
  line-height: 1.4;
}

.tag-option-active {
  color: #FFFFFF;
  background: rgba(255, 90, 54, 0.2);
  border-color: #FF5A36;
}

.edit-tags-tip {
  font-size: 22rpx;
  color: #6E6E76;
  padding: 16rpx 0 0 136rpx;
}

/* ===== 菜单 ===== */
.menu {
  background: #1E1E23;
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #26262C;
}

.menu-item-last {
  border-bottom: none;
}

.menu-hover {
  background: rgba(255, 90, 54, 0.08);
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
}

.menu-label {
  font-size: 30rpx;
  color: #FFFFFF;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.menu-value {
  font-size: 28rpx;
  color: #8C8C94;
}

.menu-arrow {
  width: 32rpx;
  height: 32rpx;
}

/* ===== 最近签到 ===== */
.recent {
  margin-top: 32rpx;
}

.recent-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  padding: 24rpx 0 20rpx;
}

.recent-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #1E1E23;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.recent-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.recent-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-time {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #8C8C94;
}

/* ===== 资料头像与引导 ===== */
.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.profile-hover {
  background: #26262C;
}

.profile-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #FF8A6E;
}

.profile-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* ===== 编辑资料弹窗（居中卡片式，避开自定义 tabBar 层级遮挡） ===== */
.edit-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.6);
}

.edit-sheet {
  width: 100%;
  max-width: 600rpx;
  background: #1B1B20;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
  box-sizing: border-box;
  max-height: 80vh;
  overflow-y: auto;
}

/* 头部：标题居中 + 右上角关闭（触区 ≥44px） */
.edit-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.edit-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.edit-close {
  position: absolute;
  right: -12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 头像：居中大图 + 橙色相机角标（微信 chooseAvatar 能力） */
.avatar-edit {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  background: transparent;
  padding: 0;
  margin: 0 0 24rpx;
  line-height: 1;
  width: 100%;
}

.avatar-edit::after {
  border: none;
}

.avatar-edit-ring {
  position: relative;
  width: 152rpx;
  height: 152rpx;
}

.avatar-edit-img {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  display: block;
}

.avatar-edit-empty {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-edit-badge {
  position: absolute;
  right: 0;
  bottom: 4rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  border: 4rpx solid #1B1B20;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-edit-camera {
  width: 28rpx;
  height: 28rpx;
}

.avatar-edit-tip {
  font-size: 24rpx;
  color: #8C8C94;
}

/* 表单行：左标签 + 右内容（值/输入 + 箭头），整行可点 */
.edit-field {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #26262C;
}

.edit-field-hover {
  background: rgba(255, 90, 54, 0.06);
}

.edit-label {
  width: 112rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.edit-field-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.edit-value {
  font-size: 30rpx;
  color: #FFFFFF;
}

.edit-input {
  flex: 1;
  font-size: 30rpx;
  color: #FFFFFF;
}

.edit-count {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #6E6E76;
}

.edit-ph {
  color: #6E6E76;
}

.edit-chev {
  width: 32rpx;
  height: 32rpx;
}

.edit-save {
  margin-top: 48rpx;
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 8rpx 0;
}

.edit-save::after {
  border: none;
}

.edit-saving {
  opacity: 0.6;
}
