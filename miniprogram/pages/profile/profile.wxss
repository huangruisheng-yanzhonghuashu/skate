.page {
  padding: 32rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ===== 个人卡片 ===== */
.profile {
  display: flex;
  align-items: center;
  gap: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 30, 0.04);
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #FF5A36;
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1E;
}

.profile-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 12rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #4D4D4D;
}

.meta-icon {
  width: 32rpx;
  height: 32rpx;
}

/* ===== 菜单 ===== */
.menu {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 30, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item-last {
  border-bottom: none;
}

.menu-hover {
  background: #FFF2EE;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
}

.menu-label {
  font-size: 30rpx;
  color: #1A1A1E;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.menu-value {
  font-size: 28rpx;
  color: #8C8C8C;
}

.menu-arrow {
  width: 32rpx;
  height: 32rpx;
}

/* ===== 最近签到 ===== */
.recent {
  margin-top: 32rpx;
}

.recent-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: #8C8C8C;
}

.recent-title-inner {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.recent-title-icon {
  width: 32rpx;
  height: 32rpx;
}

.line {
  width: 64rpx;
  height: 1rpx;
  background: #E8E8E8;
}

.recent-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 30, 0.04);
}

.recent-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.recent-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-time {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #8C8C8C;
}
