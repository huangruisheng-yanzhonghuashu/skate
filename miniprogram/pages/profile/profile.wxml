<view class="page">
  <!-- 页面大标题（设计稿同款） -->
  <view class="page-title">我的</view>

  <!-- 个人卡片：上（点击进入资料编辑）+ 下（签到/打卡/推荐快捷统计，可点跳转） -->
  <view class="profile-card">
    <view class="profile" hover-class="profile-hover" bindtap="openEdit">
      <image wx:if="{{user.avatarFileID}}" class="avatar-img" src="{{user.avatarFileID}}" mode="aspectFill" />
      <view wx:else class="avatar">{{user.nickname ? user.nickname[0] : '滑'}}</view>
      <view class="profile-info">
        <text class="profile-name">{{user.nickname || '滑手'}}</text>
        <view class="profile-meta">
          <view class="meta-row">
            <image class="meta-icon" src="{{icons.pin}}" mode="aspectFit" />
            <text>{{city}}</text>
          </view>
          <view class="meta-row">
            <image class="meta-icon" src="{{icons.flame}}" mode="aspectFit" />
            <text>滑龄 {{user.skateYears || '未设置'}}</text>
          </view>
        </view>
        <view wx:if="{{user.skills.length}}" class="profile-tags">
          <text wx:for="{{user.skills}}" wx:key="*this" class="profile-tag">{{item}}</text>
        </view>
        <view wx:if="{{!profileComplete}}" class="profile-hint">点击完善资料，解锁专属身份</view>
      </view>
      <image class="profile-arrow" src="{{icons.chevron}}" mode="aspectFit" />
    </view>

    <view class="card-stats">
      <view class="cstat" hover-class="cstat-hover" bindtap="goCheckins">
        <text class="cstat-num cstat-num-orange">{{checkinCount}}</text>
        <text class="cstat-label">签到</text>
      </view>
      <view class="cstat" hover-class="cstat-hover" bindtap="goMyPosts">
        <text class="cstat-num">{{postCount}}</text>
        <text class="cstat-label">打卡</text>
      </view>
      <view class="cstat" hover-class="cstat-hover" bindtap="goRecommend">
        <text class="cstat-num">{{submissionCount}}</text>
        <text class="cstat-label">推荐</text>
      </view>
    </view>
  </view>

  <!-- 菜单（打卡/推荐入口已并入个人卡片统计，此处不再重复） -->
  <view class="menu">
    <view class="menu-item" hover-class="menu-hover" bindtap="goReports">
      <view class="menu-left">
        <image class="menu-icon" src="{{icons.file}}" mode="aspectFit" />
        <text class="menu-label">我的报错</text>
      </view>
      <view class="menu-right">
        <text class="menu-value">{{reportCount}}条</text>
        <image class="menu-arrow" src="{{icons.chevron}}" mode="aspectFit" />
      </view>
    </view>
    <view class="menu-item menu-item-last" hover-class="menu-hover" bindtap="goFeedback">
      <view class="menu-left">
        <image class="menu-icon" src="{{icons.send}}" mode="aspectFit" />
        <text class="menu-label">你提我改</text>
      </view>
      <view class="menu-right">
        <text class="menu-value">{{feedbackCount}}条</text>
        <image class="menu-arrow" src="{{icons.chevron}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 运营管理（仅管理员可见） -->
  <view wx:if="{{isAdmin}}" class="menu">
    <view class="menu-item menu-item-last" hover-class="menu-hover" bindtap="goAdmin">
      <view class="menu-left">
        <image class="menu-icon" src="{{icons.admin}}" mode="aspectFit" />
        <text class="menu-label">运营管理</text>
      </view>
      <view class="menu-right">
        <image class="menu-arrow" src="{{icons.chevron}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 编辑资料弹窗 -->
  <view wx:if="{{editOpen}}" class="edit-mask" bindtap="closeEdit">
    <view class="edit-sheet" catchtap="noop">
      <view class="edit-head">
        <text class="edit-title">编辑资料</text>
        <image class="edit-close" src="{{icons.close}}" catchtap="closeEdit" mode="aspectFit" aria-label="关闭" />
      </view>

      <!-- 头像：居中大图 + 相机角标 -->
      <button class="avatar-edit" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="avatar-edit-ring">
          <image wx:if="{{form.avatarTemp || form.avatarFileID}}" class="avatar-edit-img" src="{{form.avatarTemp || form.avatarFileID}}" mode="aspectFill" />
          <view wx:else class="avatar-edit-empty">{{form.nickname ? form.nickname[0] : '滑'}}</view>
          <view class="avatar-edit-badge">
            <image class="avatar-edit-camera" src="{{icons.camera}}" mode="aspectFit" />
          </view>
        </view>
        <text class="avatar-edit-tip">点击更换头像</text>
      </button>

      <view class="edit-field">
        <text class="edit-label">昵称</text>
        <input
          class="edit-input"
          type="nickname"
          value="{{form.nickname}}"
          placeholder="输入昵称"
          placeholder-class="edit-ph"
          maxlength="12"
          bindinput="onNicknameInput"
        />
        <text class="edit-count">{{form.nickname.length}}/12</text>
      </view>

      <!-- 城市：复用全局城市选择页（选中即生效并返回） -->
      <view class="edit-field" hover-class="edit-field-hover" bindtap="goCityPicker">
        <text class="edit-label">城市</text>
        <view class="edit-field-right">
          <text class="edit-value">{{city || '选择城市'}}</text>
          <image class="edit-chev" src="{{icons.chevron}}" mode="aspectFit" />
        </view>
      </view>

      <!-- 滑龄：固定 4 档，行内 chip 单选（免弹窗，一步选中） -->
      <view class="edit-tags">
        <text class="edit-label">滑龄</text>
        <view class="tag-list">
          <view
            wx:for="{{years}}"
            wx:key="*this"
            class="tag-option {{form.skateYears === item ? 'tag-option-active' : ''}}"
            data-year="{{item}}"
            bindtap="onYearTap"
          >{{item}}</view>
        </view>
      </view>

      <view class="edit-tags">
        <text class="edit-label">擅长</text>
        <view class="tag-list">
          <view
            wx:for="{{tagOptions}}"
            wx:key="*this"
            class="tag-option {{tagSel[item] ? 'tag-option-active' : ''}}"
            data-tag="{{item}}"
            bindtap="onTagToggle"
          >{{item}}</view>
        </view>
      </view>
      <view class="edit-tags-tip">最多选 5 个，展示在个人卡片</view>

      <button class="edit-save {{saving ? 'edit-saving' : ''}}" bindtap="saveProfile">
        {{saving ? '保存中...' : '保存'}}
      </button>
    </view>
  </view>
</view>
