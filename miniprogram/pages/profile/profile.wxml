<view class="page">
  <!-- 页面大标题（设计稿同款） -->
  <view class="page-title">我的</view>

  <!-- 个人卡片（点击进入资料编辑） -->
  <view class="profile" hover-class="profile-hover" bindtap="openEdit">
    <image wx:if="{{user.avatarFileID}}" class="avatar-img" src="{{user.avatarFileID}}" mode="aspectFill" />
    <view wx:else class="avatar">{{user.nickname ? user.nickname[0] : '滑'}}</view>
    <view class="profile-info">
      <text class="profile-name">{{user.nickname || '滑手'}}</text>
      <view class="profile-meta">
        <view class="meta-row">
          <image class="meta-icon" src="{{icons.flame}}" mode="aspectFit" />
          <text>滑龄 {{user.skateYears || '未设置'}}</text>
        </view>
        <view class="meta-row">
          <image class="meta-icon" src="{{icons.pin}}" mode="aspectFit" />
          <text>{{city}}</text>
        </view>
      </view>
      <view wx:if="{{!profileComplete}}" class="profile-hint">点击完善资料，解锁专属身份</view>
    </view>
    <image class="profile-arrow" src="{{icons.chevron}}" mode="aspectFit" />
  </view>

  <!-- 统计行（设计稿：3 个独立小卡，数字大 + 标签小；签到数字橙色） -->
  <view class="stats">
    <view class="stat" bindtap="goCheckins">
      <text class="stat-num stat-num-orange">{{checkinCount}}</text>
      <text class="stat-label">签到</text>
    </view>
    <view class="stat" bindtap="goReports">
      <text class="stat-num">{{reportCount}}</text>
      <text class="stat-label">报错</text>
    </view>
    <view class="stat" bindtap="goFeedback">
      <text class="stat-num">{{feedbackCount}}</text>
      <text class="stat-label">建议</text>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu">
    <view class="menu-item" hover-class="menu-hover" bindtap="goCheckins">
      <view class="menu-left">
        <image class="menu-icon" src="{{icons.pin}}" mode="aspectFit" />
        <text class="menu-label">我的签到</text>
      </view>
      <view class="menu-right">
        <text class="menu-value">{{checkinCount}}次</text>
        <image class="menu-arrow" src="{{icons.chevron}}" mode="aspectFit" />
      </view>
    </view>
    <view class="menu-item" hover-class="menu-hover" bindtap="goReports">
      <view class="menu-left">
        <image class="menu-icon" src="{{icons.file}}" mode="aspectFit" />
        <text class="menu-label">我的报错</text>
      </view>
      <view class="menu-right">
        <text class="menu-value">{{reportCount}}条</text>
        <image class="menu-arrow" src="{{icons.chevron}}" mode="aspectFit" />
      </view>
    </view>
    <view class="menu-item" hover-class="menu-hover" bindtap="goFeedback">
      <view class="menu-left">
        <image class="menu-icon" src="{{icons.send}}" mode="aspectFit" />
        <text class="menu-label">你提我改</text>
      </view>
      <view class="menu-right">
        <text class="menu-value">{{feedbackCount}}条</text>
        <image class="menu-arrow" src="{{icons.chevron}}" mode="aspectFit" />
      </view>
    </view>
    <view class="menu-item" hover-class="menu-hover" bindtap="goAdmin">
      <view class="menu-left">
        <image class="menu-icon" src="{{icons.admin}}" mode="aspectFit" />
        <text class="menu-label">场地管理</text>
      </view>
      <view class="menu-right">
        <image class="menu-arrow" src="{{icons.chevron}}" mode="aspectFit" />
      </view>
    </view>
    <view class="menu-item menu-item-last" hover-class="menu-hover" bindtap="goSettings">
      <view class="menu-left">
        <image class="menu-icon" src="{{icons.settings}}" mode="aspectFit" />
        <text class="menu-label">设置</text>
      </view>
      <view class="menu-right">
        <image class="menu-arrow" src="{{icons.chevron}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 最近签到记录（设计稿：左对齐标题） -->
  <view class="recent">
    <text class="recent-title">最近签到</text>
    <view
      wx:for="{{recent}}"
      wx:key="id"
      class="recent-item"
      hover-class="menu-hover"
      data-id="{{item.venueId}}"
      bindtap="goVenue"
    >
      <image class="recent-icon" src="{{icons.pin}}" mode="aspectFit" />
      <text class="recent-name">{{item.venueName}}</text>
      <text class="recent-time">{{item.timeText}}</text>
    </view>
  </view>

  <!-- 编辑资料弹窗 -->
  <view wx:if="{{editOpen}}" class="edit-mask" bindtap="closeEdit">
    <view class="edit-sheet" catchtap="noop">
      <view class="edit-title">编辑资料</view>

      <view class="edit-row">
        <text class="edit-label">头像</text>
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{form.avatarTemp || form.avatarFileID}}" class="avatar-preview" src="{{form.avatarTemp || form.avatarFileID}}" mode="aspectFill" />
          <view wx:else class="avatar-preview avatar-preview-empty">选</view>
        </button>
        <text class="edit-tip">点击头像更换</text>
      </view>

      <view class="edit-row">
        <text class="edit-label">昵称</text>
        <input
          class="edit-input"
          type="nickname"
          value="{{form.nickname}}"
          placeholder="输入昵称"
          placeholder-class="edit-ph"
          maxlength="12"
          bindinput="onNicknameInput"
        />
      </view>

      <view class="edit-row">
        <text class="edit-label">滑龄</text>
        <picker mode="selector" range="{{years}}" bindchange="onYearsChange">
          <view class="edit-picker {{form.skateYears ? '' : 'edit-picker-empty'}}">{{form.skateYears || '选择滑龄'}}</view>
        </picker>
      </view>

      <button class="edit-save {{saving ? 'edit-saving' : ''}}" bindtap="saveProfile">
        {{saving ? '保存中...' : '保存'}}
      </button>
    </view>
  </view>
</view>
