.mv-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: #000000;
  z-index: 9999;
}

.mv-swiper {
  width: 100%;
  height: 100%;
}

.mv-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mv-video {
  width: 100%;
  height: 100%;
}

.mv-video-wrap {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 播放按钮：半透明圆底 + 白色三角 */
.mv-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  z-index: 2;
}

.mv-play::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-38%, -50%);
  border-left: 34rpx solid rgba(255, 255, 255, 0.95);
  border-top: 22rpx solid transparent;
  border-bottom: 22rpx solid transparent;
}

.mv-img {
  width: 100%;
  height: 100%;
}

.mv-count {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  text-align: center;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
}

/* 右上角关闭 × */
.mv-close {
  position: absolute;
  top: calc(40rpx + env(safe-area-inset-top));
  right: 30rpx;
  width: 64rpx;
  height: 64rpx;
}

.mv-close-line {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 44rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.92);
}

.mv-close-l1 {
  transform: translate(-50%, -50%) rotate(45deg);
}

.mv-close-l2 {
  transform: translate(-50%, -50%) rotate(-45deg);
}
