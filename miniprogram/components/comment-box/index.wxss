.cbox {
  margin-top: 16rpx;
  background: #F7F7F8;
  border-radius: 12rpx;
  padding: 20rpx;
}

/* 评论行 */
.crow {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
}

.cavatar-img {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.cavatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #2A8CFF;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cavatar-me {
  background: #FF5A36;
}

.cmain {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.crow1 {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.cname {
  font-size: 24rpx;
  font-weight: 600;
  color: #6B6B70;
}

.ctime {
  font-size: 20rpx;
  color: #C0C0C4;
}

.cnote {
  font-size: 26rpx;
  color: #1A1A1E;
  line-height: 1.5;
  word-break: break-all;
}

.cdel {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #C0C0C4;
  padding: 4rpx 8rpx;
}

.c-loading,
.c-end {
  text-align: center;
  padding: 16rpx 0;
  font-size: 22rpx;
  color: #C0C0C4;
}

/* 输入行 */
.cinput-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EBEBEE;
}

.cinput {
  flex: 1;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #1A1A1E;
}

.cph {
  color: #C0C0C4;
}

.csend {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #C0C0C4;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #F0F0F2;
}

.csend-on {
  color: #FFFFFF;
  background: #FF5A36;
}

.csend-busy {
  opacity: 0.6;
}
