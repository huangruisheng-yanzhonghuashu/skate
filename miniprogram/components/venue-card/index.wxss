/* 场地卡片 — 暗色街头风（左图通铺卡缘 + 内容 + 状态行居中，设计稿同款） */
.card {
  position: relative;
  display: flex;
  gap: 0;
  padding: 0;
  background: #1E1E23;
  border-radius: 20rpx;
  overflow: hidden;
  animation: card-in 0.4s ease-out backwards;
}

/* 按压态：hover-class 触发（view 的 :active 真机不可靠，与 shop-card 机制统一） */
.card-hover {
  opacity: 0.7;
  transform: scale(0.99);
}

@keyframes card-in {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 左图：正方形照片，通铺卡片左缘（左圆右直角，撑满卡高，设计稿同款） ===== */
.thumb {
  position: relative;
  width: 200rpx;
  min-height: 200rpx;
  align-self: stretch;
  border-radius: 20rpx 0 0 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #17171B;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

/* 无图回退：品牌色浅底 + 场地图标 */
.thumb-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 90, 54, 0.10);
}

.thumb-icon {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.9;
}

/* 热门角标（压图左上） */
.badge-hot {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 12rpx;
  background: #FF5A36;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.25);
  border-radius: 8rpx;
  white-space: nowrap;
}

/* ===== 内容 ===== */
.body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 20rpx 24rpx;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 地址 · 距离 */
.addr {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8C8C94;
  line-height: 1.4;
  min-width: 0;
}

.addr-pin {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
}

.addr-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 标签行 */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.tag {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  background: #26262C;
  color: #8C8C94;
  font-size: 22rpx;
  line-height: 1;
  border-radius: 8rpx;
  white-space: nowrap;
}

/* ===== 状态行（绿点+绿字，靠左对齐） ===== */
.foot {
  display: flex;
  align-items: center;
  margin-top: auto;
  padding-top: 12rpx;
}

.state {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  min-width: 0;
}

.state-live {
  color: #00D4AA;
}

/* 无人在场弱化态 */
.state-quiet {
  color: #8C8C94;
  font-weight: 400;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #3A3A42;
  flex-shrink: 0;
}

/* 已签到：绿色（设计稿「今日已签到 · 14:20」为绿色 + 绿点） */
.state-checked {
  color: #00D4AA;
}

.dot-green {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #00D4AA;
  flex-shrink: 0;
}

.state-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}
