/* 场地卡片 — 暗色街头风（加宽左图 + 左侧态度线 + 在线角标） */
.card {
  position: relative;
  display: flex;
  gap: 0;
  padding: 0;
  background: #1E1E23;
  border: 1rpx solid #26262C;
  border-radius: 24rpx;
  overflow: hidden;
  animation: card-in 0.25s ease-out backwards;
}

/* 按压态 */
.card-hover {
  opacity: 0.7;
  transform: scale(0.99);
}

@keyframes card-in {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 左侧态度线：街头感装饰，高饱和橙 3rpx */
.attitude-line {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: #FF5A36;
  border-radius: 24rpx 0 0 24rpx;
  z-index: 2;
}

/* ===== 左图：5:4 画幅（120×100 约 240×200rpx），更像街头摄影 ===== */
.thumb {
  position: relative;
  width: 240rpx;
  min-height: 200rpx;
  align-self: stretch;
  margin-left: 6rpx;
  border-radius: 0 24rpx 24rpx 0;
  overflow: hidden;
  flex-shrink: 0;
  background: #17171B;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

/* 无图回退：品牌色浅底 + 场地图标 */
.thumb-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 90, 54, 0.10);
}

.thumb-icon {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.9;
}

/* 热门角标（左上，倾斜贴纸） */
.badge-hot {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 12rpx;
  background: #FF5A36;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.25);
  border-radius: 8rpx;
  white-space: nowrap;
  transform: rotate(-6deg);
}

/* 在线人数角标（右上） */
.badge-online {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 20, 0.88);
  backdrop-filter: blur(8rpx);
}

.badge-online-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #00D4AA;
}

.badge-online-num {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1;
}

/* ===== 内容 ===== */
.body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 22rpx 24rpx;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 评分（名称行右侧单颗橙星 + 分值） */
.rate {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.rate-star {
  width: 28rpx;
  height: 28rpx;
}

.rate-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF5A36;
  line-height: 1;
}

/* 地址 · 距离 */
.addr {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8C8C94;
  line-height: 1.4;
  min-width: 0;
}

.addr-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 标签行 */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.tag {
  flex-shrink: 0;
  padding: 9rpx 14rpx;
  background: #26262C;
  color: #8C8C94;
  font-size: 22rpx;
  line-height: 1;
  border-radius: 8rpx;
  white-space: nowrap;
}

/* 第一个标签用品牌色高亮 */
.tag-primary {
  background: rgba(255, 90, 54, 0.14);
  color: #FF8A6E;
}

/* ===== 状态行 ===== */
.foot {
  display: flex;
  align-items: center;
  margin-top: auto;
  padding-top: 18rpx;
}

.state {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  min-width: 0;
}

.state-live {
  color: #00D4AA;
}

.state-quiet {
  color: #8C8C94;
  font-weight: 400;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #3A3A42;
  flex-shrink: 0;
}

/* 在线脉冲绿点 */
.dot-ping {
  position: relative;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #00D4AA;
  flex-shrink: 0;
}

.dot-ping::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #00D4AA;
  animation: ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
}

@keyframes ping {
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.6); }
  100% { opacity: 0; transform: scale(2); }
}

.state-checked {
  color: #00D4AA;
}

.dot-green {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #00D4AA;
  flex-shrink: 0;
}
