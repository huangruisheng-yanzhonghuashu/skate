/* 场地卡片 — 高保真版设计稿结构 */
.card {
  position: relative;
  display: flex;
  gap: 24rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  animation: card-in 0.4s ease-out backwards;
}

.card:active {
  opacity: 0.7;
  transform: scale(0.99);
}

@keyframes card-in {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 角标（显式偏移，配套内容行留白） ===== */
.badge-hot {
  position: absolute;
  top: 24rpx;
  left: 136rpx; /* 卡片内边距28 + 图标88 + 间距24 */
  padding: 6rpx 12rpx;
  background: #FF5A36;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  border-radius: 8rpx;
  white-space: nowrap;
}

.badge-checked {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 12rpx;
  background: #E8F8F0;
  color: #00B386;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  border-radius: 8rpx;
  white-space: nowrap;
}

.badge-check {
  width: 20rpx;
  height: 20rpx;
}

/* ===== 图标 ===== */
.icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #FFF0ED;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-img {
  width: 44rpx;
  height: 44rpx;
}

/* ===== 内容 ===== */
.body {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.name-row-checked {
  padding-right: 116rpx;
}

.name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1E;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 热门角标占位：名称左侧留 72rpx */
.name-hot {
  padding-left: 72rpx;
}

.rating {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.rating-star {
  width: 26rpx;
  height: 26rpx;
}

.rating-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #FF5A36;
}

/* 地址 · 距离 */
.addr {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8C8C8C;
  line-height: 1.4;
  min-width: 0;
}

.addr-pin {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
}

.addr-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 标签行 */
.tags {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.tag {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  background: #F0F0F0;
  color: #666666;
  font-size: 22rpx;
  line-height: 1;
  border-radius: 8rpx;
  white-space: nowrap;
}

/* 此刻 N 人 */
.live {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  color: #00D4AA;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #00D4AA;
  flex-shrink: 0;
}
