<view class="card" style="animation-delay: {{delay}}ms" bindtap="go" aria-role="button" aria-label="{{venue.name}}，查看场地详情">
  <!-- 角标：已签到（右上，绿底对勾）优先，其次热门（图标右侧） -->
  <view wx:if="{{checked}}" class="badge-checked">
    <image class="badge-check" src="{{icons.checkGreen}}" mode="aspectFit" />
    <text>已签到</text>
  </view>
  <view wx:elif="{{venue.hot}}" class="badge-hot">热门</view>

  <view class="icon">
    <image class="icon-img" src="{{icons.venue}}" mode="aspectFit" />
  </view>

  <view class="body">
    <view class="name-row {{checked ? 'name-row-checked' : ''}}">
      <view class="name {{venue.hot && !checked ? 'name-hot' : ''}}">{{venue.name}}</view>
      <!-- 星级可视化：灰星底层 + 橙星顶层按评分比例裁剪 -->
      <view class="rating">
        <view class="stars">
          <view class="stars-bg">
            <image wx:for="{{[0,1,2,3,4]}}" wx:key="*this" class="star" src="{{icons.starGray}}" mode="aspectFit" />
          </view>
          <view class="stars-fg" style="width: {{(venue.rating || 0) / 5 * 100}}%">
            <image wx:for="{{[0,1,2,3,4]}}" wx:key="*this" class="star" src="{{icons.star}}" mode="aspectFit" />
          </view>
        </view>
        <text class="rating-num">{{venue.rating}}</text>
        <text wx:if="{{venue.ratingCount}}" class="rating-count">{{venue.ratingCount}}人评</text>
      </view>
    </view>

    <view class="addr">
      <image class="addr-pin" src="{{icons.pin}}" mode="aspectFit" />
      <text class="addr-text">{{venue.shortAddr}} · 距你 {{venue.distance}}</text>
    </view>

    <view class="tags">
      <view
        wx:for="{{venue.tags}}"
        wx:if="{{index < 3}}"
        wx:key="label"
        class="tag"
      >{{item.label}}</view>
    </view>

    <view class="live">
      <view class="live-dot"></view>
      <text>此刻 {{online}} 人</text>
    </view>
  </view>
</view>
