.shop-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #1E1E23;
  border-radius: 24rpx;
  padding: 28rpx;
  animation: shop-in 0.3s ease backwards;
}

@keyframes shop-in {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.shop-hover {
  background: #26262C;
}

.shop-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: rgba(255, 90, 54, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.shop-icon-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF8A6E;
}

.shop-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.shop-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.shop-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-status {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-open {
  color: #00D4AA;
  background: rgba(0, 212, 170, 0.12);
}

.status-closed {
  color: #8C8C94;
  background: #26262C;
}

.shop-svc {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.svc-tag {
  font-size: 22rpx;
  color: #FF8A6E;
  background: rgba(255, 90, 54, 0.16);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

/* category 徽标（板店/俱乐部/培训机构）：白描边中性样式表示「身份」，
   与橙色系 services 标签（能力）区分层级，同时压低卡片红色总量 */
.svc-cat {
  color: #FFFFFF;
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  font-weight: 600;
}

/* 评分星级（与 venue-card 同款双层裁剪） */
.shop-rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stars {
  position: relative;
  width: 130rpx;
  height: 24rpx;
}

.stars-bg {
  display: flex;
  gap: 2rpx;
}

.stars-fg {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  overflow: hidden;
  display: flex;
  gap: 2rpx;
  white-space: nowrap;
}

.star {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.rating-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #FF5A36;
}

.rating-count {
  font-size: 22rpx;
  color: #8C8C94;
}

.shop-addr {
  font-size: 24rpx;
  color: #8C8C94;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-call {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 90, 54, 0.14);
  color: #FF8A6E;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
