<view class="shop-card" style="animation-delay: {{index * 60}}ms" hover-class="shop-hover" bindtap="go">
  <view class="shop-icon">
    <text class="shop-icon-text">{{catText}}</text>
  </view>
  <view class="shop-info">
    <view class="shop-top">
      <text class="shop-name">{{shop.name}}</text>
      <text wx:if="{{status}}" class="shop-status {{openNow ? 'status-open' : 'status-closed'}}">{{status}}</text>
    </view>
    <view class="shop-svc">
      <text wx:if="{{shop.category}}" class="svc-tag svc-cat">{{shop.category}}</text>
      <text wx:for="{{shop.services}}" wx:key="*this" class="svc-tag">{{item}}</text>
    </view>
    <view class="shop-rating" wx:if="{{shop.rating}}">
      <view class="stars">
        <view class="stars-bg">
          <image wx:for="{{[0,1,2,3,4]}}" wx:key="*this" class="star" src="{{icons.starGray}}" mode="aspectFit" />
        </view>
        <view class="stars-fg" style="width: {{shop.rating / 5 * 100}}%">
          <image wx:for="{{[0,1,2,3,4]}}" wx:key="*this" class="star" src="{{icons.star}}" mode="aspectFit" />
        </view>
      </view>
      <text class="rating-num">{{shop.rating}}</text>
    </view>
    <text class="shop-addr">{{shop.shortAddr || shop.address}}</text>
  </view>
  <view wx:if="{{shop.phone}}" class="shop-call" data-phone="{{shop.phone}}" catchtap="call">拨打</view>
</view>
