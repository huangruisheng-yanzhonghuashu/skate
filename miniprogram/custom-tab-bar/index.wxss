/* 通栏贴底 TabBar（设计稿：深色通栏、无留边无圆角） */
.tabbar {
  display: flex;
  align-items: center;
  height: 120rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #111114;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 图标上、文字下，未选中灰色 */
.tab-pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 14rpx 48rpx;
  border-radius: 999rpx;
  color: #6B6B75;
}

/* 选中态仅改变颜色，无背景胶囊 */
.tab-item.active .tab-pill {
  background: transparent;
  box-shadow: none;
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
}

.tab-label {
  font-size: 22rpx;
  line-height: 1;
}

.tab-item.active .tab-label {
  color: #FF5A36;
  font-weight: 500;
}
