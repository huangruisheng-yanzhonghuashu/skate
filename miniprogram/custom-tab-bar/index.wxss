.tabbar {
  display: flex;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #1A1A1E;
  border-top: 1rpx solid #2A2A2E;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #8C8C8C;
}

.tab-item.active {
  color: #FF5A36;
  font-weight: 500;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
}

.tab-label {
  font-size: 22rpx;
  line-height: 1;
}
