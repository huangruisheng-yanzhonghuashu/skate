/* 通栏贴底 TabBar（设计稿：深色通栏、无留边无圆角） */
.tabbar {
  display: flex;
  align-items: center;
  height: 120rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #111114;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 激活/未激活统一竖排：图标上、文字下（设计稿同款） */
.tab-pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 14rpx 48rpx;
  border-radius: 999rpx;
  color: #8C8C94;
}

/* 激活：橙渐变胶囊包住整组，图标文字变白（布局不变，仅配色变化） */
.tab-item.active .tab-pill {
  background: linear-gradient(135deg, #FF5A36, #FF8A6E);
  box-shadow: 0 6rpx 20rpx rgba(255, 90, 54, 0.35);
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
}

.tab-label {
  font-size: 22rpx;
  line-height: 1;
}

.tab-item.active .tab-label {
  color: #FFFFFF;
  font-weight: 600;
}

/* 首页选中态品牌字标：「滑 / 哪儿」两行竖排，厚重字重贴近美团 Logo 观感 */
.brand-stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.15;
}

.brand-line {
  font-weight: 800;
  color: #FFFFFF;
}

/* 「滑」主字放大做视觉锚点，「哪儿」缩小为辅助，层级字标（约 1.2 倍克制对比） */
.brand-big {
  font-size: 29rpx;
  line-height: 1.1;
}

.brand-small {
  font-size: 24rpx;
  line-height: 1.2;
  letter-spacing: 2rpx;
}
