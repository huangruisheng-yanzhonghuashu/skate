/* ===== SkateSpot 设计令牌（暗色街头风 · 与设计稿一致） ===== */
page {
  /* Surfaces */
  --bg: #111114;
  --card: #1E1E23;
  --inset: #17171B;
  --line: #26262C;

  /* Primary brand: neon orange-red */
  --primary: #FF5A36;
  --primary-lt: #FF8A6E;
  --primary-50: rgba(255, 90, 54, 0.16);
  --primary-100: rgba(255, 90, 54, 0.24);
  --primary-600: #FF8A6E;

  /* State colors（绿仅「在场/营业中/已签到/已处理」语义） */
  --success: #00D4AA;
  --warning: #FFB800;
  --error: #FF3B30;
  --info: #2A8CFF;

  /* Text（暗底层级：白 → 次级 → 弱化 → 占位） */
  --t1: #FFFFFF;
  --t2: #D9D9DE;
  --t3: #A6A6AD;
  --t4: #8C8C94;
  --t5: #6E6E76;

  /* 兼容旧变量名（暗色语义翻转） */
  --ink: #FFFFFF;
  --ink-line: #26262C;
  --graphite: #A6A6AD;
  --ash: #8C8C94;
  --fog: #26262C;
  --mist: #1E1E23;

  background: #111114;
  color: #D9D9DE;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
}

/* ===== 通用动画 ===== */
@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes modal-in {
  from { opacity: 0; transform: translateY(40rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes shake {
  10%, 90% { transform: translateX(-2rpx); }
  20%, 80% { transform: translateX(4rpx); }
  30%, 50%, 70% { transform: translateX(-6rpx); }
  40%, 60% { transform: translateX(6rpx); }
}
@keyframes ping {
  0% { transform: scale(1); opacity: 0.6; }
  75%, 100% { transform: scale(2.2); opacity: 0; }
}

.anim-fade-in { animation: fade-in 0.2s ease-out both; }
.anim-modal-in { animation: modal-in 0.24s ease-out both; }
.anim-shake { animation: shake 0.4s ease-in-out both; }

/* 在线人数脉冲点 */
.dot-ping {
  position: relative;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--success);
}
.dot-ping::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: var(--success);
  animation: ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
}
